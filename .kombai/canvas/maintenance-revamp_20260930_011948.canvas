        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root { --navy:#172554; --teal:#0f766e; --mint:#eaf5f3; --ink:#1d2939; --muted:#596777; --line:#d9e4e2; --paper:#f4f8f7; --red:#b93832; --red-soft:#fff1ef; --amber:#9a6500; --amber-soft:#fff8e8; --green:#147a5b; --green-soft:#eaf6ef; }\n.icon { display:inline-flex; align-items:center; justify-content:center; width:1.25rem; height:1.25rem; color:inherit; line-height:1; }\n.brand-icon { display:inline-flex; align-items:center; justify-content:center; width:2.65rem; height:2.65rem; color:#fff; border-radius:.8rem; background:var(--navy); }\n.site-address { overflow-wrap:anywhere; }\n.nav-link { display:flex; align-items:center; justify-content:center; gap:.55rem; min-height:46px; padding:.65rem 1rem; border-radius:.7rem; color:#435366; font-size:.9rem; font-weight:600; text-decoration:none; }\n.lane-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(180px,.58fr) minmax(0,1fr); gap:1.5rem; align-items:start; }\n.ticket-copy { overflow-wrap:anywhere; }\n@media (max-width:850px) { .lane-grid { grid-template-columns:1fr; gap:1.1rem; } }\n@media (max-width:640px) { .nav-link { flex-direction:column; gap:.2rem; min-height:58px; padding:.45rem .2rem; font-size:.7rem; } }\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',sans-serif\">\n    <header class=\"border-b border-[var(--line)] bg-white\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-4 px-6 py-4 lg:px-10\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name container\">\n                <span class=\"brand-icon text-[22px]\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\" style=\"color:#ffffff\">\n                    <i class=\"ti ti-building-community icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"building community icon\" style=\"color:#ffffff;width:1.4rem;height:1.4rem\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <div class=\"font-semibold tracking-[-0.02em] text-[var(--navy)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand title text\">\n                        Gestão Predial\n                    </div>\n                    <div class=\"text-[13px] text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Central de Ocorrências\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 sm:gap-4\" data-kid=\"1-1-1-2\" data-name=\"header action group\">\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#b9dfd0] bg-[#f2fbf6] px-3 py-2 text-[13px] font-medium text-[#176a50]\" data-kid=\"1-1-1-2-1\" data-name=\"synchronization status badge\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#16865f]\" data-kid=\"1-1-1-2-1-1\" data-name=\"sync indicator dot\">\n                    </span>\n                    Sincronizado\n                </span>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--teal)] px-4 py-2.5 text-sm font-bold text-white shadow-sm\" data-kid=\"1-1-1-2-2\" data-name=\"create new occurrence button\">\n                    <i class=\"ti ti-plus icon\" data-kid=\"1-1-1-2-2-1\" data-name=\"plus icon\" style=\"color:#ffffff;width:1rem;height:1rem\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-2-2\" data-name=\"button text\">\n                        Nova ocorrência\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <div class=\"mx-auto max-w-[1320px] px-4 pt-4 sm:px-6 lg:px-10\" data-kid=\"1-2\" data-name=\"navigation container\">\n        <nav aria-label=\"Navegação principal\" class=\"grid grid-cols-4 gap-1 rounded-xl border border-[#d8e5e3] bg-[#eaf2f1] p-1.5\" data-kid=\"1-2-1\" data-name=\"navigation menu list\">\n            <a class=\"nav-link\" data-kid=\"1-2-1-1\" data-name=\"navigation link overview\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard icon\" data-kid=\"1-2-1-1-1\" data-name=\"dashboard icon\" style=\"color:currentColor;width:1.15rem;height:1.15rem\">\n                </i>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"navigation link text\">\n                    Visão geral\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-2-1-2\" data-name=\"navigation link register\" href=\"#\">\n                <i class=\"ti ti-file-plus icon\" data-kid=\"1-2-1-2-1\" data-name=\"file plus icon\" style=\"color:currentColor;width:1.15rem;height:1.15rem\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"navigation link text\">\n                    Registrar\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-2-1-3\" data-name=\"navigation link occurrences\" href=\"#\">\n                <i class=\"ti ti-clipboard-list icon\" data-kid=\"1-2-1-3-1\" data-name=\"clipboard list icon\" style=\"color:currentColor;width:1.15rem;height:1.15rem\">\n                </i>\n                <span data-kid=\"1-2-1-3-2\" data-name=\"navigation link text\">\n                    Ocorrências\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link bg-[var(--teal)] text-white shadow-sm\" data-kid=\"1-2-1-4\" data-name=\"navigation link tasks\" href=\"#\">\n                <i class=\"ti ti-list-check icon\" data-kid=\"1-2-1-4-1\" data-name=\"list check icon\" style=\"color:#ffffff;width:1.15rem;height:1.15rem\">\n                </i>\n                <span data-kid=\"1-2-1-4-2\" data-name=\"navigation link text\">\n                    Tarefas\n                </span>\n            </a>\n        </nav>\n    </div>\n    <main class=\"mx-auto max-w-[1320px] px-4 pb-12 pt-9 sm:px-6 lg:px-10 lg:pt-11\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-3-1\" data-name=\"page heading group\">\n            <div data-kid=\"1-3-1-1\" data-name=\"heading text container\">\n                <h1 class=\"mb-2 text-3xl font-extrabold tracking-[-0.04em] text-[var(--navy)] sm:text-[34px]\" data-kid=\"1-3-1-1-1\" data-name=\"page title\" style=\"font-family:'Manrope',sans-serif\">\n                    Fila por prioridade\n                </h1>\n                <p class=\"m-0 max-w-2xl text-[15px] leading-6 text-[var(--muted)]\" data-kid=\"1-3-1-1-2\" data-name=\"page description text\">\n                    Ocorrências não resolvidas, organizadas pelo nível de prioridade.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-lg bg-white px-3.5 py-2.5 text-sm text-[var(--muted)] ring-1 ring-inset ring-[var(--line)]\" data-kid=\"1-3-1-2\" data-name=\"open occurrences summary badge\">\n                <i class=\"ti ti-list-details icon\" data-kid=\"1-3-1-2-1\" data-name=\"list details icon\" style=\"color:#596777;width:1.05rem;height:1.05rem\">\n                </i>\n                <strong class=\"text-[var(--navy)]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-2\" data-name=\"open count number\" data-reason=\"value updated by script\">\n                    2\n                </strong>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"badge text\">\n                    em aberto\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Local associado às ocorrências\" class=\"mb-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 rounded-2xl border border-[var(--line)] bg-white px-5 py-5 sm:px-6\" data-kid=\"1-3-2\" data-name=\"site location info section\">\n            <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-3-2-1\" data-name=\"location icon and detail container\">\n                <span class=\"mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--mint)] text-[var(--teal)] text-[20px]\" data-kid=\"1-3-2-1-1\" data-name=\"location icon wrapper\">\n                    <i class=\"ti ti-map-pin icon\" data-kid=\"1-3-2-1-1-1\" data-name=\"map pin icon\" style=\"color:#0f766e;width:1.25rem;height:1.25rem\">\n                    </i>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"1-3-2-1-2\" data-name=\"location address detail container\">\n                    <div class=\"mb-1 text-[13px] font-semibold uppercase tracking-[.06em] text-[var(--muted)]\" data-kid=\"1-3-2-1-2-1\" data-name=\"label text\">\n                        Local associado às ocorrências\n                    </div>\n                    <p class=\"site-address m-0 text-[16px] font-semibold leading-6 text-[var(--navy)]\" data-kid=\"1-3-2-1-2-2\" data-name=\"location address text\">\n                        casa da mae joana , numero 345, bairro cavalada, ararangua- SC\n                    </p>\n                </div>\n            </div>\n            <p class=\"m-0 shrink-0 rounded-full bg-[#f1f6f5] px-3.5 py-2 text-sm font-medium text-[#314b4a]\" data-kid=\"1-3-2-2\" data-name=\"location status badge\">\n                2 ocorrências abertas neste local\n            </p>\n        </section>\n        <div class=\"lane-grid\" data-kid=\"1-3-3\" data-name=\"prioritized ticket lanes container\">\n            <section aria-labelledby=\"urgent-heading\" class=\"min-w-0\" data-kid=\"1-3-3-1\" data-name=\"urgent ticket lane\">\n                <div class=\"mb-3 flex items-center justify-between border-b border-[#e5c8c5] pb-3\" data-kid=\"1-3-3-1-1\" data-name=\"lane header group\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-1-1-1\" data-name=\"lane title group\">\n                        <span class=\"h-2.5 w-2.5 rounded-full bg-[var(--red)]\" data-kid=\"1-3-3-1-1-1-1\" data-name=\"priority indicator dot\">\n                        </span>\n                        <h2 class=\"m-0 text-lg font-bold text-[var(--navy)]\" data-kid=\"1-3-3-1-1-1-2\" data-name=\"urgent priority heading\" id=\"urgent-heading\">\n                            Urgente\n                        </h2>\n                    </div>\n                    <span class=\"min-w-7 rounded-full bg-[var(--red-soft)] px-2 py-1 text-center text-xs font-bold text-[var(--red)]\" data-dynamic=\"true\" data-kid=\"1-3-3-1-1-2\" data-name=\"urgent count badge\" data-reason=\"value updated by script\">\n                        1\n                    </span>\n                </div>\n                <article class=\"rounded-xl border border-[#eadfdd] bg-white p-5 shadow-sm\" data-kid=\"1-3-3-1-2\" data-name=\"urgent ticket card\">\n                    <div class=\"mb-3 flex flex-wrap items-center justify-between gap-2\" data-kid=\"1-3-3-1-2-1\" data-name=\"card top row container\">\n                        <span class=\"text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"ticket category text\">\n                            Elétrica\n                        </span>\n                        <span class=\"rounded-md bg-[var(--red-soft)] px-2.5 py-1 text-xs font-bold tracking-[.03em] text-[var(--red)]\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"priority tag\">\n                            Prioridade urgente\n                        </span>\n                    </div>\n                    <h3 class=\"mb-2 text-[17px] font-bold leading-6 text-[var(--navy)]\" data-kid=\"1-3-3-1-2-2\" data-name=\"ticket title\" style=\"font-family:'Manrope',sans-serif\">\n                        Disjuntor do circuito 10\n                    </h3>\n                    <p class=\"ticket-copy mb-4 text-[14px] leading-[1.65] text-[#344054]\" data-kid=\"1-3-3-1-2-3\" data-name=\"ticket description text\">\n                        é necessário que tecnico eletricista se desloque para ver porque disjuntor do circuito 10 está desligando qundo morador liga o chuveiro\n                    </p>\n                    <div class=\"mb-4 grid grid-cols-2 gap-3 border-y border-[#e8eeec] py-3 text-[13px]\" data-kid=\"1-3-3-1-2-4\" data-name=\"ticket meta grid container\">\n                        <div data-kid=\"1-3-3-1-2-4-1\" data-name=\"ticket responsible person group\">\n                            <span class=\"mb-1 block text-[var(--muted)]\" data-kid=\"1-3-3-1-2-4-1-1\" data-name=\"label text\">\n                                Responsável\n                            </span>\n                            <strong class=\"text-[var(--navy)]\" data-kid=\"1-3-3-1-2-4-1-2\" data-name=\"responsible person name\">\n                                jefinho fófó\n                            </strong>\n                        </div>\n                        <div data-kid=\"1-3-3-1-2-4-2\" data-name=\"ticket deadline group\">\n                            <span class=\"mb-1 block text-[var(--muted)]\" data-kid=\"1-3-3-1-2-4-2-1\" data-name=\"label text\">\n                                Prazo\n                            </span>\n                            <strong class=\"text-[var(--navy)]\" data-kid=\"1-3-3-1-2-4-2-2\" data-name=\"deadline date\">\n                                09/12/2026\n                            </strong>\n                        </div>\n                    </div>\n                    <label class=\"mb-1.5 block text-[13px] font-semibold text-[#435366]\" data-kid=\"1-3-3-1-2-5\" data-name=\"status select label\" for=\"urgent-status\">\n                        Andamento\n                    </label>\n                    <select class=\"min-h-11 w-full rounded-lg border border-[#cbd8d6] bg-white px-3 text-sm font-semibold text-[var(--navy)] outline-none\" data-dynamic=\"true\" data-kid=\"1-3-3-1-2-6\" data-name=\"ticket status dropdown\" data-reason=\"selected value updated by user or script\" id=\"urgent-status\">\n                        <option data-kid=\"1-3-3-1-2-6-1\" data-name=\"dropdown option\" selected=\"\">\n                            Aberta\n                        </option>\n                        <option data-kid=\"1-3-3-1-2-6-2\" data-name=\"dropdown option\">\n                            Em triagem\n                        </option>\n                        <option data-kid=\"1-3-3-1-2-6-3\" data-name=\"dropdown option\">\n                            Atribuída\n                        </option>\n                        <option data-kid=\"1-3-3-1-2-6-4\" data-name=\"dropdown option\">\n                            Em execução\n                        </option>\n                        <option data-kid=\"1-3-3-1-2-6-5\" data-name=\"dropdown option\">\n                            Aguardando material\n                        </option>\n                        <option data-kid=\"1-3-3-1-2-6-6\" data-name=\"dropdown option\">\n                            Resolvida\n                        </option>\n                    </select>\n                </article>\n            </section>\n            <section aria-labelledby=\"attention-heading\" class=\"min-w-0\" data-kid=\"1-3-3-2\" data-name=\"attention ticket lane\">\n                <div class=\"mb-3 flex items-center justify-between border-b border-[#eadbb5] pb-3\" data-kid=\"1-3-3-2-1\" data-name=\"lane header group\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-2-1-1\" data-name=\"lane title group\">\n                        <span class=\"h-2.5 w-2.5 rounded-full bg-[#bc8115]\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"priority indicator dot\">\n                        </span>\n                        <h2 class=\"m-0 text-lg font-bold text-[var(--navy)]\" data-kid=\"1-3-3-2-1-1-2\" data-name=\"attention priority heading\" id=\"attention-heading\">\n                            Atenção\n                        </h2>\n                    </div>\n                    <span class=\"min-w-7 rounded-full bg-[var(--amber-soft)] px-2 py-1 text-center text-xs font-bold text-[var(--amber)]\" data-dynamic=\"true\" data-kid=\"1-3-3-2-1-2\" data-name=\"attention count badge\" data-reason=\"value updated by script\">\n                        0\n                    </span>\n                </div>\n                <p class=\"m-0 rounded-lg bg-[#f0f4f3] px-3.5 py-3 text-[13px] leading-5 text-[#596777]\" data-kid=\"1-3-3-2-2\" data-name=\"no occurrences message text\">\n                    Nenhuma ocorrência aberta nesta prioridade.\n                </p>\n            </section>\n            <section aria-labelledby=\"normal-heading\" class=\"min-w-0\" data-kid=\"1-3-3-3\" data-name=\"normal ticket lane\">\n                <div class=\"mb-3 flex items-center justify-between border-b border-[#cfe2d7] pb-3\" data-kid=\"1-3-3-3-1\" data-name=\"lane header group\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-3-3-3-1-1\" data-name=\"lane title group\">\n                        <span class=\"h-2.5 w-2.5 rounded-full bg-[var(--green)]\" data-kid=\"1-3-3-3-1-1-1\" data-name=\"priority indicator dot\">\n                        </span>\n                        <h2 class=\"m-0 text-lg font-bold text-[var(--navy)]\" data-kid=\"1-3-3-3-1-1-2\" data-name=\"normal priority heading\" id=\"normal-heading\">\n                            Normal\n                        </h2>\n                    </div>\n                    <span class=\"min-w-7 rounded-full bg-[var(--green-soft)] px-2 py-1 text-center text-xs font-bold text-[var(--green)]\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1-2\" data-name=\"normal count badge\" data-reason=\"value updated by script\">\n                        1\n                    </span>\n                </div>\n                <article class=\"rounded-xl border border-[var(--line)] bg-white p-5 shadow-sm\" data-kid=\"1-3-3-3-2\" data-name=\"normal ticket card\">\n                    <div class=\"mb-3 flex flex-wrap items-center justify-between gap-2\" data-kid=\"1-3-3-3-2-1\" data-name=\"card top row container\">\n                        <span class=\"text-sm font-semibold text-[var(--muted)]\" data-kid=\"1-3-3-3-2-1-1\" data-name=\"ticket category text\">\n                            Hidráulica\n                        </span>\n                        <span class=\"rounded-md bg-[var(--green-soft)] px-2.5 py-1 text-xs font-bold tracking-[.03em] text-[var(--green)]\" data-kid=\"1-3-3-3-2-1-2\" data-name=\"priority tag\">\n                            Prioridade normal\n                        </span>\n                    </div>\n                    <h3 class=\"mb-2 text-[17px] font-bold leading-6 text-[var(--navy)]\" data-kid=\"1-3-3-3-2-2\" data-name=\"ticket title\" style=\"font-family:'Manrope',sans-serif\">\n                        Inspeção preventiva\n                    </h3>\n                    <p class=\"ticket-copy mb-4 text-[14px] leading-[1.65] text-[#344054]\" data-kid=\"1-3-3-3-2-3\" data-name=\"ticket description text\">\n                        inspeção preventiva realizada. sem ocorrencias\n                    </p>\n                    <div class=\"mb-4 grid grid-cols-2 gap-3 border-y border-[#e8eeec] py-3 text-[13px]\" data-kid=\"1-3-3-3-2-4\" data-name=\"ticket meta grid container\">\n                        <div data-kid=\"1-3-3-3-2-4-1\" data-name=\"ticket responsible person group\">\n                            <span class=\"mb-1 block text-[var(--muted)]\" data-kid=\"1-3-3-3-2-4-1-1\" data-name=\"label text\">\n                                Responsável\n                            </span>\n                            <strong class=\"text-[var(--navy)]\" data-kid=\"1-3-3-3-2-4-1-2\" data-name=\"responsible person name\">\n                                jefinho do fófó\n                            </strong>\n                        </div>\n                        <div data-kid=\"1-3-3-3-2-4-2\" data-name=\"ticket deadline group\">\n                            <span class=\"mb-1 block text-[var(--muted)]\" data-kid=\"1-3-3-3-2-4-2-1\" data-name=\"label text\">\n                                Prazo\n                            </span>\n                            <strong class=\"text-[var(--navy)]\" data-kid=\"1-3-3-3-2-4-2-2\" data-name=\"deadline date\">\n                                09/12/2026\n                            </strong>\n                        </div>\n                    </div>\n                    <label class=\"mb-1.5 block text-[13px] font-semibold text-[#435366]\" data-kid=\"1-3-3-3-2-5\" data-name=\"status select label\" for=\"normal-status\">\n                        Andamento\n                    </label>\n                    <select class=\"min-h-11 w-full rounded-lg border border-[#cbd8d6] bg-white px-3 text-sm font-semibold text-[var(--navy)] outline-none\" data-dynamic=\"true\" data-kid=\"1-3-3-3-2-6\" data-name=\"ticket status dropdown\" data-reason=\"selected value updated by user or script\" id=\"normal-status\">\n                        <option data-kid=\"1-3-3-3-2-6-1\" data-name=\"dropdown option\" selected=\"\">\n                            Aberta\n                        </option>\n                        <option data-kid=\"1-3-3-3-2-6-2\" data-name=\"dropdown option\">\n                            Em triagem\n                        </option>\n                        <option data-kid=\"1-3-3-3-2-6-3\" data-name=\"dropdown option\">\n                            Atribuída\n                        </option>\n                        <option data-kid=\"1-3-3-3-2-6-4\" data-name=\"dropdown option\">\n                            Em execução\n                        </option>\n                        <option data-kid=\"1-3-3-3-2-6-5\" data-name=\"dropdown option\">\n                            Aguardando material\n                        </option>\n                        <option data-kid=\"1-3-3-3-2-6-6\" data-name=\"dropdown option\">\n                            Resolvida\n                        </option>\n                    </select>\n                </article>\n            </section>\n        </div>\n        <div class=\"mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-[#dbe5e3] pt-5 text-sm\" data-kid=\"1-3-4\" data-name=\"page footer help section\">\n            <p class=\"m-0 text-[var(--muted)]\" data-kid=\"1-3-4-1\" data-name=\"footer description text\">\n                A fila mostra ocorrências não resolvidas. Para consultar o histórico completo, acesse\n                <span class=\"font-semibold text-[var(--navy)]\" data-kid=\"1-3-4-1-1\" data-name=\"link label text\">\n                    Ocorrências\n                </span>\n                .\n            </p>\n            <span class=\"inline-flex items-center gap-2 font-semibold text-[var(--teal)]\" data-kid=\"1-3-4-2\" data-name=\"sort status indicator group\">\n                <i class=\"ti ti-filter icon\" data-kid=\"1-3-4-2-1\" data-name=\"filter icon\" style=\"color:#0f766e;width:1rem;height:1rem\">\n                </i>\n                Ordenadas por prioridade\n            </span>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-09-30T01:32:01.888487+00:00",
      "modified": "2026-09-30T01:32:44.390980+00:00",
      "id": "var_28598ca17d87"
    },
    "var_52462578a436": {
      "type": "variant",
      "label": "02 · Organização por imóvel — Ocorrências",
