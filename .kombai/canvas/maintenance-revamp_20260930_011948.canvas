e\">\n                            18 set 2026 · 11:30\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section aria-label=\"Informações por local\" class=\"lower-grid mt-9 border-t border-[#d9e5e1] pt-6\" data-kid=\"1-1-2-4\" data-name=\"local analysis section\">\n                <div data-kid=\"1-1-2-4-1\" data-name=\"frequency by location section\">\n                    <h2 class=\"m-0 font-[Manrope] text-[18px] font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-1-2-4-1-1\" data-name=\"frequency heading\">\n                        Frequência por local\n                    </h2>\n                    <p class=\"m-0 mt-1 text-[14px] text-[#5c6e7c]\" data-kid=\"1-1-2-4-1-2\" data-name=\"frequency subtext\">\n                        Locais com mais registros no histórico.\n                    </p>\n                    <div class=\"mt-5 flex items-center justify-between gap-4\" data-kid=\"1-1-2-4-1-3\" data-name=\"top frequency row\">\n                        <p class=\"m-0 max-w-[75%] text-[14px] font-semibold leading-5 text-[#30495b]\" data-kid=\"1-1-2-4-1-3-1\" data-name=\"top location name\">\n                            Casa da mãe Joana, nº 345 · Cavalada · Araranguá–SC\n                        </p>\n                        <span class=\"shrink-0 font-[Manrope] text-[19px] font-bold text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-1-2-4-1-3-2\" data-name=\"top location count\" data-reason=\"count updated by system\">\n                            2\n                            <span class=\"font-[DM_Sans] text-[13px] font-medium text-[#5c6e7c]\" data-kid=\"1-1-2-4-1-3-2-1\" data-name=\"registrations label\">\n                                registros\n                            </span>\n                        </span>\n                    </div>\n                    <div class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-[#dfe9e5]\" data-kid=\"1-1-2-4-1-4\" data-name=\"frequency p