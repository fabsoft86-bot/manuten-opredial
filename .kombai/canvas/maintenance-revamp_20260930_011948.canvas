        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n  :root {\n    --navy: #172554;\n    --teal: #0f766e;\n    --teal-dark: #0b5e58;\n    --canvas: #f3f7f6;\n    --paper: #ffffff;\n    --ink: #172d39;\n    --muted: #586a72;\n    --line: #d7e1df;\n    --line-strong: #c5d3d0;\n    --urgent: #a8342b;\n    --urgent-soft: #fff4f1;\n    --urgent-line: #f0d1ca;\n    --normal: #3d6656;\n    --normal-soft: #eaf3ee;\n    --focus: #f1b94a;\n  }\n  .maintenance-ui { font-family: 'DM Sans', 'Trebuchet MS', sans-serif; color: var(--ink); }\n  .maintenance-ui h1, .maintenance-ui h2, .maintenance-ui h3 { font-family: 'Manrope', 'Trebuchet MS', sans-serif; }\n  .nav-link { color: var(--navy); }\n  .nav-link:hover { color: var(--teal-dark); }\n  .nav-link:focus-visible, .action-button:focus-visible, .field-control:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }\n  .filter-label { display: block; font-size: 13px; font-weight: 700; color: var(--navy); margin-bottom: 7px; }\n  .field-control { width: 100%; min-height: 46px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 10px 12px; background: var(--paper); color: var(--ink); font: inherit; }\n  .field-control:focus { border-color: var(--teal); }\n  .field-control::placeholder { color: #687980; opacity: 1; }\n  .action-button { min-height: 46px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 10px 15px; color: var(--navy); background: var(--paper); font: inherit; font-weight: 700; white-space: nowrap; }\n  .action-button:hover { border-color: var(--teal); color: var(--teal-dark); }\n  .ticket-grid { display: grid; grid-template-columns: minmax(275px,2.25fr) minmax(105px,.78fr) minmax(128px,1fr) minmax(130px,1fr) minmax(155px,1.18fr) minmax(112px,.8fr) minmax(175px,1.25fr); column-gap: 16px; }\n  .ticket-row { min-height: 118px; align-items: center; }\n  .ticket-head { align-items: center; }\n  .priority-dot, .status-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }\n  .urgent-row { background: var(--urgent-soft); }\n  .urgent-row .priority-dot { background: var(--urgent); }\n  .normal-row .priority-dot { background: var(--normal); }\n  .status-dot { background: var(--teal); width: 8px; height: 8px; }\n  .priority-label, .status-label { display: flex; align-items: center; gap: 7px; font-size: 14px; line-height: 1.35; font-weight: 700; }\n  .priority-label { color: var(--urgent); }\n  .normal-row .priority-label { color: var(--normal); }\n  .status-label { color: var(--navy); font-weight: 600; }\n  .detail-text { color: var(--muted); font-size: 14px; line-height: 1.45; }\n  .tiny-label { font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); font-weight: 700; }\n  .site-name { overflow-wrap: anywhere; }\n  .update-select { min-height: 42px; border: 1px solid var(--line-strong); border-radius: 7px; padding: 8px 28px 8px 10px; background: var(--paper); color: var(--ink); width: 100%; font: inherit; font-size: 14px; }\n  .mobile-label { display: none; }\n  @media (max-width: 1100px) {\n    .ticket-grid { grid-template-columns: minmax(240px,2fr) minmax(95px,.75fr) minmax(118px,.9fr) minmax(120px,1fr) minmax(135px,1.1fr) minmax(105px,.8fr) minmax(160px,1.15fr); column-gap: 12px; }\n  }\n  @media (max-width: 800px) {\n    .ticket-head { display: none !important; }\n    .ticket-grid { display: grid; grid-template-columns: 1fr; }\n    .ticket-row { min-height: 0; padding: 15px 13px; row-gap: 0; border-bottom: 1px solid var(--line); }\n    .ticket-row.urgent-row { border-bottom-color: var(--urgent-line); }\n    .ticket-cell { display: grid; grid-template-columns: 112px minmax(0,1fr); align-items: start; gap: 10px; padding: 8px 0; border-bottom: 1px solid #e8eeec; }\n    .ticket-cell:last-child { border-bottom: 0; }\n    .mobile-label { display: block; color: var(--muted); font-size: 13px; font-weight: 700; }\n    .main-navigation { display: grid !important; grid-template-columns: repeat(2,minmax(0,1fr)); }\n    .nav-link { justify-content: flex-start !important; min-height: 44px; }\n    .filters-grid { grid-template-columns: 1fr 1fr !important; }\n    .search-field { grid-column: 1 / -1; }\n    .toolbar-footer { align-items: stretch !important; flex-direction: column; }\n    .toolbar-footer button, .toolbar-footer > div { width: 100%; }\n    .toolbar-footer > div { justify-content: space-between; }\n  }\n  @media (max-width: 480px) {\n    .filters-grid { grid-template-columns: 1fr !important; }\n    .search-field { grid-column: auto; }\n    .ticket-cell { grid-template-columns: 1fr; gap: 5px; }\n    .page-title { font-size: 27px !important; }\n  }\n</style>\n<div class=\"maintenance-ui min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"maintenance interface wrapper\">\n    <div class=\"mx-auto max-w-[1360px] px-5 py-6 md:px-8 md:py-8\" data-kid=\"1-1\" data-name=\"page content container\">\n        <header class=\"mb-6 flex flex-col justify-between gap-5 md:flex-row md:items-end\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div data-kid=\"1-1-1-1\" data-name=\"page title and description group\">\n                <p class=\"mb-1 text-[13px] font-bold uppercase tracking-[.12em] text-[var(--teal)]\" data-kid=\"1-1-1-1-1\" data-name=\"category label text\">\n                    Gestão Predial\n                </p>\n                <h1 class=\"page-title m-0 text-[32px] font-extrabold leading-tight tracking-[-.035em] text-[var(--navy)] md:text-[38px]\" data-kid=\"1-1-1-1-2\" data-name=\"page main headline\">\n                    Central de Ocorrências\n                </h1>\n                <p class=\"mt-2 mb-0 text-[15px] text-[var(--muted)]\" data-kid=\"1-1-1-1-3\" data-name=\"page descriptive text\">\n                    Histórico, andamento e prazos de manutenção.\n                </p>\n            </div>\n            <button class=\"action-button !border-[var(--teal)] !bg-[var(--teal)] !px-5 !text-white hover:!bg-[var(--teal-dark)]\" data-kid=\"1-1-1-2\" data-name=\"create new incident button\" type=\"button\">\n                + Nova ocorrência\n            </button>\n        </header>\n        <nav aria-label=\"Navegação principal\" class=\"main-navigation mb-8 flex flex-wrap gap-1 rounded-xl border border-[var(--line)] bg-[#e8f0ee] p-1.5\" data-kid=\"1-1-2\" data-name=\"navigation menu\">\n            <a class=\"nav-link flex flex-1 items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold no-underline\" data-kid=\"1-1-2-1\" data-name=\"overview nav link\" href=\"#\">\n                Visão geral\n            </a>\n            <a class=\"nav-link flex flex-1 items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold no-underline\" data-kid=\"1-1-2-2\" data-name=\"register nav link\" href=\"#\">\n                Registrar\n            </a>\n            <a aria-current=\"page\" class=\"flex flex-1 items-center justify-center rounded-lg bg-[var(--teal)] px-4 py-3 text-sm font-bold text-white shadow-sm no-underline\" data-kid=\"1-1-2-3\" data-name=\"incidents nav link\" href=\"#\">\n                Ocorrências\n                <span class=\"ml-2 rounded-full bg-white/20 px-2 py-0.5 text-xs\" data-kid=\"1-1-2-3-1\" data-name=\"active incident count badge\">\n                    2\n                </span>\n            </a>\n            <a class=\"nav-link flex flex-1 items-center justify-center rounded-lg px-4 py-3 text-sm font-semibold no-underline\" data-kid=\"1-1-2-4\" data-name=\"tasks nav link\" href=\"#\">\n                Tarefas\n            </a>\n        </nav>\n        <main data-kid=\"1-1-3\" data-name=\"incidents section\">\n            <div class=\"mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-end\" data-kid=\"1-1-3-1\" data-name=\"incidents section header\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"header text group\">\n                    <h2 class=\"m-0 text-[24px] font-bold tracking-[-.025em] text-[var(--navy)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"incidents section title\">\n                        Histórico de ocorrências\n                    </h2>\n                    <p class=\"mt-1 mb-0 text-sm text-[var(--muted)]\" data-kid=\"1-1-3-1-1-2\" data-name=\"incidents summary text\">\n                        2 registros ·\n                        <strong class=\"font-bold text-[var(--urgent)]\" data-kid=\"1-1-3-1-1-2-1\" data-name=\"urgent incidents count\">\n                            1 ocorrência urgente aberta\n                        </strong>\n                    </p>\n                </div>\n                <span class=\"text-sm text-[var(--muted)]\" data-kid=\"1-1-3-1-2\" data-name=\"status helper text\">\n                    Prioridade e andamento são acompanhados separadamente.\n                </span>\n            </div>\n            <section aria-label=\"Buscar e filtrar ocorrências\" class=\"mb-5 border-y border-[var(--line)] py-5\" data-kid=\"1-1-3-2\" data-name=\"filters toolbar\">\n                <div class=\"filters-grid grid grid-cols-[minmax(220px,1.7fr)_minmax(170px,1fr)_minmax(165px,1fr)] gap-4\" data-kid=\"1-1-3-2-1\" data-name=\"filters input grid\">\n                    <div class=\"search-field\" data-kid=\"1-1-3-2-1-1\" data-name=\"search filter container\">\n                        <label class=\"filter-label\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"search filter label\" for=\"ticket-search\">\n                            Buscar ocorrências\n                        </label>\n                        <input class=\"field-control\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"search input field\" id=\"ticket-search\" placeholder=\"Local ou descrição\" type=\"search\"/>\n                    </div>\n                    <div data-kid=\"1-1-3-2-1-2\" data-name=\"status filter container\">\n                        <label class=\"filter-label\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"status filter label\" for=\"status-filter\">\n                            Andamento\n                        </label>\n                        <select class=\"field-control\" data-kid=\"1-1-3-2-1-2-2\" data-name=\"status select dropdown\" id=\"status-filter\">\n                            <option data-kid=\"1-1-3-2-1-2-2-1\" data-name=\"status all option\" selected=\"\">\n                                Todos\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-2\" data-name=\"status opened option\">\n                                Abertas\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-3\" data-name=\"status triaging option\">\n                                Em triagem\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-4\" data-name=\"status assigned option\">\n                                Atribuídas\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-5\" data-name=\"status executing option\">\n                                Em execução\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-6\" data-name=\"status waiting material option\">\n                                Aguardando material\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-2-2-7\" data-name=\"status resolved option\">\n                                Resolvidas\n                            </option>\n                        </select>\n                    </div>\n                    <div data-kid=\"1-1-3-2-1-3\" data-name=\"sort filter container\">\n                        <label class=\"filter-label\" data-kid=\"1-1-3-2-1-3-1\" data-name=\"sort filter label\" for=\"sort-filter\">\n                            Ordenar por\n                        </label>\n                        <select class=\"field-control\" data-kid=\"1-1-3-2-1-3-2\" data-name=\"sort select dropdown\" id=\"sort-filter\">\n                            <option data-kid=\"1-1-3-2-1-3-2-1\" data-name=\"sort newest option\" selected=\"\">\n                                Mais recentes\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-3-2-2\" data-name=\"sort priority option\">\n                                Maior prioridade\n                            </option>\n                            <option data-kid=\"1-1-3-2-1-3-2-3\" data-name=\"sort deadline option\">\n                                Prazo mais próximo\n                            </option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"toolbar-footer mt-4 flex items-center justify-between gap-4\" data-kid=\"1-1-3-2-2\" data-name=\"toolbar footer\">\n                    <span class=\"text-sm text-[var(--muted)]\" data-kid=\"1-1-3-2-2-1\" data-name=\"incidents display count\">\n                        Exibindo\n                        <strong class=\"text-[var(--ink)]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"incidents count value\">\n                            2 ocorrências\n                        </strong>\n                    </span>\n                    <button class=\"action-button\" data-kid=\"1-1-3-2-2-2\" data-name=\"export csv button\" type=\"button\">\n                        Exportar CSV\n                    </button>\n                </div>\n            </section>\n            <section aria-label=\"Lista de ocorrências\" data-kid=\"1-1-3-3\" data-name=\"incidents list section\">\n                <div aria-label=\"Ocorrências registradas\" class=\"w-full\" data-kid=\"1-1-3-3-1\" data-name=\"incidents table\" role=\"table\">\n                    <div class=\"ticket-head ticket-grid border-b border-[var(--line-strong)] bg-[#e8f0ee] px-4 py-3 text-[12px] font-bold uppercase tracking-[.055em] text-[var(--muted)]\" data-kid=\"1-1-3-3-1-1\" data-name=\"table header row\" role=\"row\">\n                        <div data-kid=\"1-1-3-3-1-1-1\" data-name=\"incident column header\" role=\"columnheader\">\n                            Ocorrência\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-2\" data-name=\"priority column header\" role=\"columnheader\">\n                            Prioridade\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-3\" data-name=\"status column header\" role=\"columnheader\">\n                            Andamento\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-4\" data-name=\"assigned to column header\" role=\"columnheader\">\n                            Responsável\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-5\" data-name=\"registered at column header\" role=\"columnheader\">\n                            Registrada\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-6\" data-name=\"deadline column header\" role=\"columnheader\">\n                            Prazo\n                        </div>\n                        <div data-kid=\"1-1-3-3-1-1-7\" data-name=\"actions column header\" role=\"columnheader\">\n                            Atualizar andamento\n                        </div>\n                    </div>\n                    <div data-kid=\"1-1-3-3-1-2\" data-name=\"table body row group\" role=\"rowgroup\">\n                        <article class=\"ticket-row ticket-grid urgent-row border-b border-[var(--urgent-line)] px-4 py-5\" data-kid=\"1-1-3-3-1-2-1\" data-name=\"incident row\" role=\"row\">\n                            <div class=\"ticket-cell min-w-0 py-2\" data-kid=\"1-1-3-3-1-2-1-1\" data-label=\"Ocorrência\" data-name=\"incident detail cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-1-1\" data-name=\"mobile incident label\">\n                                    Ocorrência\n                                </span>\n                                <div data-kid=\"1-1-3-3-1-2-1-1-2\" data-name=\"incident content block\">\n                                    <div class=\"mb-1 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-3-1-2-1-1-2-1\" data-name=\"incident category group\">\n                                        <span class=\"text-[13px] font-semibold text-[var(--teal-dark)]\" data-kid=\"1-1-3-3-1-2-1-1-2-1-2\" data-name=\"category name text\">\n                                            Elétrica\n                                        </span>\n                                    </div>\n                                    <h3 class=\"m-0 text-[16px] font-bold leading-snug text-[var(--navy)]\" data-kid=\"1-1-3-3-1-2-1-1-2-2\" data-name=\"incident title\">\n                                        Disjuntor do circuito 10 desarma ao ligar o chuveiro\n                                    </h3>\n                                    <p class=\"site-name mt-1.5 mb-0 text-[13px] leading-snug text-[var(--muted)]\" data-kid=\"1-1-3-3-1-2-1-1-2-3\" data-name=\"location text\">\n                                        casa da mae joana , numero 345, bairro cavalada, ararangua- SC\n                                    </p>\n                                    <p class=\"mt-2 mb-0 text-[13px] leading-snug text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-1-1-2-4\" data-name=\"description text\">\n                                        É necessário que técnico eletricista se desloque para verificar por que o disjuntor do circuito 10 está desligando quando o morador liga o chuveiro.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-2\" data-label=\"Prioridade\" data-name=\"priority cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-2-1\" data-name=\"mobile priority label\">\n                                    Prioridade\n                                </span>\n                                <span class=\"priority-label\" data-kid=\"1-1-3-3-1-2-1-2-2\" data-name=\"priority label\">\n                                    <i class=\"priority-dot\" data-kid=\"1-1-3-3-1-2-1-2-2-1\" data-name=\"priority dot icon\">\n                                    </i>\n                                    Urgente\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-3\" data-label=\"Andamento\" data-name=\"status cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-3-1\" data-name=\"mobile status label\">\n                                    Andamento\n                                </span>\n                                <span class=\"status-label\" data-kid=\"1-1-3-3-1-2-1-3-2\" data-name=\"status label\">\n                                    <i class=\"status-dot\" data-kid=\"1-1-3-3-1-2-1-3-2-1\" data-name=\"status dot icon\">\n                                    </i>\n                                    Aberta\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-4\" data-label=\"Responsável\" data-name=\"assignee cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-4-1\" data-name=\"mobile assignee label\">\n                                    Responsável\n                                </span>\n                                <span class=\"detail-text font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-1-4-2\" data-name=\"assignee name\">\n                                    jefinho fófó\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-5\" data-label=\"Registrada\" data-name=\"registration date cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-5-1\" data-name=\"mobile registration label\">\n                                    Registrada\n                                </span>\n                                <span class=\"detail-text\" data-kid=\"1-1-3-3-1-2-1-5-2\" data-name=\"registration date time\">\n                                    18/09/2026\n                                    <br data-kid=\"1-1-3-3-1-2-1-5-2-1\" data-name=\"line break\"/>\n                                    11:33:01\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-6\" data-label=\"Prazo\" data-name=\"deadline cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-6-1\" data-name=\"mobile deadline label\">\n                                    Prazo\n                                </span>\n                                <span class=\"detail-text font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-1-6-2\" data-name=\"deadline date\">\n                                    09/12/2026\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-1-7\" data-label=\"Atualizar andamento\" data-name=\"actions cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-1-7-1\" data-name=\"mobile actions label\">\n                                    Atualizar andamento\n                                </span>\n                                <select aria-label=\"Atualizar andamento da ocorrência elétrica\" class=\"update-select\" data-kid=\"1-1-3-3-1-2-1-7-2\" data-name=\"update status select dropdown\">\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-1\" data-name=\"status option\" selected=\"\">\n                                        Aberta\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-2\" data-name=\"status option\">\n                                        Em triagem\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-3\" data-name=\"status option\">\n                                        Atribuída\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-4\" data-name=\"status option\">\n                                        Em execução\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-5\" data-name=\"status option\">\n                                        Aguardando material\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-1-7-2-6\" data-name=\"status option\">\n                                        Resolvida\n                                    </option>\n                                </select>\n                            </div>\n                        </article>\n                        <article class=\"ticket-row ticket-grid normal-row border-b border-[var(--line)] bg-[var(--paper)] px-4 py-5\" data-kid=\"1-1-3-3-1-2-2\" data-name=\"incident row\" role=\"row\">\n                            <div class=\"ticket-cell min-w-0 py-2\" data-kid=\"1-1-3-3-1-2-2-1\" data-label=\"Ocorrência\" data-name=\"incident detail cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-1-1\" data-name=\"mobile incident label\">\n                                    Ocorrência\n                                </span>\n                                <div data-kid=\"1-1-3-3-1-2-2-1-2\" data-name=\"incident content block\">\n                                    <div class=\"mb-1 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-3-1-2-2-1-2-1\" data-name=\"incident category group\">\n                                        <span class=\"text-[13px] font-semibold text-[var(--teal-dark)]\" data-kid=\"1-1-3-3-1-2-2-1-2-1-1\" data-name=\"category name text\">\n                                            Hidráulica\n                                        </span>\n                                    </div>\n                                    <h3 class=\"m-0 text-[16px] font-bold leading-snug text-[var(--navy)]\" data-kid=\"1-1-3-3-1-2-2-1-2-2\" data-name=\"incident title\">\n                                        Inspeção preventiva realizada\n                                    </h3>\n                                    <p class=\"site-name mt-1.5 mb-0 text-[13px] leading-snug text-[var(--muted)]\" data-kid=\"1-1-3-3-1-2-2-1-2-3\" data-name=\"location text\">\n                                        casa da mae joana , numero 345, bairro cavalada, ararangua- SC\n                                    </p>\n                                    <p class=\"mt-2 mb-0 text-[13px] leading-snug text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-2-1-2-4\" data-name=\"description text\">\n                                        Inspeção preventiva realizada. Sem ocorrências.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-2\" data-label=\"Prioridade\" data-name=\"priority cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-2-1\" data-name=\"mobile priority label\">\n                                    Prioridade\n                                </span>\n                                <span class=\"priority-label\" data-kid=\"1-1-3-3-1-2-2-2-2\" data-name=\"priority label\">\n                                    <i class=\"priority-dot\" data-kid=\"1-1-3-3-1-2-2-2-2-1\" data-name=\"priority dot icon\">\n                                    </i>\n                                    Normal\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-3\" data-label=\"Andamento\" data-name=\"status cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-3-1\" data-name=\"mobile status label\">\n                                    Andamento\n                                </span>\n                                <span class=\"status-label\" data-kid=\"1-1-3-3-1-2-2-3-2\" data-name=\"status label\">\n                                    <i class=\"status-dot\" data-kid=\"1-1-3-3-1-2-2-3-2-1\" data-name=\"status dot icon\">\n                                    </i>\n                                    Aberta\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-4\" data-label=\"Responsável\" data-name=\"assignee cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-4-1\" data-name=\"mobile assignee label\">\n                                    Responsável\n                                </span>\n                                <span class=\"detail-text font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-2-4-2\" data-name=\"assignee name\">\n                                    jefinho do fófó\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-5\" data-label=\"Registrada\" data-name=\"registration date cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-5-1\" data-name=\"mobile registration label\">\n                                    Registrada\n                                </span>\n                                <span class=\"detail-text\" data-kid=\"1-1-3-3-1-2-2-5-2\" data-name=\"registration date time\">\n                                    18/09/2026\n                                    <br data-kid=\"1-1-3-3-1-2-2-5-2-1\" data-name=\"line break\"/>\n                                    11:30:54\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-6\" data-label=\"Prazo\" data-name=\"deadline cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-6-1\" data-name=\"mobile deadline label\">\n                                    Prazo\n                                </span>\n                                <span class=\"detail-text font-semibold text-[var(--ink)]\" data-kid=\"1-1-3-3-1-2-2-6-2\" data-name=\"deadline date\">\n                                    09/12/2026\n                                </span>\n                            </div>\n                            <div class=\"ticket-cell py-2\" data-kid=\"1-1-3-3-1-2-2-7\" data-label=\"Atualizar andamento\" data-name=\"actions cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-1-3-3-1-2-2-7-1\" data-name=\"mobile actions label\">\n                                    Atualizar andamento\n                                </span>\n                                <select aria-label=\"Atualizar andamento da inspeção hidráulica\" class=\"update-select\" data-kid=\"1-1-3-3-1-2-2-7-2\" data-name=\"update status select dropdown\">\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-1\" data-name=\"status option\" selected=\"\">\n                                        Aberta\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-2\" data-name=\"status option\">\n                                        Em triagem\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-3\" data-name=\"status option\">\n                                        Atribuída\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-4\" data-name=\"status option\">\n                                        Em execução\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-5\" data-name=\"status option\">\n                                        Aguardando material\n                                    </option>\n                                    <option data-kid=\"1-1-3-3-1-2-2-7-2-6\" data-name=\"status option\">\n                                        Resolvida\n                                    </option>\n                                </select>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n            </section>\n            <footer class=\"mt-5 border-t border-[var(--line)] pt-4 text-[13px] text-[var(--muted)]\" data-kid=\"1-1-3-4\" data-name=\"section footer text\">\n                Prioridade indica urgência. Andamento acompanha a etapa de atendimento.\n            </footer>\n        </main>\n    </div>\n</div>\n",
