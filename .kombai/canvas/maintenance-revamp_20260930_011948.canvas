      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n@layer components {\n  .ui-icon { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; color: currentColor; font-size: 18px; line-height: 1; }\n  .nav-link { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; gap: 9px; border-bottom: 2px solid transparent; padding: 0 18px; color: #64748b; font-size: 14px; font-weight: 600; white-space: nowrap; }\n  .nav-link.active { border-color: #0f766e; color: #0f766e; }\n  .status-select { min-height: 44px; width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; background-color: #fff; padding: 0 38px 0 13px; color: #172554; font-size: 14px; font-weight: 600; }\n  @media (max-width: 680px) {\n    .nav-link { min-height: 54px; gap: 5px; flex-direction: column; padding: 7px 3px; font-size: 11px; }\n    .nav-link .ui-icon { width: 17px; height: 17px; font-size: 17px; }\n  }\n</style>\n<div class=\"min-h-screen bg-[#f5f8f8] text-[#18263d] [font-family:'DM_Sans',sans-serif]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"mx-auto max-w-[1320px] px-7 pb-14 pt-7 max-[680px]:px-4 max-[680px]:pb-8 max-[680px]:pt-4\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n        <header class=\"flex items-center justify-between gap-6 max-[760px]:items-start max-[760px]:flex-col\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title area\">\n                <div class=\"grid h-11 w-11 shrink-0 place-items-center rounded-[14px] bg-[#172554] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-building-community ui-icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"community building icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand title area\">\n                    <p class=\"m-0 text-[13px] font-semibold tracking-[0.01em] text-[#59667a]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand subtitle\">\n                        Gestão Predial\n                    </p>\n                    <p class=\"m-0 mt-0.5 text-[19px] font-extrabold leading-tight text-[#172554] [font-family:'Manrope',sans-serif]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand main title\">\n                        Central de Ocorrências\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 max-[760px]:w-full max-[760px]:justify-between\" data-kid=\"1-1-1-2\" data-name=\"header status and action area\">\n                <span class=\"inline-flex min-h-9 items-center gap-2 rounded-full border border-[#c9e1da] bg-[#f1faf6] px-3 text-[13px] font-semibold text-[#17634e]\" data-kid=\"1-1-1-2-1\" data-name=\"status synchronization indicator\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#15966a]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status green dot icon\">\n                    </span>\n                    Sincronizado\n                </span>\n                <button class=\"inline-flex min-h-10 items-center justify-center gap-2 rounded-[10px] border border-[#bfd9d5] bg-white px-4 text-[13px] font-bold text-[#0f766e]\" data-kid=\"1-1-1-2-2\" data-name=\"new occurrence button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus ui-icon\" data-kid=\"1-1-1-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Nova ocorrência\n                </button>\n            </div>\n        </header>\n        <nav aria-label=\"Navegação principal\" class=\"mt-6 flex items-center gap-1 border-b border-[#dce5e7] max-[680px]:grid max-[680px]:grid-cols-4 max-[680px]:gap-0\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <button class=\"nav-link\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard ui-icon\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"dashboard link text\">\n                    Visão geral\n                </span>\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-2\" data-name=\"register navigation link\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-clipboard-plus ui-icon\" data-kid=\"1-1-2-2-1\" data-name=\"clipboard plus icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"register link text\">\n                    Registrar\n                </span>\n            </button>\n            <button class=\"nav-link\" data-kid=\"1-1-2-3\" data-name=\"occurrences navigation link\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-clipboard-list ui-icon\" data-kid=\"1-1-2-3-1\" data-name=\"clipboard list icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"occurrences link text\">\n                    Ocorrências\n                </span>\n            </button>\n            <button aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-2-4\" data-name=\"tasks navigation link\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-check ui-icon\" data-kid=\"1-1-2-4-1\" data-name=\"list check icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"tasks link text\">\n                    Tarefas\n                </span>\n            </button>\n        </nav>\n        <main class=\"mx-auto max-w-[1120px] pt-9 max-[680px]:pt-6\" data-kid=\"1-1-3\" data-name=\"main page content\">\n            <div class=\"flex items-end justify-between gap-6 max-[700px]:items-start max-[700px]:flex-col max-[700px]:gap-3\" data-kid=\"1-1-3-1\" data-name=\"page content header\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"page title and description area\">\n                    <h1 class=\"m-0 text-[32px] font-extrabold leading-tight tracking-[-0.035em] text-[#172554] [font-family:'Manrope',sans-serif] max-[680px]:text-[27px]\" data-kid=\"1-1-3-1-1-1\" data-name=\"main page headline\">\n                        Fila por prioridade\n                    </h1>\n                    <p class=\"mb-0 mt-2 text-[15px] leading-6 text-[#536176]\" data-kid=\"1-1-3-1-1-2\" data-name=\"page description text\">\n                        Trabalho não resolvido, organizado pelo nível de prioridade.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-x-3 gap-y-1 pb-1 text-[13px] text-[#536176]\" data-kid=\"1-1-3-1-2\" data-name=\"page statistics information\">\n                    <span class=\"font-bold text-[#172554]\" data-kid=\"1-1-3-1-2-1\" data-name=\"open occurrences count text\">\n                        2 ocorrências em aberto\n                    </span>\n                    <span class=\"hidden h-1 w-1 rounded-full bg-[#94a3b8] sm:block\" data-kid=\"1-1-3-1-2-2\" data-name=\"separator dot\">\n                    </span>\n                    <span data-kid=\"1-1-3-1-2-3\" data-name=\"history access instructions\">\n                        Histórico completo em\n                        <span class=\"font-semibold text-[#0f766e]\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"history access link\">\n                            Ocorrências\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <section aria-labelledby=\"urgent-heading\" class=\"mt-8 max-[680px]:mt-6\" data-kid=\"1-1-3-2\" data-name=\"urgent priority section\">\n                <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-1-3-2-1\" data-name=\"urgent section header\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-3-2-1-1\" data-name=\"urgent title area\">\n                        <span class=\"grid h-8 w-8 place-items-center rounded-[10px] bg-[#fff0ee] text-[#bd332e]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"urgent alert icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-alert-triangle ui-icon\" data-kid=\"1-1-3-2-1-1-1-1\" data-name=\"alert triangle icon\">\n                            </i>\n                        </span>\n                        <div class=\"flex items-baseline gap-2.5\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"urgent priority text\">\n                            <h2 class=\"m-0 text-[17px] font-bold text-[#172554]\" data-kid=\"1-1-3-2-1-1-2-1\" data-name=\"urgent heading\" id=\"urgent-heading\">\n                                Prioridade alta\n                            </h2>\n                            <span class=\"text-[13px] font-semibold text-[#687589]\" data-kid=\"1-1-3-2-1-1-2-2\" data-name=\"urgent count text\">\n                                1 ocorrência\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"inline-flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.08em] text-[#a3302c]\" data-kid=\"1-1-3-2-1-2\" data-name=\"urgent status badge\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#d7493f]\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"urgent status dot icon\">\n                        </span>\n                        Urgente\n                    </span>\n                </div>\n                <article class=\"rounded-[18px] border border-[#f0c9c4] bg-[#fff9f8] px-7 py-6 max-[680px]:rounded-[15px] max-[680px]:px-4 max-[680px]:py-5\" data-kid=\"1-1-3-2-2\" data-name=\"urgent task card\">\n                    <div class=\"grid grid-cols-[minmax(0,1fr)_250px] gap-8 max-[760px]:grid-cols-1 max-[760px]:gap-5\" data-kid=\"1-1-3-2-2-1\" data-name=\"urgent task layout\">\n                        <div class=\"min-w-0\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"urgent task details\">\n                            <div class=\"mb-3 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-2-2-1-1-1\" data-name=\"urgent tags area\">\n                                <span class=\"inline-flex items-center gap-1.5 rounded-md bg-[#fde9e7] px-2.5 py-1 text-[12px] font-bold uppercase tracking-[0.04em] text-[#a3302c]\" data-kid=\"1-1-3-2-2-1-1-1-1\" data-name=\"urgent tag badge\">\n                                    Urgente\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[#536176]\" data-kid=\"1-1-3-2-2-1-1-1-2\" data-name=\"urgent category tag\">\n                                    Elétrica\n                                </span>\n                            </div>\n                            <h3 class=\"m-0 max-w-[700px] text-[23px] font-bold leading-[1.25] tracking-[-0.02em] text-[#172554] [font-family:'Manrope',sans-serif] max-[680px]:text-[20px]\" data-kid=\"1-1-3-2-2-1-1-2\" data-name=\"urgent task title\">\n                                Disjuntor do circuito 10 desliga ao ligar o chuveiro\n                            </h3>\n                            <div class=\"mt-3 flex items-start gap-2 text-[14px] leading-6 text-[#35445b]\" data-kid=\"1-1-3-2-2-1-1-3\" data-name=\"urgent task location\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin ui-icon mt-1 shrink-0 text-[#64748b]\" data-kid=\"1-1-3-2-2-1-1-3-1\" data-name=\"location pin icon\">\n                                </i>\n                                <span data-kid=\"1-1-3-2-2-1-1-3-2\" data-name=\"urgent task address text\">\n                                    Casa da mãe Joana, nº 345 · Bairro Cavalada, Araranguá – SC\n                                </span>\n                            </div>\n                            <div class=\"mt-6 grid grid-cols-2 gap-x-8 gap-y-4 border-t border-[#f0d9d6] pt-4 max-[500px]:grid-cols-1 max-[500px]:gap-y-3\" data-kid=\"1-1-3-2-2-1-1-4\" data-name=\"urgent task metadata grid\">\n                                <div data-kid=\"1-1-3-2-2-1-1-4-1\" data-name=\"responsible party area\">\n                                    <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.055em] text-[#687589]\" data-kid=\"1-1-3-2-2-1-1-4-1-1\" data-name=\"responsible party label\">\n                                        Responsável\n                                    </p>\n                                    <p class=\"mb-0 mt-1 text-[15px] font-semibold text-[#24354c]\" data-kid=\"1-1-3-2-2-1-1-4-1-2\" data-name=\"responsible party name\">\n                                        jefinho fófó\n                                    </p>\n                                </div>\n                                <div data-kid=\"1-1-3-2-2-1-1-4-2\" data-name=\"deadline area\">\n                                    <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.055em] text-[#687589]\" data-kid=\"1-1-3-2-2-1-1-4-2-1\" data-name=\"deadline label\">\n                                        Prazo\n                                    </p>\n                                    <p class=\"mb-0 mt-1 text-[15px] font-semibold text-[#24354c]\" data-kid=\"1-1-3-2-2-1-1-4-2-2\" data-name=\"deadline date\">\n                                        09/12/2026\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex flex-col justify-between gap-5 border-l border-[#f0d9d6] pl-6 max-[760px]:border-l-0 max-[760px]:border-t max-[760px]:pl-0 max-[760px]:pt-4\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"urgent task status area\">\n                            <div data-kid=\"1-1-3-2-2-1-2-1\" data-name=\"status update area\">\n                                <label class=\"mb-2 block text-[13px] font-semibold text-[#34445b]\" data-kid=\"1-1-3-2-2-1-2-1-1\" data-name=\"status update label\" for=\"urgent-status\">\n                                    Andamento\n                                </label>\n                                <select aria-label=\"Atualizar andamento da ocorrência urgente\" class=\"status-select\" data-kid=\"1-1-3-2-2-1-2-1-2\" data-name=\"urgent status select dropdown\" id=\"urgent-status\">\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-1\" data-name=\"status option\" selected=\"\">\n                                        Aberta\n                                    </option>\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-2\" data-name=\"status option\">\n                                        Em triagem\n                                    </option>\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-3\" data-name=\"status option\">\n                                        Atribuída\n                                    </option>\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-4\" data-name=\"status option\">\n                                        Em execução\n                                    </option>\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-5\" data-name=\"status option\">\n                                        Aguardando material\n                                    </option>\n                                    <option data-kid=\"1-1-3-2-2-1-2-1-2-6\" data-name=\"status option\">\n                                        Resolvida\n                                    </option>\n                                </select>\n                            </div>\n                            <p class=\"m-0 flex items-start gap-2 text-[13px] leading-5 text-[#7e3733]\" data-kid=\"1-1-3-2-2-1-2-2\" data-name=\"status info note\">\n                                <i aria-hidden=\"true\" class=\"ti ti-info-circle ui-icon mt-0.5 shrink-0\" data-kid=\"1-1-3-2-2-1-2-2-1\" data-name=\"info circle icon\">\n                                </i>\n                                Prioridade e andamento são informações diferentes.\n                            </p>\n                        </div>\n                    </div>\n                </article>\n            </section>\n            <section aria-label=\"Prioridade atenção\" class=\"mt-5 flex min-h-[54px] items-center justify-between gap-4 rounded-[12px] border border-[#e9e3d6] bg-[#fbfaf7] px-4 py-3 max-[520px]:items-start max-[520px]:flex-col max-[520px]:gap-1\" data-kid=\"1-1-3-3\" data-name=\"attention priority section\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-3-3-1\" data-name=\"attention section title area\">\n                    <span class=\"h-2.5 w-2.5 rounded-full bg-[#ca861c]\" data-kid=\"1-1-3-3-1-1\" data-name=\"attention status dot icon\">\n                    </span>\n                    <span class=\"text-[14px] font-bold text-[#26374e]\" data-kid=\"1-1-3-3-1-2\" data-name=\"attention section heading\">\n                        Atenção\n                    </span>\n                    <span class=\"rounded-full bg-[#f0eadc] px-2 py-0.5 text-[12px] font-bold text-[#755b2e]\" data-kid=\"1-1-3-3-1-3\" data-name=\"attention occurrence count badge\">\n                        0\n                    </span>\n                </div>\n                <p class=\"m-0 text-[13px] text-[#657185]\" data-kid=\"1-1-3-3-2\" data-name=\"attention status empty text\">\n                    Nenhuma ocorrência pendente nesta prioridade.\n                </p>\n            </section>\n            <section aria-labelledby=\"normal-heading\" class=\"mt-9\" data-kid=\"1-1-3-4\" data-name=\"normal priority section\">\n                <div class=\"mb-2 flex items-center gap-2.5\" data-kid=\"1-1-3-4-1\" data-name=\"normal section title area\">\n                    <span class=\"h-2.5 w-2.5 rounded-full bg-[#168365]\" data-kid=\"1-1-3-4-1-1\" data-name=\"normal status dot icon\">\n                    </span>\n                    <h2 class=\"m-0 text-[17px] font-bold text-[#172554]\" data-kid=\"1-1-3-4-1-2\" data-name=\"normal section heading\" id=\"normal-heading\">\n                        Demais tarefas\n                    </h2>\n                    <span class=\"text-[13px] font-semibold text-[#687589]\" data-kid=\"1-1-3-4-1-3\" data-name=\"normal occurrence count text\">\n                        1 ocorrência normal\n                    </span>\n                </div>\n                <article class=\"grid grid-cols-[minmax(0,1fr)_250px] items-center gap-6 border-y border-[#dce5e7] py-5 max-[760px]:grid-cols-1 max-[760px]:gap-4\" data-kid=\"1-1-3-4-2\" data-name=\"normal task card\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-3-4-2-1\" data-name=\"normal task details\">\n                        <div class=\"mb-1.5 flex flex-wrap items-center gap-2\" data-kid=\"1-1-3-4-2-1-1\" data-name=\"normal tags area\">\n                            <span class=\"rounded-md bg-[#e5f3ee] px-2 py-1 text-[11px] font-bold uppercase tracking-[0.05em] text-[#17634e]\" data-kid=\"1-1-3-4-2-1-1-1\" data-name=\"normal priority tag\">\n                                Normal\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[#59677b]\" data-kid=\"1-1-3-4-2-1-1-2\" data-name=\"normal category tag\">\n                                Hidráulica\n                            </span>\n                        </div>\n                        <h3 class=\"m-0 text-[17px] font-bold leading-snug text-[#172554]\" data-kid=\"1-1-3-4-2-1-2\" data-name=\"normal task title\">\n                            Inspeção preventiva sem ocorrências\n                        </h3>\n                        <p class=\"m-0 mt-1.5 text-[14px] leading-5 text-[#3f4f65]\" data-kid=\"1-1-3-4-2-1-3\" data-name=\"normal task location\">\n                            Casa da mãe Joana, nº 345 · Bairro Cavalada, Araranguá – SC\n                        </p>\n                        <div class=\"mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[13px] text-[#536176]\" data-kid=\"1-1-3-4-2-1-4\" data-name=\"normal task metadata area\">\n                            <span data-kid=\"1-1-3-4-2-1-4-1\" data-name=\"responsible party area\">\n                                <strong class=\"font-semibold text-[#34445b]\" data-kid=\"1-1-3-4-2-1-4-1-1\" data-name=\"responsible party label\">\n                                    Responsável:\n                                </strong>\n                                jefinho do fófó\n                            </span>\n                            <span data-kid=\"1-1-3-4-2-1-4-2\" data-name=\"deadline area\">\n                                <strong class=\"font-semibold text-[#34445b]\" data-kid=\"1-1-3-4-2-1-4-2-1\" data-name=\"deadline label\">\n                                    Prazo:\n                                </strong>\n                                09/12/2026\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-1-3-4-2-2\" data-name=\"normal status update area\">\n                        <label class=\"mb-2 block text-[13px] font-semibold text-[#34445b]\" data-kid=\"1-1-3-4-2-2-1\" data-name=\"normal status label\" for=\"normal-status\">\n                            Andamento\n                        </label>\n                        <select aria-label=\"Atualizar andamento da ocorrência normal\" class=\"status-select\" data-kid=\"1-1-3-4-2-2-2\" data-name=\"normal status select dropdown\" id=\"normal-status\">\n                            <option data-kid=\"1-1-3-4-2-2-2-1\" data-name=\"status option\" selected=\"\">\n                                Aberta\n                            </option>\n                            <option data-kid=\"1-1-3-4-2-2-2-2\" data-name=\"status option\">\n                                Em triagem\n                            </option>\n                            <option data-kid=\"1-1-3-4-2-2-2-3\" data-name=\"status option\">\n                                Atribuída\n                            </option>\n                            <option data-kid=\"1-1-3-4-2-2-2-4\" data-name=\"status option\">\n                                Em execução\n                            </option>\n                            <option data-kid=\"1-1-3-4-2-2-2-5\" data-name=\"status option\">\n                                Aguardando material\n                            </option>\n                            <option data-kid=\"1-1-3-4-2-2-2-6\" data-name=\"status option\">\n                                Resolvida\n                            </option>\n                        </select>\n                    </div>\n                </article>\n            </section>\n            <footer class=\"mt-8 flex items-center justify-between gap-4 border-t border-[#dce5e7] pt-4 text-[12px] text-[#687589] max-[520px]:items-start max-[520px]:flex-col\" data-kid=\"1-1-3-5\" data-name=\"footer bar\">\n                <p class=\"m-0\" data-kid=\"1-1-3-5-1\" data-name=\"footer description text\">\n                    Esta fila mostra apenas ocorrências não resolvidas.\n                </p>\n                <p class=\"m-0\" data-kid=\"1-1-3-5-2\" data-name=\"footer assistance text\">\n                    Para consultar registros e histórico, acesse\n                    <span class=\"font-semibold text-[#0f766e]\" data-kid=\"1-1-3-5-2-1\" data-name=\"footer assistance link\">\n                        Ocorrências\n                    </span>\n                    .\n                </p>\n            </footer>\n        </main>\n    </div>\n</div>\n",
