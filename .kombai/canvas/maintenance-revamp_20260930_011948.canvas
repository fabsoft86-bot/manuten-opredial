      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.form-shell { font-family: 'DM Sans', sans-serif; }\n.form-title, .product-title { font-family: 'Manrope', sans-serif; }\n.form-control:focus { outline: 3px solid rgba(15,118,110,.18); border-color: #0f766e; }\n@media (max-width: 760px) {\n  .desktop-nav-label { display:none; }\n  .form-layout { grid-template-columns: 1fr !important; }\n  .field-pair { grid-template-columns: 1fr !important; }\n  .priority-options { grid-template-columns: 1fr !important; }\n  .shell-inner { padding-left: 16px !important; padding-right: 16px !important; }\n  .nav-item { min-width: 60px !important; padding-left: 8px !important; padding-right: 8px !important; }\n  .header-row { align-items:flex-start !important; }\n  .form-footer { flex-direction:column-reverse !important; align-items:stretch !important; }\n  .form-footer button { width:100% !important; }\n}\n</style>\n<div class=\"form-shell min-h-screen bg-[#f3f7f8] text-[#1e293b]\" data-kid=\"1\" style=\"--navy:#172554;--teal:#0f766e;--ink:#1e293b;--muted:#526276;--line:#d8e2e6;--paper:#ffffff;--soft:#eaf4f3;--urgent:#b42318;--urgent-bg:#fff2ef;--amber:#8a5300;--amber-bg:#fff8e8\">\n    <header class=\"border-b border-[#d8e2e6] bg-white\" data-kid=\"1-1\">\n        <div class=\"shell-inner mx-auto flex max-w-[1240px] items-center justify-between gap-6 px-8 py-5\" data-kid=\"1-1-1\">\n            <div class=\"header-row flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div class=\"grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#172554] text-white text-[23px]\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1-1\" style=\"font-size:23px;color:#fff\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"product-title text-[18px] font-extrabold tracking-[-.035em] text-[#172554]\" data-kid=\"1-1-1-1-2-1\">\n                        Central de Ocorrências\n                    </div>\n                    <div class=\"mt-0.5 text-[13px] text-[#526276]\" data-kid=\"1-1-1-1-2-2\">\n                        Gestão de manutenção predial\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-2\">\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#b8dfd6] bg-[#f0faf6] px-3 py-2 text-[12px] font-semibold text-[#17634f]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1\" data-name=\"synchronization status badge\" data-reason=\"text and indicator color updated based on sync state\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#15803d]\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    Sincronizado\n                </span>\n                <button class=\"rounded-lg bg-[#0f766e] px-4 py-2.5 text-[13px] font-bold text-white shadow-sm\" data-kid=\"1-1-1-2-2\">\n                    + Nova ocorrência\n                </button>\n            </div>\n        </div>\n        <nav aria-label=\"Navegação principal\" class=\"shell-inner mx-auto max-w-[1240px] px-8 pb-4\" data-kid=\"1-1-2\">\n            <div class=\"flex w-full items-center gap-1 rounded-xl border border-[#d8e2e6] bg-[#f7fafb] p-1.5\" data-kid=\"1-1-2-1\">\n                <button class=\"nav-item flex flex-1 items-center justify-center gap-2 rounded-lg px-5 py-3 text-[13px] font-semibold text-[#526276]\" data-kid=\"1-1-2-1-1\">\n                    <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-1-1-1\" style=\"font-size:17px;color:#526276\">\n                    </i>\n                    <span class=\"desktop-nav-label\" data-kid=\"1-1-2-1-1-2\">\n                        Visão geral\n                    </span>\n                </button>\n                <button aria-current=\"page\" class=\"nav-item flex flex-1 items-center justify-center gap-2 rounded-lg bg-[#172554] px-5 py-3 text-[13px] font-bold text-white shadow-sm\" data-kid=\"1-1-2-1-2\">\n                    <i class=\"ti ti-clipboard-plus text-[17px]\" data-kid=\"1-1-2-1-2-1\" style=\"font-size:17px;color:#fff\">\n                    </i>\n                    <span class=\"desktop-nav-label\" data-kid=\"1-1-2-1-2-2\">\n                        Registrar\n                    </span>\n                </button>\n                <button class=\"nav-item flex flex-1 items-center justify-center gap-2 rounded-lg px-5 py-3 text-[13px] font-semibold text-[#526276]\" data-kid=\"1-1-2-1-3\">\n                    <i class=\"ti ti-list-details text-[17px]\" data-kid=\"1-1-2-1-3-1\" style=\"font-size:17px;color:#526276\">\n                    </i>\n                    <span class=\"desktop-nav-label\" data-kid=\"1-1-2-1-3-2\">\n                        Ocorrências\n                    </span>\n                </button>\n                <button class=\"nav-item flex flex-1 items-center justify-center gap-2 rounded-lg px-5 py-3 text-[13px] font-semibold text-[#526276]\" data-kid=\"1-1-2-1-4\">\n                    <i class=\"ti ti-tool text-[17px]\" data-kid=\"1-1-2-1-4-1\" style=\"font-size:17px;color:#526276\">\n                    </i>\n                    <span class=\"desktop-nav-label\" data-kid=\"1-1-2-1-4-2\">\n                        Tarefas\n                    </span>\n                </button>\n            </div>\n        </nav>\n    </header>\n    <main class=\"shell-inner mx-auto max-w-[1080px] px-8 pb-14 pt-8\" data-kid=\"1-2\">\n        <div class=\"mb-6 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"form-title text-[30px] font-extrabold leading-tight tracking-[-.045em] text-[#172554]\" data-kid=\"1-2-1-1-1\">\n                    Registrar ocorrência\n                </h1>\n                <p class=\"mt-1 text-[15px] text-[#526276]\" data-kid=\"1-2-1-1-2\">\n                    Descreva o problema encontrado para que a equipe possa agir com segurança.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-lg border border-[#d8e2e6] bg-white px-3 py-2 text-[12px] font-medium text-[#526276]\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"draft status indicator\" data-reason=\"text content updated when draft status changes\">\n                <i class=\"ti ti-device-floppy text-[17px]\" data-kid=\"1-2-1-2-1\" style=\"font-size:17px;color:#0f766e\">\n                </i>\n                Rascunho salvo automaticamente\n            </div>\n        </div>\n        <section aria-label=\"Progresso do formulário\" class=\"mb-4 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#cbdedc] bg-[#edf7f5] px-5 py-4\" data-kid=\"1-2-2\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1\">\n                <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[#d4eee7] text-[#0f766e] text-[20px]\" data-kid=\"1-2-2-1-1\">\n                    <i class=\"ti ti-check\" data-kid=\"1-2-2-1-1-1\" style=\"font-size:20px;color:#0f766e\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-2-1-2\">\n                    <div class=\"text-[14px] font-bold text-[#172554]\" data-kid=\"1-2-2-1-2-1\">\n                        Tudo pronto para registrar\n                    </div>\n                    <div class=\"mt-0.5 text-[12px] text-[#526276]\" data-kid=\"1-2-2-1-2-2\">\n                        Os 7 campos obrigatórios foram preenchidos.\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex min-w-[260px] items-center gap-3\" data-kid=\"1-2-2-2\">\n                <div class=\"h-2 flex-1 overflow-hidden rounded-full bg-[#d5e4e2]\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"h-full w-full rounded-full bg-[#0f766e]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1\" data-name=\"progress bar fill\" data-reason=\"width updated by progress calculation script\">\n                    </div>\n                </div>\n                <span class=\"whitespace-nowrap text-[13px] font-bold text-[#0f766e]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"progress percentage text\" data-reason=\"text updated based on progress calculation\">\n                    7 de 7\n                </span>\n            </div>\n        </section>\n        <form class=\"space-y-4\" data-kid=\"1-2-3\">\n            <section class=\"rounded-2xl border border-[#d8e2e6] bg-white p-6 shadow-[0_2px_8px_rgba(23,37,84,0.04)]\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-4 flex items-center justify-between gap-4\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <h2 class=\"text-[17px] font-bold text-[#172554]\" data-kid=\"1-2-3-1-1-1-1\">\n                            Local da ocorrência\n                        </h2>\n                        <p class=\"mt-1 text-[13px] text-[#526276]\" data-kid=\"1-2-3-1-1-1-2\">\n                            Comece pelo imóvel e pelo ponto exato.\n                        </p>\n                    </div>\n                    <span class=\"rounded-md bg-[#f2f6f8] px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-[.08em] text-[#526276]\" data-kid=\"1-2-3-1-1-2\">\n                        Obrigatório\n                    </span>\n                </div>\n                <label class=\"mb-1.5 block text-[13px] font-semibold text-[#24344c]\" data-kid=\"1-2-3-1-2\" for=\"property\">\n                    Local / imóvel / identificação\n                </label>\n                <input class=\"form-control w-full rounded-lg border b