    "var_e66f2ed37829": {
      "type": "variant",
      "label": "03 · Passagem de serviço — Ocorrências",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 18480,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root{--navy:#172554;--teal:#0f766e;--teal-soft:#e9f5f3;--page:#f5f8f7;--paper:#fff;--ink:#172235;--muted:#526174;--line:#dce5e4;--line-strong:#c7d3d1;--urgent:#b42318;--urgent-soft:#fff2f0;--amber:#995b00;--amber-soft:#fff6e5;--sidebar:#101d40;--sidebar-muted:#b8c4d8;}\nbody{font-family:'DM Sans',sans-serif;background:var(--page);color:var(--ink);}\n.app-shell{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh;}\n.sidebar{background:var(--sidebar);color:#fff;padding:26px 16px 24px;display:flex;flex-direction:column;}\n.brand{display:flex;align-items:center;gap:11px;padding:0 9px 28px;border-bottom:1px solid rgba(255,255,255,.12);}\n.brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:#dff4ef;color:var(--teal);font-size:18px;}\n.brand-name{font:700 15px 'Manrope',sans-serif;letter-spacing:-.02em;}\n.brand-caption{display:block;margin-top:2px;font-size:11px;color:#c1ccda;letter-spacing:.02em;}\n.nav-label{margin:27px 10px 10px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#9daac0;}\n.nav-list{display:grid;gap:5px;}\n.nav-link{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 11px;border-radius:9px;color:#d5dfed;text-decoration:none;font-size:13px;font-weight:500;}\n.nav-link .ti{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;flex:0 0 18px;font-size:18px;color:#aebdd2;}\n.nav-link.active{background:rgba(60,183,163,.15);color:#fff;font-weight:700;}\n.nav-link.active .ti{color:#63d0bc;}\n.mobile-nav,.mobile-brand{display:none;}\n.main{min-width:0;padding:34px 42px 64px;}\n.main-inner{width:min(100%,1190px);margin:0 auto;}\n.topline{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:25px;border-bottom:1px solid var(--line);}\n.page-heading h1{margin:0;color:var(--navy);font:800 clamp(28px,3vw,36px)/1.15 'Manrope',sans-serif;letter-spacing:-.04em;}\n.page-heading p{margin:8px 0 0;color:var(--muted);font-size:14px;}\n.primary-action,.export-action{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:0 15px;border-radius:8px;font-size:13px;font-weight:700;white-space:nowrap;}\n.primary-action{border:1px solid var(--teal);background:var(--teal);color:white;box-shadow:0 2px 5px rgba(15,118,110,.12);}\n.primary-action .ti,.export-action .ti{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;flex:0 0 16px;font-size:16px;color:currentColor;}\n.filters{display:grid;grid-template-columns:minmax(240px,1.6fr) minmax(160px,.9fr) minmax(170px,.9fr) auto;align-items:end;gap:12px;padding:22px 0 18px;}\n.field{min-width:0;}\n.field label{display:block;margin-bottom:7px;color:#344358;font-size:12px;font-weight:700;}\n.input-wrap{position:relative;}\n.input-wrap .ti{position:absolute;left:13px;top:50%;transform:translateY(-50%);display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;font-size:17px;color:#5b6b7f;}\n.input,.select{width:100%;height:43px;border:1px solid var(--line-strong);border-radius:7px;background:white;color:var(--ink);font:500 13px 'DM Sans',sans-serif;}\n.input{padding:0 12px 0 39px;}\n.select{padding:0 34px 0 11px;}\n.input::placeholder{color:#758294;opacity:1;}\n.input:focus,.select:focus{outline:3px solid rgba(15,118,110,.16);border-color:var(--teal);}\n.export-action{border:1px solid #b7cfca;background:#fff;color:var(--teal);}\n.result-line{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:5px 0 11px;color:var(--muted);font-size:12px;}\n.result-line strong{color:var(--ink);font-weight:700;}\n.table-shell{border-top:1px solid var(--line-strong);}\n.table-head,.record-row{display:grid;grid-template-columns:minmax(260px,1.8fr) minmax(118px,.72fr) minmax(105px,.62fr) minmax(135px,.8fr) minmax(130px,.76fr) minmax(110px,.64fr);column-gap:16px;}\n.table-head{align-items:center;padding:13px 12px;background:#edf3f2;border-bottom:1px solid var(--line);color:#4b5b6f;font-size:10px;font-weight:800;letter-spacing:.085em;text-transform:uppercase;}\n.record-group{background:var(--paper);}\n.record-row{align-items:start;padding:18px 12px 15px;border-bottom:1px solid var(--line);}\n.record-cell{min-width:0;}\n.mobile-label{display:none;}\n.issue-category{margin-bottom:6px;color:#3f5268;font-size:11px;font-weight:700;}\n.issue-description{margin:0;color:#19283b;font-size:13px;line-height:1.5;font-weight:600;}\n.issue-location{margin:7px 0 0;color:#526174;font-size:12px;line-height:1.45;overflow-wrap:anywhere;}\n.date-value,.owner-value,.due-value{font:500 12px/1.55 'IBM Plex Mono',monospace;color:#25344a;}\n.date-value span,.due-value span{display:block;color:#617084;font:500 11px/1.45 'DM Sans',sans-serif;margin-top:2px;}\n.priority-value{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;line-height:1.4;}\n.priority-dot,.status-dot{display:inline-block;width:8px;height:8px;flex:0 0 8px;border-radius:50%;}\n.priority-dot.urgent{background:var(--urgent);}\n.priority-dot.normal{background:#66758a;}\n.priority-value.urgent{color:var(--urgent);}\n.priority-value.normal{color:#344358;}\n.status-select{display:block;width:100%;max-width:146px;height:35px;padding:0 27px 0 9px;border:1px solid #d1ddda;border-radius:6px;background:#fbfdfc;color:#12695f;font:700 12px 'DM Sans',sans-serif;}\n.status-select:focus{outline:3px solid rgba(15,118,110,.16);border-color:var(--teal);}\n.status-dot{margin-right:6px;background:#c1841c;vertical-align:middle;}\n.owner-value{font-family:'DM Sans',sans-serif;font-weight:600;overflow-wrap:anywhere;}\n.timeline-row{display:flex;align-items:center;gap:12px;padding:10px 12px 13px 26px;border-bottom:1px solid var(--line);background:#fbfcfc;color:#526174;font-size:11px;}\n.timeline-label{color:#344358;font-weight:700;white-space:nowrap;}\n.timeline-track{position:relative;display:flex;align-items:center;gap:9px;min-width:0;}\n.timeline-track:before{content:'';display:block;width:8px;height:8px;border:2px solid #fff;border-radius:50%;background:var(--teal);box-shadow:0 0 0 1px var(--teal);}\n.timeline-event{color:#344358;font-weight:700;}\n.timeline-time{font:500 11px 'IBM Plex Mono',monospace;color:#617084;}\n.history-note{margin-left:auto;color:#758294;font-size:11px;}\n.mobile-appbar{display:none;}\n@media(max-width:1080px){.app-shell{grid-template-columns:218px minmax(0,1fr)}.main{padding:30px 26px 56px}.table-head,.record-row{grid-template-columns:minmax(220px,1.7fr) minmax(100px,.7fr) minmax(94px,.62fr) minmax(122px,.82fr) minmax(108px,.74fr) minmax(92px,.62fr);column-gap:11px}.status-select{max-width:135px;font-size:11px}}\n@media(max-width:820px){.app-shell{display:block}.sidebar{display:none}.mobile-appbar{display:block;padding:15px 18px 0;background:var(--sidebar);color:white}.mobile-brand{display:flex;align-items:center;gap:10px;padding-bottom:13px;font:700 14px 'Manrope',sans-serif}.mobile-brand .brand-mark{width:32px;height:32px;font-size:16px}.mobile-brand .ti{width:17px;height:17px;font-size:17px;color:var(--teal)}.mobile-nav{display:flex;gap:5px;overflow-x:auto;padding:0 0 10px;scrollbar-width:thin}.mobile-nav a{display:inline-flex;align-items:center;gap:7px;min-height:39px;padding:0 11px;border-radius:7px;color:#d5dfed;text-decoration:none;font-size:12px;white-space:nowrap}.mobile-nav a.active{background:rgba(60,183,163,.18);color:#fff;font-weight:700}.mobile-nav .ti{width:15px;height:15px;font-size:15px;color:#adc0d7}.mobile-nav a.active .ti{color:#63d0bc}.main{padding:28px 22px 42px}.topline{padding-bottom:20px}.table-head,.record-row{grid-template-columns:minmax(190px,1.5fr) minmax(100px,.65fr) minmax(90px,.58fr) minmax(115px,.78fr) minmax(100px,.68fr) minmax(85px,.55fr);column-gap:9px}.filters{grid-template-columns:minmax(190px,1.4fr) minmax(140px,.9fr);}.export-action{min-height:42px}.table-scroll{overflow-x:auto;padding-bottom:3px}.table-shell{min-width:850px}.table-head,.record-row,.timeline-row{padding-left:10px;padding-right:10px}}\n@media(max-width:620px){.mobile-appbar{padding:13px 14px 0}.mobile-nav{margin-right:-14px;padding-right:14px}.main{padding:24px 16px 34px}.topline{align-items:flex-start;flex-direction:column;gap:16px}.page-heading h1{font-size:28px}.page-heading p{font-size:13px}.primary-action{min-height:42px}.filters{grid-template-columns:1fr 1fr;gap:11px 10px;padding:19px 0 14px}.field.search-field{grid-column:1/-1}.input,.select{height:44px}.export-action{grid-column:1/-1;width:100%;height:42px}.result-line{padding:5px 0 10px}.table-scroll{overflow:visible;padding:0}.table-shell{min-width:0;border-top:1px solid var(--line-strong)}.table-head{display:none}.record-row{grid-template-columns:1fr 1fr;gap:14px 12px;padding:16px 0 14px;column-gap:12px}.record-cell.issue{grid-column:1/-1}.record-cell.registered,.record-cell.priority{grid-column:auto}.record-cell.status,.record-cell.owner,.record-cell.due{grid-column:auto}.mobile-label{display:block;margin-bottom:5px;color:#657286;font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.issue-description{font-size:13px}.issue-location{font-size:12px}.status-select{max-width:100%;height:39px}.timeline-row{align-items:flex-start;flex-wrap:wrap;gap:8px;padding:11px 0 14px 3px}.timeline-track{width:100%;padding-left:2px}.history-note{width:100%;margin-left:19px}.date-value,.owner-value,.due-value{font-size:11px}.date-value span,.due-value span{font-size:11px}}\n</style>\n<div class=\"app-shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside aria-label=\"Navegação principal\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo and title container\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark container\">\n                <i aria-hidden=\"true\" class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1\" data-name=\"building community icon\" style=\"color:#0f766e;width:20px;height:20px;font-size:20px\">\n                </i>\n            </span>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name and caption container\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">\n                    Gestão Predial\n                </div>\n                <span class=\"brand-caption\" data-kid=\"1-1-1-2-2\" data-name=\"brand caption\">\n                    Central de ocorrências\n                </span>\n            </div>\n        </div>\n        <p class=\"nav-label\" data-kid=\"1-1-2\" data-name=\"navigation group label\">\n            Menu principal\n        </p>\n        <nav class=\"nav-list\" data-kid=\"1-1-3\" data-name=\"primary navigation list\">\n            <a class=\"nav-link\" data-kid=\"1-1-3-1\" data-name=\"overview navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-3-1-1\" data-name=\"dashboard icon\" style=\"color:#aebdd2;width:18px;height:18px;font-size:18px\">\n                </i>\n                Visão geral\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-2\" data-name=\"register navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-file-plus\" data-kid=\"1-1-3-2-1\" data-name=\"file plus icon\" style=\"color:#aebdd2;width:18px;height:18px;font-size:18px\">\n                </i>\n                Registrar\n            </a>\n            <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-3-3\" data-name=\"occurrences navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-details\" data-kid=\"1-1-3-3-1\" data-name=\"list details icon\" style=\"color:#63d0bc;width:18px;height:18px;font-size:18px\">\n                </i>\n                Ocorrências\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-4\" data-name=\"tasks navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-tool\" data-kid=\"1-1-3-4-1\" data-name=\"tool icon\" style=\"color:#aebdd2;width:18px;height:18px;font-size:18px\">\n                </i>\n                Tarefas\n            </a>\n        </nav>\n    </aside>\n    <header class=\"mobile-appbar\" data-kid=\"1-2\" data-name=\"mobile navigation header\">\n        <div class=\"mobile-brand\" data-kid=\"1-2-1\" data-name=\"mobile brand container\">\n            <span class=\"brand-mark\" data-kid=\"1-2-1-1\" data-name=\"mobile brand mark container\">\n                <i aria-hidden=\"true\" class=\"ti ti-building-community\" data-kid=\"1-2-1-1-1\" data-name=\"mobile brand building icon\" style=\"color:#0f766e;width:18px;height:18px;font-size:18px\">\n                </i>\n            </span>\n            Gestão Predial\n        </div>\n        <nav aria-label=\"Navegação principal\" class=\"mobile-nav\" data-kid=\"1-2-2\" data-name=\"mobile navigation list\">\n            <a data-kid=\"1-2-2-1\" data-name=\"mobile overview navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-2-2-1-1\" data-name=\"mobile dashboard icon\" style=\"color:#adc0d7;width:15px;height:15px;font-size:15px\">\n                </i>\n                Visão geral\n            </a>\n            <a data-kid=\"1-2-2-2\" data-name=\"mobile register navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-file-plus\" data-kid=\"1-2-2-2-1\" data-name=\"mobile file plus icon\" style=\"color:#adc0d7;width:15px;height:15px;font-size:15px\">\n                </i>\n                Registrar\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-2-2-3\" data-name=\"mobile occurrences navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-details\" data-kid=\"1-2-2-3-1\" data-name=\"mobile list details icon\" style=\"color:#63d0bc;width:15px;height:15px;font-size:15px\">\n                </i>\n                Ocorrências\n            </a>\n            <a data-kid=\"1-2-2-4\" data-name=\"mobile tasks navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-tool\" data-kid=\"1-2-2-4-1\" data-name=\"mobile tool icon\" style=\"color:#adc0d7;width:15px;height:15px;font-size:15px\">\n                </i>\n                Tarefas\n            </a>\n        </nav>\n    </header>\n    <main class=\"main\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <div class=\"main-inner\" data-kid=\"1-3-1\" data-name=\"main content layout wrapper\">\n            <div class=\"topline\" data-kid=\"1-3-1-1\" data-name=\"header top line section\">\n                <div class=\"page-heading\" data-kid=\"1-3-1-1-1\" data-name=\"page heading text container\">\n                    <h1 data-kid=\"1-3-1-1-1-1\" data-name=\"page title\">\n                        Histórico de ocorrências\n                    </h1>\n                    <p data-kid=\"1-3-1-1-1-2\" data-name=\"page description\">\n                        Consulte registros, responsáveis e andamento dos serviços.\n                    </p>\n                </div>\n                <button class=\"primary-action\" data-kid=\"1-3-1-1-2\" data-name=\"primary action button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-3-1-1-2-1\" data-name=\"plus icon\" style=\"color:#fff;width:16px;height:16px;font-size:16px\">\n                    </i>\n                    Nova ocorrência\n                </button>\n            </div>\n            <form aria-label=\"Filtros de ocorrências\" class=\"filters\" data-kid=\"1-3-1-2\" data-name=\"occurrence filter form\">\n                <div class=\"field search-field\" data-kid=\"1-3-1-2-1\" data-name=\"search input container\">\n                    <label data-kid=\"1-3-1-2-1-1\" data-name=\"search input label\" for=\"search\">\n                        Buscar por local ou descrição\n                    </label>\n                    <div class=\"input-wrap\" data-kid=\"1-3-1-2-1-2\" data-name=\"search input field wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-search\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"search icon\" style=\"color:#5b6b7f;width:17px;height:17px;font-size:17px\">\n                        </i>\n                        <input class=\"input\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"search input field\" id=\"search\" placeholder=\"Local ou descrição\" type=\"search\"/>\n                    </div>\n                </div>\n                <div class=\"field\" data-kid=\"1-3-1-2-2\" data-name=\"status select field container\">\n                    <label data-kid=\"1-3-1-2-2-1\" data-name=\"status select label\" for=\"status\">\n                        Andamento\n                    </label>\n                    <select class=\"select\" data-kid=\"1-3-1-2-2-2\" data-name=\"status select dropdown\" id=\"status\">\n                        <option data-kid=\"1-3-1-2-2-2-1\" data-name=\"status select default option\" selected=\"\">\n                            Todos os status\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-2\" data-name=\"status select option\">\n                            Abertas\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-3\" data-name=\"status select option\">\n                            Em triagem\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-4\" data-name=\"status select option\">\n                            Atribuídas\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-5\" data-name=\"status select option\">\n                            Em execução\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-6\" data-name=\"status select option\">\n                            Aguardando material\n                        </option>\n                        <option data-kid=\"1-3-1-2-2-2-7\" data-name=\"status select option\">\n                            Resolvidas\n                        </option>\n                    </select>\n                </div>\n                <div class=\"field\" data-kid=\"1-3-1-2-3\" data-name=\"sort select field container\">\n                    <label data-kid=\"1-3-1-2-3-1\" data-name=\"sort select label\" for=\"sort\">\n                        Ordenar por\n                    </label>\n                    <select class=\"select\" data-kid=\"1-3-1-2-3-2\" data-name=\"sort select dropdown\" id=\"sort\">\n                        <option data-kid=\"1-3-1-2-3-2-1\" data-name=\"sort select default option\" selected=\"\">\n                            Mais recentes\n                        </option>\n                        <option data-kid=\"1-3-1-2-3-2-2\" data-name=\"sort select option\">\n                            Maior prioridade\n                        </option>\n                        <option data-kid=\"1-3-1-2-3-2-3\" data-name=\"sort select option\">\n                            Prazo mais próximo\n                        </option>\n                    </select>\n                </div>\n                <button class=\"export-action\" data-kid=\"1-3-1-2-4\" data-name=\"export csv button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-3-1-2-4-1\" data-name=\"download icon\" style=\"color:#0f766e;width:16px;height:16px;font-size:16px\">\n                    </i>\n                    Exportar CSV\n                </button>\n            </form>\n            <div class=\"result-line\" data-kid=\"1-3-1-3\" data-name=\"search results count text\">\n                <span data-kid=\"1-3-1-3-1\" data-name=\"results count span\">\n                    <strong data-kid=\"1-3-1-3-1-1\" data-name=\"results count number\">\n                        2 ocorrências\n                    </strong>\n                    encontradas\n                </span>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"active sorting order text\">\n                    Ordenação: mais recentes\n                </span>\n            </div>\n            <section aria-label=\"Lista cronológica de ocorrências\" class=\"table-scroll\" data-kid=\"1-3-1-4\" data-name=\"occurrence list table wrapper\">\n                <div aria-label=\"Histórico de ocorrências\" class=\"table-shell\" data-kid=\"1-3-1-4-1\" data-name=\"occurrence data table\" role=\"table\">\n                    <div class=\"table-head\" data-kid=\"1-3-1-4-1-1\" data-name=\"table header row\" role=\"row\">\n                        <div data-kid=\"1-3-1-4-1-1-1\" data-name=\"occurrence header cell\" role=\"columnheader\">\n                            Ocorrência\n                        </div>\n                        <div data-kid=\"1-3-1-4-1-1-2\" data-name=\"registered header cell\" role=\"columnheader\">\n                            Registrada\n                        </div>\n                        <div data-kid=\"1-3-1-4-1-1-3\" data-name=\"priority header cell\" role=\"columnheader\">\n                            Prioridade\n                        </div>\n                        <div data-kid=\"1-3-1-4-1-1-4\" data-name=\"status header cell\" role=\"columnheader\">\n                            Andamento\n                        </div>\n                        <div data-kid=\"1-3-1-4-1-1-5\" data-name=\"responsible header cell\" role=\"columnheader\">\n                            Responsável\n                        </div>\n                        <div data-kid=\"1-3-1-4-1-1-6\" data-name=\"due date header cell\" role=\"columnheader\">\n                            Prazo\n                        </div>\n                    </div>\n                    <article aria-label=\"Ocorrência elétrica urgente\" class=\"record-group\" data-kid=\"1-3-1-4-1-2\" data-name=\"urgent occurrence row group\" role=\"rowgroup\">\n                        <div class=\"record-row\" data-kid=\"1-3-1-4-1-2-1\" data-name=\"urgent occurrence details row\" role=\"row\">\n                            <div class=\"record-cell issue\" data-kid=\"1-3-1-4-1-2-1-1\" data-name=\"issue description cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-3-1-4-1-2-1-1-1\" data-name=\"mobile occurrence label\">\n                                    Ocorrência\n                                </span>\n                                <div class=\"issue-category\" data-kid=\"1-3-1-4-1-2-1-1-2\" data-name=\"issue category text\">\n                                    Elétrica\n                                </div>\n                                <p class=\"issue-description\" data-kid=\"1-3-1-4-1-2-1-1-3\" data-name=\"issue description text\">\n                                    é necessário que tecnico eletricista se desloque para ver porque disjuntor do circuito 10 está desligando qundo morador liga o chuveiro\n                                </p>\n                                <p class=\"issue-location\" data-kid=\"1-3-1-4-1-2-1-1-4\" data-name=\"issue location text\">\n                                    casa da mae joana , numero 345, bairro cavalada, ararangua- SC\n                                </p>\n                            </div>\n                            <div class=\"record-cell registered\" data-kid=\"1-3-1-4-1-2-1-2\" data-name=\"registered date cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-3-1-4-1-2-1-2-1\" data-name=\"mobile registered label\">\n                                    Registrada\n                                </span>\n                                <div class=\"date-value\" data-kid=\"1-3-1-4-1-2-1-2-2\" data-name=\"date value text\">\n                                    18/09/2026\n                                    <span data-kid=\"1-3-1-4-1-2-1-2-2-1\" data-name=\"time value text\">\n                                        11:33:01\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"record-cell priority\" data-kid=\"1-3-1-4-1-2-1-3\" data-name=\"priority cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-3-1-4-1-2-1-3-1\" data-name=\"mobile priority label\">\n                                    Prioridade\n                                </span>\n                                <div class=\"priority-value urgent\" data-kid=\"1-3-1-4-1-2-1-3-2\" data-name=\"priority status value\">\n                                    <span class=\"priority-dot urgent\" data-kid=\"1-3-1-4-1-2-1-3-2-1\" data-name=\"urgent priority indicator dot\">\n                                    </span>\n                                    Urgente\n                                </div>\n                            </div>\n                            <div class=\"record-cell status\" data-kid=\"1-3-1-4-1-2-1-4\" data-name=\"status cell\" role=\"cell\">\n                                <span class=\"mobile-label\" data-kid=\"1-3-1-4-1-2-1-4-1\" data-name=\"mobile status label\">\n                                    Andamento\n                                </span>\n                                <label class=\"sr-only\" data-kid=\"1-3-1-4-1-2-1-4-2\" data-name=\"status selection hidden label\" for=\"status-urgent\">\n                                    Atualizar andamento da ocorrência elétrica\n                                </label>\n                            