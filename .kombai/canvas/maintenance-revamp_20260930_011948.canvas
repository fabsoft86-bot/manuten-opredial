      "html": "<main class=\"min-h-screen bg-[#f0fdfa] px-5 py-7 text-[#1e293b]\" data-kid=\"1\" data-name=\"page layout main container\" style=\"font-family:'Trebuchet MS','Segoe UI',sans-serif\">\n    <div class=\"mx-auto max-w-[1260px]\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n        <header class=\"mb-6 flex flex-wrap items-center justify-between gap-5\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div data-kid=\"1-1-1-1\" data-name=\"app title and description group\">\n                <h1 class=\"m-0 text-[30px] font-bold leading-tight tracking-[-0.03em] text-[#172554]\" data-kid=\"1-1-1-1-1\" data-name=\"app headline\">\n                    Central de Ocorrências\n                </h1>\n                <p class=\"mb-0 mt-1 text-[15px] text-[#64748b]\" data-kid=\"1-1-1-1-2\" data-name=\"app description\">\n                    Registro e acompanhamento da manutenção predial\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-end gap-2.5\" data-kid=\"1-1-1-2\" data-name=\"header controls container\">\n                <button class=\"min-h-[40px] rounded-lg border border-[#d5e2df] bg-white px-3.5 text-[13px] font-semibold text-[#334155]\" data-kid=\"1-1-1-2-1\" data-name=\"increase text size button\" type=\"button\">\n                    Aumentar texto\n                </button>\n                <button class=\"min-h-[40px] rounded-lg border border-[#d5e2df] bg-white px-3.5 text-[13px] font-semibold text-[#334155]\" data-kid=\"1-1-1-2-2\" data-name=\"toggle high contrast button\" type=\"button\">\n                    Alto contraste\n                </button>\n                <span class=\"ml-1 inline-flex min-h-[40px] items-center gap-2 rounded-full border border-[#bfe3d3] bg-white px-3.5 text-[13px] font-semibold text-[#16654d]\" data-kid=\"1-1-1-2-3\" data-name=\"sync status badge\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#059669]\" data-kid=\"1-1-1-2-3-1\" data-name=\"sync status indicator dot\">\n                    </span>\n                    Sincronizado\n                </span>\n            </div>\n        </header>\n        <nav aria-label=\"Navegação principal\" class=\"mb-7 flex flex-wrap gap-1 rounded-xl border border-[#cfe3df] bg-[#e5f2ef] p-1.5\" data-kid=\"1-1-2\" data-name=\"navigation menu\">\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#304259] no-underline\" data-kid=\"1-1-2-1\" data-name=\"navigation link overview\" href=\"#visao-geral\">\n                Visão geral\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg bg-[#0f766e] px-4 text-[14px] font-bold text-white no-underline shadow-[0_3px_9px_rgba(15,118,110,0.16)]\" data-kid=\"1-1-2-2\" data-name=\"navigation link register\" href=\"#registrar\">\n                Registrar\n            </a>\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#304259] no-underline\" data-kid=\"1-1-2-3\" data-name=\"navigation link occurrences\" href=\"#ocorrencias\">\n                Ocorrências\n            </a>\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#304259] no-underline\" data-kid=\"1-1-2-4\" data-name=\"navigation link tasks\" href=\"#tarefas\">\n                Tarefas\n            </a>\n        </nav>\n        <section class=\"mb-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-4\" data-kid=\"1-1-3\" data-name=\"section header container\">\n            <div data-kid=\"1-1-3-1\" data-name=\"section title group\">\n                <h2 class=\"m-0 text-[28px] font-bold tracking-[-0.025em] text-[#172554]\" data-kid=\"1-1-3-1-1\" data-name=\"section heading\">\n                    Registrar ocorrência\n                </h2>\n                <p class=\"mb-0 mt-1 text-[15px] text-[#536276]\" data-kid=\"1-1-3-1-2\" data-name=\"section description\">\n                    Descreva o que aconteceu para a equipe preparar o atendimento.\n                </p>\n            </div>\n            <div class=\"min-w-[290px] rounded-xl border border-[#cfe1dc] bg-white px-4 py-3\" data-kid=\"1-1-3-2\" data-name=\"form progress summary card\">\n                <div class=\"mb-2 flex items-center justify-between gap-3 text-[13px]\" data-kid=\"1-1-3-2-1\" data-name=\"progress header\">\n                    <span class=\"font-semibold text-[#26364b]\" data-kid=\"1-1-3-2-1-1\" data-name=\"required fields label\">\n                        Campos obrigatórios\n                    </span>\n                    <strong class=\"text-[#0f766e]\" data-kid=\"1-1-3-2-1-2\" data-name=\"progress completion count\">\n                        7 de 7 preenchidos\n                    </strong>\n                </div>\n                <div aria-label=\"Campos obrigatórios preenchidos\" aria-valuemax=\"7\" aria-valuemin=\"0\" aria-valuenow=\"7\" class=\"h-2 overflow-hidden rounded-full bg-[#e4efec]\" data-kid=\"1-1-3-2-2\" data-name=\"progress bar track\" role=\"progressbar\">\n                    <div class=\"h-full w-full rounded-full bg-[#0f766e]\" data-kid=\"1-1-3-2-2-1\" data-name=\"progress bar fill\">\n                    </div>\n                </div>\n            </div>\n        </section>\n        <form class=\"overflow-hidden rounded-2xl border border-[#d6e4e1] bg-white shadow-[0_12px_30px_rgba(15,118,110,0.06)]\" data-kid=\"1-1-4\" data-name=\"occurrence report form\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_330px]\" data-kid=\"1-1-4-1\" data-name=\"form layout grid\">\n                <div class=\"min-w-0 px-7 py-7\" data-kid=\"1-1-4-1-1\" data-name=\"form fields main column\">\n                    <section aria-labelledby=\"property-heading\" class=\"border-b border-[#e2ebe9] pb-6\" data-kid=\"1-1-4-1-1-1\" data-name=\"property location section\">\n                        <div class=\"mb-4 flex flex-wrap items-end justify-between gap-3\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"section title group\">\n                            <div data-kid=\"1-1-4-1-1-1-1-1\" data-name=\"section heading\">\n                                <h3 class=\"m-0 text-[20px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-1-1-1-1\" id=\"property-heading\">\n                                    Local do imóvel\n                                </h3>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-1-1-1-2\">\n                                    O local organiza os registros relacionados a este atendimento.\n                                </p>\n                            </div>\n                            <span class=\"rounded-full bg-[#e9f4f1] px-3 py-1.5 text-[12px] font-semibold text-[#175c50]\" data-kid=\"1-1-4-1-1-1-1-2\" data-name=\"section description\">\n                                Identificação em texto livre\n                            </span>\n                        </div>\n                        <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"identifier type tag\" for=\"property\">\n                            Imóvel / identificação\n                        </label>\n                        <input class=\"h-[52px] w-full rounded-lg border border-[#b9cdca] bg-white px-4 text-[15px] text-[#172554] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-1-4-1-1-1-3\" data-name=\"property input label\" id=\"property\" type=\"text\" value=\"Casa da Mae Joana, nº 345 · Cavalada, Araranguá–SC\"/>\n                        <div class=\"mt-3 flex flex-wrap items-center gap-2.5\" data-kid=\"1-1-4-1-1-1-4\" data-name=\"property search input\">\n                            <span class=\"mr-1 text-[13px] font-semibold text-[#64748b]\" data-kid=\"1-1-4-1-1-1-4-1\">\n                                Usado recentemente\n                            </span>\n                            <button class=\"min-h-[44px] max-w-full rounded-full border border-[#9bc9be] bg-[#eaf6f2] px-4 py-2 text-left text-[13px] font-semibold leading-5 text-[#145b4d]\" data-kid=\"1-1-4-1-1-1-4-2\" type=\"button\">\n                                Casa da Mae Joana, nº 345 · Cavalada, Araranguá–SC\n                            </button>\n                            <button class=\"min-h-[44px] rounded-full border border-[#cbdad7] bg-white px-4 py-2 text-[13px] font-semibold text-[#405268]\" data-kid=\"1-1-4-1-1-1-4-3\" type=\"button\">\n                                ☆ Favoritar local digitado\n                            </button>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"observation-heading\" class=\"border-b border-[#e2ebe9] py-6\" data-kid=\"1-1-4-1-1-2\" data-name=\"observation section\">\n                        <div class=\"mb-4\" data-kid=\"1-1-4-1-1-2-1\" data-name=\"section title group\">\n                            <h3 class=\"m-0 text-[20px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-2-1-1\" data-name=\"section heading\" id=\"observation-heading\">\n                                O que foi observado?\n                            </h3>\n                            <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-2-1-2\" data-name=\"section description\">\n                                Classifique o problema e indique a prioridade.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 gap-5 md:grid-cols-[0.8fr_1.4fr]\" data-kid=\"1-1-4-1-1-2-2\" data-name=\"observation input grid\">\n                            <div data-kid=\"1-1-4-1-1-2-2-1\" data-name=\"category input group\">\n                                <label class=\"mb-1.5 block text-[14px] fo