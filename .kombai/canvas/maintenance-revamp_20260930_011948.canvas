      },
      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#f4f8f8] text-[#1e293b]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;\">\n    <header class=\"border-b border-[#dbe4e6] bg-white\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-5 py-4 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <div class=\"grid h-11 w-11 place-items-center rounded-xl bg-[#172554] text-white text-2xl\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-building-community\" data-kid=\"1-1-1-1-1-1\" data-name=\"building community icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"application title text group\">\n                    <div class=\"text-[17px] font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-1-1-1-2-1\" data-name=\"application name title\">\n                        Central de Ocorrências\n                    </div>\n                    <div class=\"mt-0.5 text-sm text-slate-500\" data-kid=\"1-1-1-1-2-2\" data-name=\"application subtitle\">\n                        Manutenção predial\n                    </div>\n                </div>\n            </div>\n            <div class=\"inline-flex shrink-0 items-center gap-2 rounded-full border border-[#bbded3] bg-[#f1fbf6] px-3.5 py-2 text-sm font-semibold text-[#176948]\" data-kid=\"1-1-1-2\" data-name=\"synchronization status badge\">\n                <span class=\"h-2 w-2 rounded-full bg-[#059669]\" data-kid=\"1-1-1-2-1\" data-name=\"status indicator dot\">\n                </span>\n                Sincronizado\n            </div>\n        </div>\n    </header>\n    <div class=\"mx-auto max-w-[1240px] px-5 pt-5 sm:px-8\" data-kid=\"1-2\" data-name=\"navigation section\">\n        <nav aria-label=\"Navegação principal\" class=\"grid grid-cols-2 gap-1 rounded-2xl border border-[#d4e4e4] bg-[#eaf3f2] p-1.5 sm:grid-cols-4\" data-kid=\"1-2-1\" data-name=\"main navigation bar\">\n            <button class=\"min-h-12 rounded-xl px-3 py-3 text-sm font-semibold text-[#475569]\" data-kid=\"1-2-1-1\" data-name=\"navigation overview button\" type=\"button\">\n                Visão geral\n            </button>\n            <button aria-current=\"page\" class=\"min-h-12 rounded-xl bg-[#0f766e] px-3 py-3 text-sm font-bold text-white shadow-sm\" data-kid=\"1-2-1-2\" data-name=\"navigation register button\" type=\"button\">\n                Registrar\n            </button>\n            <button class=\"min-h-12 rounded-xl px-3 py-3 text-sm font-semibold text-[#475569]\" data-kid=\"1-2-1-3\" data-name=\"navigation occurrences button\" type=\"button\">\n                Ocorrências\n            </button>\n            <button class=\"min-h-12 rounded-xl px-3 py-3 text-sm font-semibold text-[#475569]\" data-kid=\"1-2-1-4\" data-name=\"navigation tasks button\" type=\"button\">\n                Tarefas\n            </button>\n        </nav>\n    </div>\n    <main class=\"mx-auto max-w-[1100px] px-5 pb-12 pt-8 sm:px-8 sm:pt-10\" data-kid=\"1-3\" data-name=\"main content area\">\n        <div class=\"mb-6 flex flex-col justify-between gap-5 sm:flex-row sm:items-end\" data-kid=\"1-3-1\" data-name=\"page header section\">\n            <div data-kid=\"1-3-1-1\" data-name=\"header title and description group\">\n                <h1 class=\"text-3xl font-bold tracking-[-0.035em] text-[#172554] sm:text-[36px]\" data-kid=\"1-3-1-1-1\" data-name=\"page main heading\">\n                    Registrar ocorrência\n                </h1>\n                <p class=\"mt-2 max-w-2xl text-base leading-6 text-slate-600\" data-kid=\"1-3-1-1-2\" data-name=\"page description text\">\n                    Registre o que aconteceu e encaminhe para a equipe responsável.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2 rounded-xl border border-[#ead7ad] bg-[#fff8e7] px-3 py-2.5 text-sm text-[#704f16] sm:self-auto\" data-kid=\"1-3-1-2\" data-name=\"draft reminder with discard action\">\n                <i aria-hidden=\"true\" class=\"ti ti-device-floppy text-lg text-[#9b6b16]\" data-kid=\"1-3-1-2-1\" data-name=\"floppy disk icon\">\n                </i>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"draft reminder text\">\n                    Rascunho salvo neste aparelho\n                </span>\n                <button class=\"min-h-10 rounded-lg border border-[#d8bf81] bg-white px-3 font-semibold text-[#704f16]\" data-kid=\"1-3-1-2-2\" data-name=\"discard saved draft button\" type=\"button\">\n                    Descartar\n                </button>\n            </div>\n        </div>\n        <form class=\"overflow-hidden rounded-2xl border border-[#d7e1e4] bg-white\" data-kid=\"1-3-2\" data-name=\"occurrence registration form\">\n            <div class=\"flex flex-col gap-3 border-b border-[#e1e8ea] bg-[#f8fbfb] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-7\" data-kid=\"1-3-2-1\" data-name=\"form completion status header\">\n                <div class=\"flex items-center gap-2.5 text-sm font-semibold text-[#172554]\" data-kid=\"1-3-2-1-1\" data-name=\"completion checkmark text\">\n                    <i aria-hidden=\"true\" class=\"ti ti-circle-check-filled text-lg text-[#0f766e]\" data-kid=\"1-3-2-1-1-1\" data-name=\"checkmark icon\">\n                    </i>\n                    Dados obrigatórios preenchidos\n                </div>\n                <div class=\"flex items-center gap-3 sm:w-[340px]\" data-kid=\"1-3-2-1-2\" data-name=\"progress bar group\">\n                    <div aria-label=\"Campos obrigatórios preenchidos\" aria-valuemax=\"7\" aria-valuemin=\"0\" aria-valuenow=\"7\" class=\"h-2.5 flex-1 overflow-hidden rounded-full bg-[#dce9e8]\" data-kid=\"1-3-2-1-2-1\" data-name=\"progress bar track\" role=\"progressbar\">\n                        <div class=\"h-full w-full rounded-full bg-[#0f766e]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"progress bar fill\">\n                        </div>\n                    </div>\n                    <span class=\"shrink-0 text-sm font-bold tabular-nums text-[#0f766e]\" data-kid=\"1-3-2-1-2-2\" data-name=\"progress percentage text\">\n                        7/7\n                    </span>\n                </div>\n            </div>\n            <section aria-labelledby=\"observed-title\" class=\"px-5 py-7 sm:px-7 sm:py-8\" data-kid=\"1-3-2-2\" data-name=\"observed issue section\">\n                <div class=\"mb-6 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-3-2-2-1\" data-name=\"observed section header\">\n                    <div data-kid=\"1-3-2-2-1-1\" data-name=\"observed section title group\">\n                        <h2 class=\"text-xl font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"observed title\" id=\"observed-title\">\n                            O que foi visto\n                        </h2>\n                        <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"observed description\">\n                            Comece pelo local e descreva o problema observado.\n                        </p>\n                    </div>\n                    <p class=\"text-sm text-slate-500\" data-kid=\"1-3-2-2-1-2\" data-name=\"mandatory field notice\">\n                        <span class=\"font-semibold text-[#172554]\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"mandatory field asterisk\">\n                            *\n                        </span>\n                        Campo obrigatório\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-1 gap-x-6 gap-y-5 lg:grid-cols-2\" data-kid=\"1-3-2-2-2\" data-name=\"observed inputs container\">\n                    <div class=\"lg:col-span-2\" data-kid=\"1-3-2-2-2-1\" data-name=\"property selection group\">\n                        <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"property label group\">\n                            <label class=\"text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"property label text\" for=\"property\">\n                                Local / imóvel\n                                <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-2-1-1-1-1\" data-name=\"property label asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <button class=\"inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-semibold text-[#0f766e]\" data-kid=\"1-3-2-2-2-1-1-2\" data-name=\"favorite property button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-star text-base\" data-kid=\"1-3-2-2-2-1-1-2-1\" data-name=\"star icon\">\n                                </i>\n                                Favoritar local\n                            </button>\n                        </div>\n                        <div class=\"flex min-h-12 items-center gap-3 rounded-xl border border-[#bacbd0] bg-white px-4 ring-2 ring-transparent focus-within:border-[#0f766e] focus-within:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"property search field\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin text-xl text-[#64748b]\" data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"map pin icon\">\n                            </i>\n                            <input aria-label=\"Local / imóvel\" class=\"min-w-0 flex-1 border-0 bg-transparent py-3 text-[15px] font-medium text-[#1e293b] outline-hidden\" data-kid=\"1-3-2-2-2-1-2-2\" data-name=\"property search input\" id=\"property\" type=\"text\" value=\"Casa da Mãe Joana · nº 345\"/>\n                        </div>\n                        <div class=\"mt-2 flex flex-wrap items-center gap-2 text-sm text-slate-600\" data-kid=\"1-3-2-2-2-1-3\" data-name=\"recent properties list\">\n                            <span data-kid=\"1-3-2-2-2-1-3-1\" data-name=\"recent properties label\">\n                                Usado recentemente:\n                            </span>\n                            <button class=\"min-h-9 rounded-full border border-[#d6e3e4] bg-[#f7faf9] px-3 text-sm font-medium text-[#334155]\" data-kid=\"1-3-2-2-2-1-3-2\" data-name=\"recent property selection button\" type=\"button\">\n                                Casa da Mãe Joana\n                            </button>\n                            <span class=\"text-slate-500\" data-kid=\"1-3-2-2-2-1-3-3\" data-name=\"recent property address\">\n                                Cavalada · Araranguá — SC\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-3-2-2-2-2\" data-name=\"category selection group\">\n                        <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"category label\" for=\"category\">\n                            Categoria\n                            <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"category asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"category select container\">\n                            <select class=\"min-h-12 w-full appearance-none rounded-xl border border-[#bacbd0] bg-white px-4 pr-11 text-[15px] font-medium text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"category select input\" id=\"category\">\n                                <option data-kid=\"1-3-2-2-2-2-2-1-1\" selected=\"\">\n                                    Elétrica\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-2\">\n                                    Hidráulica\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-3\">\n                                    Civil\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-4\">\n                                    Climatização\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-5\">\n                                    Segurança\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-6\">\n                                    Limpeza\n                                </option>\n                                <option data-kid=\"1-3-2-2-2-2-2-1-7\">\n                                    Outra\n                                </option>\n                            </select>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-lg text-slate-500\" data-kid=\"1-3-2-2-2-2-2-2\" data-name=\"chevron down icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-3-2-2-2-3\" data-name=\"priority selection group\">\n                        <span class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"priority label\">\n                            Prioridade\n                            <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-2-3-1-1\" data-name=\"priority asterisk\">\n                                *\n                            </span>\n                        </span>\n                        <div aria-label=\"Escolha a prioridade\" class=\"grid grid-cols-3 gap-2\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"priority options radiogroup\" role=\"radiogroup\">\n                            <button aria-checked=\"false\" class=\"flex min-h-[54px] items-center justify-center gap-2 rounded-xl border border-[#d2dcdf] bg-white px-2 text-sm font-semibold text-slate-600\" data-kid=\"1-3-2-2-2-3-2-1\" data-name=\"normal priority button\" role=\"radio\" type=\"button\">\n                                <span class=\"h-2.5 w-2.5 rounded-full bg-[#059669]\" data-kid=\"1-3-2-2-2-3-2-1-1\" data-name=\"normal priority indicator\">\n                                </span>\n                                Normal\n                            </button>\n                            <button aria-checked=\"false\" class=\"flex min-h-[54px] items-center justify-center gap-2 rounded-xl border border-[#d2dcdf] bg-white px-2 text-sm font-semibold text-slate-600\" data-kid=\"1-3-2-2-2-3-2-2\" data-name=\"attention priority button\" role=\"radio\" type=\"button\">\n                                <span class=\"h-2.5 w-2.5 rounded-full bg-[#d97706]\" data-kid=\"1-3-2-2-2-3-2-2-1\" data-name=\"attention priority indicator\">\n                                </span>\n                                Atenção\n                            </button>\n                            <button aria-checked=\"true\" class=\"flex min-h-[54px] items-center justify-center gap-1.5 rounded-xl border-2 border-[#b42318] bg-[#fff4f2] px-2 text-sm font-bold text-[#8f1d16]\" data-kid=\"1-3-2-2-2-3-2-3\" data-name=\"urgent priority button\" role=\"radio\" type=\"button\">\n                                <span class=\"h-2.5 w-2.5 rounded-full bg-[#b42318]\" data-kid=\"1-3-2-2-2-3-2-3-1\" data-name=\"urgent priority indicator\">\n                                </span>\n                                Urgente\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"lg:col-span-2\" data-kid=\"1-3-2-2-2-4\" data-name=\"electrical safety warning box\">\n                        <div class=\"flex items-start gap-3 rounded-xl border border-[#e9c8a5] bg-[#fff8ef] px-4 py-3.5 text-[#633b12]\" data-kid=\"1-3-2-2-2-4-1\" data-name=\"warning content wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-alert-triangle-filled mt-0.5 shrink-0 text-xl text-[#a65300]\" data-kid=\"1-3-2-2-2-4-1-1\" data-name=\"warning alert icon\">\n                            </i>\n                            <div data-kid=\"1-3-2-2-2-4-1-2\" data-name=\"warning message group\">\n                                <p class=\"text-sm font-bold\" data-kid=\"1-3-2-2-2-4-1-2-1\" data-name=\"warning title\">\n                                    Atenção: segurança elétrica\n                                </p>\n                                <p class=\"mt-1 text-sm leading-5\" data-kid=\"1-3-2-2-2-4-1-2-2\" data-name=\"warning description\">\n                                    Se houver cheiro de queimado ou faísca, mantenha o disjuntor desligado e acione um eletricista.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-7 border-t border-[#e3e9eb] pt-6\" data-kid=\"1-3-2-2-3\" data-name=\"problem details section\">\n                    <h3 class=\"mb-4 text-base font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-1\" data-name=\"details section title\">\n                        Detalhes do problema\n                    </h3>\n                    <div class=\"grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2\" data-kid=\"1-3-2-2-3-2\" data-name=\"details inputs grid\">\n                        <div data-kid=\"1-3-2-2-3-2-1\" data-name=\"location detail group\">\n                            <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-2-1-1\" data-name=\"location label\" for=\"environment\">\n                                Onde exatamente?\n                                <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-3-2-1-1-1\" data-name=\"location label asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-3-2-1-2\" data-name=\"location select wrapper\">\n                                <select class=\"min-h-12 w-full appearance-none rounded-xl border border-[#bacbd0] bg-white px-4 pr-11 text-[15px] text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-3-2-1-2-1\" data-name=\"location select input\" id=\"environment\">\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-1\">\n                                        Quarto\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-2\" selected=\"\">\n                                        Banheiro\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-3\">\n                                        Sala\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-4\">\n                                        Cozinha\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-5\">\n                                        Área externa\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-1-2-1-6\">\n                                        Quadro de energia\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-lg text-slate-500\" data-kid=\"1-3-2-2-3-2-1-2-2\" data-name=\"location chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-2-2\" data-name=\"item detail group\">\n                            <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-2-2-1\" data-name=\"item label\" for=\"element\">\n                                Qual item?\n                                <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-3-2-2-1-1\" data-name=\"item label asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-3-2-2-2\" data-name=\"item select wrapper\">\n                                <select class=\"min-h-12 w-full appearance-none rounded-xl border border-[#bacbd0] bg-white px-4 pr-11 text-[15px] text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-3-2-2-2-1\" data-name=\"item select input\" id=\"element\">\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-1\">\n                                        Lâmpada\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-2\">\n                                        Tomada\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-3\">\n                                        Interruptor\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-4\" selected=\"\">\n                                        Disjuntor\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-5\">\n                                        Chuveiro\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-2-2-1-6\">\n                                        Fiação\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-lg text-slate-500\" data-kid=\"1-3-2-2-3-2-2-2-2\" data-name=\"item chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-2-3\" data-name=\"situation detail group\">\n                            <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-2-3-1\" data-name=\"situation label\" for=\"situation\">\n                                O que aconteceu?\n                                <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-3-2-3-1-1\" data-name=\"situation label asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-3-2-3-2\" data-name=\"situation select wrapper\">\n                                <select class=\"min-h-12 w-full appearance-none rounded-xl border border-[#bacbd0] bg-white px-4 pr-11 text-[15px] text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-3-2-3-2-1\" data-name=\"situation select input\" id=\"situation\">\n                                    <option data-kid=\"1-3-2-2-3-2-3-2-1-1\">\n                                        Queimado ou não acende\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-3-2-1-2\">\n                                        Faz barulho ou estala\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-3-2-1-3\" selected=\"\">\n                                        Está desligando sozinho\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-3-2-1-4\">\n                                        Está aquecendo\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-3-2-1-5\">\n                                        Está solto ou quebrado\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-lg text-slate-500\" data-kid=\"1-3-2-2-3-2-3-2-2\" data-name=\"situation chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <div data-kid=\"1-3-2-2-3-2-4\" data-name=\"action detail group\">\n                            <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-2-4-1\" data-name=\"action label\" for=\"action\">\n                                O que precisa ser feito?\n                                <span class=\"text-[#b42318]\" data-kid=\"1-3-2-2-3-2-4-1-1\" data-name=\"action label asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-3-2-4-2\" data-name=\"action select wrapper\">\n                                <select class=\"min-h-12 w-full appearance-none rounded-xl border border-[#bacbd0] bg-white px-4 pr-11 text-[15px] text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-2-3-2-4-2-1\" data-name=\"action select input\" id=\"action\">\n                                    <option data-kid=\"1-3-2-2-3-2-4-2-1-1\">\n                                        Acionar eletricista para trocar\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-4-2-1-2\">\n                                        Acionar eletricista para verificar\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-4-2-1-3\" selected=\"\">\n                                        Manter desligado e acionar eletricista\n                                    </option>\n                                    <option data-kid=\"1-3-2-2-3-2-4-2-1-4\">\n                                        Solicitar vistoria de segurança\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-lg text-slate-500\" data-kid=\"1-3-2-2-3-2-4-2-2\" data-name=\"action chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <fieldset class=\"mt-6\" data-kid=\"1-3-2-2-3-3\" data-name=\"confirmation fieldset\">\n                        <legend class=\"mb-2 text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-2-3-3-1\" data-name=\"confirmation legend\">\n                            Antes de enviar, se conseguir, confirme\n                        </legend>\n                        <div class=\"grid grid-cols-1 gap-2 sm:grid-cols-2\" data-kid=\"1-3-2-2-3-3-2\" data-name=\"confirmation options grid\">\n                            <label class=\"flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-2 text-sm text-[#334155] hover:bg-[#f6faf9]\" data-kid=\"1-3-2-2-3-3-2-1\" data-name=\"confirmation checkbox one\">\n                                <input class=\"h-5 w-5 rounded border-slate-400 accent-[#0f766e]\" data-kid=\"1-3-2-2-3-3-2-1-1\" data-name=\"confirmation checkbox one input\" type=\"checkbox\"/>\n                                Verificar se o disjuntor está ligado\n                            </label>\n                            <label class=\"flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-2 text-sm text-[#334155] hover:bg-[#f6faf9]\" data-kid=\"1-3-2-2-3-3-2-2\" data-name=\"confirmation checkbox two\">\n                                <input class=\"h-5 w-5 rounded border-slate-400 accent-[#0f766e]\" data-kid=\"1-3-2-2-3-3-2-2-1\" data-name=\"confirmation checkbox two input\" type=\"checkbox\"/>\n                                Testar outra tomada ou interruptor\n                            </label>\n                        </div>\n                        <label class=\"flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-2 text-sm text-[#334155] hover:bg-[#f6faf9]\" data-kid=\"1-3-2-2-3-3-2-3\" data-name=\"electrical safety checklist option\">\n                            <input class=\"h-5 w-5 rounded border-slate-400 accent-[#0f766e]\" data-kid=\"1-3-2-2-3-3-2-3-1\" data-name=\"electrical safety checkbox\" type=\"checkbox\"/>\n                            Manter desligado se houver cheiro de queimado ou faísca\n                        </label>\n                    </fieldset>\n                </div>\n            </section>\n            <section aria-labelledby=\"handoff-title\" class=\"border-t border-[#dfe7e9] bg-[#fbfdfd] px-5 py-7 sm:px-7 sm:py-8\" data-kid=\"1-3-2-3\" data-name=\"handoff section\">\n                <div class=\"mb-6\" data-kid=\"1-3-2-3-1\" data-name=\"handoff header\">\n                    <h2 class=\"text-xl font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-3-2-3-1-1\" data-name=\"handoff title\" id=\"handoff-title\">\n                        Para quem e até quando\n                    </h2>\n                    <p class=\"mt-1 text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-3-1-2\" data-name=\"handoff description\">\n                        Defina a equipe e o prazo. O relatório será preparado com as informações acima.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2\" data-kid=\"1-3-2-3-2\" data-name=\"handoff inputs grid\">\n                    <div data-kid=\"1-3-2-3-2-1\" data-name=\"responsible party group\">\n                        <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"responsible label\" for=\"responsible\">\n                            Responsável\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"responsible input wrapper\">\n                            <input class=\"min-h-12 w-full rounded-xl border border-[#bacbd0] bg-white px-4 pl-11 text-[15px] font-medium text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"responsible input field\" id=\"responsible\" type=\"text\" value=\"Eletricista\"/>\n                            <i aria-hidden=\"true\" class=\"ti ti-user-cog absolute left-4 top-1/2 -translate-y-1/2 text-xl text-slate-500\" data-kid=\"1-3-2-3-2-1-2-2\" data-name=\"responsible user icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-1.5 text-sm text-slate-600\" data-kid=\"1-3-2-3-2-1-3\" data-name=\"responsible help text\">\n                            Sugestão para a categoria Elétrica.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-2-3-2-2\" data-name=\"deadline group\">\n                        <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-2-1\" data-name=\"deadline label\" for=\"deadline\">\n                            Prazo desejado\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-3-2-3-2-2-2\" data-name=\"deadline input wrapper\">\n                            <input class=\"min-h-12 w-full rounded-xl border border-[#bacbd0] bg-white px-4 pl-11 text-[15px] text-[#1e293b] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-3-2-2-2-1\" data-name=\"deadline input field\" id=\"deadline\" type=\"date\" value=\"2026-12-09\"/>\n                            <i aria-hidden=\"true\" class=\"ti ti-calendar-event absolute left-4 top-1/2 -translate-y-1/2 text-xl text-slate-500\" data-kid=\"1-3-2-3-2-2-2-2\" data-name=\"calendar icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"sm:col-span-2\" data-kid=\"1-3-2-3-2-3\" data-name=\"report group\">\n                        <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-3-2-3-2-3-1\" data-name=\"report label group\">\n                            <label class=\"text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-3-1-1\" data-name=\"report label text\" for=\"report\">\n                                Relatório preparado para a equipe\n                            </label>\n                            <span class=\"inline-flex items-center gap-1.5 text-sm font-medium text-[#176948]\" data-kid=\"1-3-2-3-2-3-1-2\" data-name=\"report generated indicator\">\n                                <i aria-hidden=\"true\" class=\"ti ti-sparkles text-base\" data-kid=\"1-3-2-3-2-3-1-2-1\" data-name=\"sparkles icon\">\n                                </i>\n                                Gerado pelas respostas\n                            </span>\n                        </div>\n                        <div class=\"rounded-xl border border-[#d3e1e3] bg-white px-4 py-3.5\" data-kid=\"1-3-2-3-2-3-2\" data-name=\"report textarea wrapper\">\n                            <textarea class=\"w-full resize-none border-0 bg-transparent p-0 text-[15px] leading-6 text-[#334155] outline-hidden\" data-kid=\"1-3-2-3-2-3-2-1\" data-name=\"report output textarea\" id=\"report\" readonly=\"\" rows=\"3\">No local Casa da Mãe Joana, o disjuntor do circuito 10 está desligando quando o chuveiro é ligado. Manter o disjuntor desligado e acionar um eletricista para verificar.</textarea>\n                        </div>\n                    </div>\n                    <div class=\"sm:col-span-2\" data-kid=\"1-3-2-3-2-4\" data-name=\"observation group\">\n                        <label class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-4-1\" data-name=\"observation label\" for=\"extra\">\n                            Observação adicional\n                            <span class=\"font-normal text-slate-500\" data-kid=\"1-3-2-3-2-4-1-1\" data-name=\"observation label helper\">\n                                (opcional)\n                            </span>\n                        </label>\n                        <textarea class=\"min-h-[86px] w-full rounded-xl border border-[#bacbd0] bg-white px-4 py-3 text-[15px] leading-6 text-[#1e293b] outline-none placeholder:text-slate-500 focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-3-2-3-2-4-2\" data-name=\"observation textarea\" id=\"extra\" placeholder=\"Acrescente um detalhe que não apareceu nas opções.\" rows=\"2\"></textarea>\n                    </div>\n                    <div class=\"sm:col-span-2\" data-kid=\"1-3-2-3-2-5\" data-name=\"photos group\">\n                        <span class=\"mb-2 block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-5-1\" data-name=\"photos label\">\n                            Fotos da ocorrência\n                            <span class=\"font-normal text-slate-500\" data-kid=\"1-3-2-3-2-5-1-1\" data-name=\"photos label helper\">\n                                (opcional)\n                            </span>\n                        </span>\n                        <label class=\"flex min-h-[76px] cursor-pointer items-center gap-4 rounded-xl border border-dashed border-[#9fb8bd] bg-white px-4 py-4 hover:border-[#0f766e] hover:bg-[#f7fbfa]\" data-kid=\"1-3-2-3-2-5-2\" data-name=\"file upload zone\">\n                            <span class=\"grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#e5f3f1] text-2xl text-[#0f766e]\" data-kid=\"1-3-2-3-2-5-2-1\" data-name=\"upload icon container\">\n                                <i aria-hidden=\"true\" class=\"ti ti-camera-plus\" data-kid=\"1-3-2-3-2-5-2-1-1\" data-name=\"camera plus icon\">\n                                </i>\n                            </span>\n                            <span class=\"flex-1\" data-kid=\"1-3-2-3-2-5-2-2\" data-name=\"upload text group\">\n                                <span class=\"block text-sm font-bold text-[#172554]\" data-kid=\"1-3-2-3-2-5-2-2-1\" data-name=\"upload main title\">\n                                    Adicionar fotos\n                                </span>\n                                <span class=\"mt-1 block text-sm leading-5 text-slate-600\" data-kid=\"1-3-2-3-2-5-2-2-2\" data-name=\"upload helper text\">\n                                    Até 3 imagens · máximo de 1 MB cada\n                                </span>\n                            </span>\n                            <span class=\"hidden min-h-10 items-center rounded-lg border border-[#c5d7d9] px-3 text-sm font-semibold text-[#172554] sm:inline-flex\" data-kid=\"1-3-2-3-2-5-2-3\" data-name=\"desktop file button\">\n                                Escolher arquivos\n                            </span>\n                            <input accept=\"image/*\" aria-label=\"Adicionar fotos da ocorrência\" class=\"sr-only\" data-kid=\"1-3-2-3-2-5-2-4\" data-name=\"file upload input\" multiple=\"\" type=\"file\"/>\n                        </label>\n                    </div>\n                </div>\n            </section>\n            <footer class=\"flex flex-col gap-4 border-t border-[#dfe7e9] bg-white px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7\" data-kid=\"1-3-2-4\" data-name=\"form footer\">\n                <p class=\"flex items-center gap-2 text-sm text-slate-600\" data-kid=\"1-3-2-4-1\" data-name=\"footer draft status\">\n                    <i aria-hidden=\"true\" class=\"ti ti-device-floppy text-lg text-[#0f766e]\" data-kid=\"1-3-2-4-1-1\" data-name=\"footer floppy icon\">\n                    </i>\n                    Rascunho salvo neste aparelho\n                </p>\n                <button class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#0f766e] px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-[#0b625c] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f766e]\" data-kid=\"1-3-2-4-2\" data-name=\"submit registration button\" type=\"submit\">\n                    <i aria-hidden=\"true\" class=\"ti ti-send-2 text-lg\" data-kid=\"1-3-2-4-2-1\" data-name=\"send icon\">\n                    </i>\n                    Registrar ocorrência\n                </button>\n            </footer>\n        </form>\n        <p class=\"mt-4 text-center text-sm text-slate-500\" data-kid=\"1-3-3\" data-name=\"page bottom disclaimer\">\n            As informações serão usadas para organizar o atendimento desta ocorrência.\n        </p>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-09-30T01:31:50.562579+00:00",
      "modified": "2026-09-30T01:34:25.354828+00:00",
