        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root {\n  --navy: #172554;\n  --teal: #0f766e;\n  --teal-dark: #115e59;\n  --teal-soft: #e9f5f2;\n  --paper: #f4f8f7;\n  --white: #ffffff;\n  --ink: #182b3d;\n  --muted: #586c7d;\n  --muted-light: #758694;\n  --line: #dce6e5;\n  --line-dark: #c8d6d5;\n  --red: #bd3834;\n  --red-soft: #fff1ef;\n  --amber: #956015;\n  --amber-soft: #fff7e9;\n  --green: #187454;\n  --green-soft: #eaf5ef;\n}\n  body {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--paper);\n  color: var(--ink);\n  font-family: 'DM Sans', 'Trebuchet MS', sans-serif;\n}\nbutton, input, select { font: inherit; }\nbutton, select { cursor: pointer; }\nbutton:focus-visible, select:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid #70b9ae; outline-offset: 3px; }\n.icon { display: inline-flex; align-items: center; justify-content: center; width: 1.1em; height: 1.1em; color: currentColor; line-height: 1; }\n.nav-item { transition: background-color .15s ease, color .15s ease; }\n.brand-copy + div { display: none; }\n.table-row { display: grid; }\n.table-row:last-child { border-bottom: 0; }\n@media (min-width: 761px) {\n  .table-row { grid-template-columns: minmax(0, 1.65fr) minmax(115px, .7fr) minmax(145px, .8fr) minmax(135px, .8fr) minmax(145px, .85fr); }\n}\n@media (max-width: 760px) {\n  .desktop-meta { display: none !important; }\n  .mobile-meta { display: flex !important; }\n  .brand-copy { display: none; }\n  .content-wrap { padding-left: 16px !important; padding-right: 16px !important; }\n  .nav-scroll { overflow-x: auto; scrollbar-width: none; }\n  .nav-scroll::-webkit-scrollbar { display: none; }\n  .filter-grid { grid-template-columns: 1fr !important; }\n  .toolbar-actions { display: grid !important; grid-template-columns: 1fr 1fr; }\n  .record-head { align-items: flex-start !important; }\n  .table-row { grid-template-columns: 1fr !important; gap: 13px !important; padding: 18px 0 !important; }\n  .record-fields { grid-template-columns: 1fr 1fr !important; }\n  .priority-status { display: flex; gap: 16px !important; }\n  .address-line { overflow-wrap: anywhere; }\n}\n</style>\n<div class=\"min-h-screen bg-[var(--paper)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[var(--line)] bg-[var(--white)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"content-wrap mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-8 py-5\" data-kid=\"1-1-1\" data-name=\"top header content container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"branding and identification group\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--navy)] text-xl text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-building-community\" data-kid=\"1-1-1-1-1-1\" data-name=\"community building icon\">\n                    </i>\n                </div>\n                <div class=\"brand-copy min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand name copy\">\n                    <div class=\"text-[11px] font-bold uppercase tracking-[0.13em] text-[var(--teal)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand category label\">\n                        Manutenção predial\n                    </div>\n                    <div class=\"mt-0.5 text-[17px] font-semibold tracking-[-0.02em] text-[var(--navy)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand main title\">\n                        Central de ocorrências\n                    </div>\n                </div>\n                <div class=\"hidden min-w-0 md:block\" data-kid=\"1-1-1-1-3\" data-name=\"brand desktop title container\">\n                    <div class=\"text-[20px] font-semibold tracking-[-0.035em] text-[var(--navy)]\" data-kid=\"1-1-1-1-3-1\" data-name=\"brand main title\">\n                        Central de ocorrências\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-4\" data-kid=\"1-1-1-2\" data-name=\"header action group\">\n                <div class=\"flex items-center gap-2 rounded-full border border-[#cde4db] bg-[#f2faf5] px-3 py-2 text-[13px] font-medium text-[var(--green)]\" data-kid=\"1-1-1-2-1\" data-name=\"system status badge\">\n                    <span class=\"h-2 w-2 rounded-full bg-[var(--green)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status indicator dot\">\n                    </span>\n                    Sincronizado\n                </div>\n                <button class=\"flex items-center gap-2 rounded-lg bg-[var(--teal)] px-4 py-3 text-[14px] font-semibold text-white shadow-sm hover:bg-[var(--teal-dark)]\" data-kid=\"1-1-1-2-2\" data-name=\"register occurrence button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-plus text-base\" data-kid=\"1-1-1-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Registrar ocorrência\n                </button>\n            </div>\n        </div>\n        <div class=\"nav-scroll border-t border-[var(--line)] bg-white\" data-kid=\"1-1-2\" data-name=\"main navigation scroll container\">\n            <nav aria-label=\"Navegação principal\" class=\"content-wrap mx-auto flex max-w-[1280px] gap-1 px-8 py-2\" data-kid=\"1-1-2-1\" data-name=\"main navigation menu\">\n                <a class=\"nav-item flex shrink-0 items-center gap-2 rounded-lg px-4 py-2.5 text-[14px] font-semibold text-[var(--muted)] no-underline hover:bg-[var(--paper)]\" data-kid=\"1-1-2-1-1\" data-name=\"navigation link dashboard\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    Visão geral\n                </a>\n                <a class=\"nav-item flex shrink-0 items-center gap-2 rounded-lg px-4 py-2.5 text-[14px] font-semibold text-[var(--muted)] no-underline hover:bg-[var(--paper)]\" data-kid=\"1-1-2-1-2\" data-name=\"navigation link register\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-clipboard-plus text-[17px]\" data-kid=\"1-1-2-1-2-1\" data-name=\"register icon\">\n                    </i>\n                    Registrar\n                </a>\n                <a aria-current=\"page\" class=\"nav-item flex shrink-0 items-center gap-2 rounded-lg bg-[var(--teal-soft)] px-4 py-2.5 text-[14px] font-bold text-[var(--teal-dark)] no-underline\" data-kid=\"1-1-2-1-3\" data-name=\"navigation link occurrences\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-list-check text-[17px]\" data-kid=\"1-1-2-1-3-1\" data-name=\"occurrences icon\">\n                    </i>\n                    Ocorrências\n                    <span class=\"ml-1 rounded-md bg-white px-2 py-0.5 text-[11px] font-bold text-[var(--teal-dark)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3-2\" data-name=\"occurrences count badge\" data-reason=\"count updated by script\">\n                        2\n                    </span>\n                </a>\n                <a class=\"nav-item flex shrink-0 items-center gap-2 rounded-lg px-4 py-2.5 text-[14px] font-semibold text-[var(--muted)] no-underline hover:bg-[var(--paper)]\" data-kid=\"1-1-2-1-4\" data-name=\"navigation link tasks\" href=\"#\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-tool text-[17px]\" data-kid=\"1-1-2-1-4-1\" data-name=\"tasks icon\">\n                    </i>\n                    Tarefas\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"content-wrap mx-auto max-w-[1280px] px-8 pb-12 pt-9\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex items-end justify-between gap-5\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and description\">\n                <p class=\"mb-2 text-[13px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-1-1-1\" data-name=\"page breadcrumb label\">\n                    Consulta de registros\n                </p>\n                <h1 class=\"m-0 text-[32px] font-semibold leading-tight tracking-[-0.04em] text-[var(--navy)]\" data-kid=\"1-2-1-1-2\" data-name=\"page main title\">\n                    Histórico de ocorrências\n                </h1>\n                <p class=\"mb-0 mt-2 text-[15px] text-[var(--muted)]\" data-kid=\"1-2-1-1-3\" data-name=\"page description\">\n                    Acompanhe o andamento e consulte o que foi registrado em cada local.\n                </p>\n            </div>\n            <div class=\"desktop-meta flex shrink-0 items-center gap-2 pb-1 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-1-2\" data-name=\"page date metadata\">\n                <i aria-hidden=\"true\" class=\"icon ti ti-calendar-event text-[17px]\" data-kid=\"1-2-1-2-1\" data-name=\"calendar icon\">\n                </i>\n                29 de setembro de 2026\n            </div>\n        </div>\n        <section aria-label=\"Resumo de ocorrências\" class=\"mb-7\" data-kid=\"1-2-2\" data-name=\"occurrences summary section\">\n            <div class=\"flex flex-wrap items-center gap-x-8 gap-y-3 border-y border-[var(--line)] py-4\" data-kid=\"1-2-2-1\" data-name=\"summary statistics container\">\n                <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-1-1\" data-name=\"total records summary\">\n                    <strong class=\"text-[25px] font-semibold leading-none tracking-[-0.04em] text-[var(--navy)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1\" data-name=\"total records count\" data-reason=\"count updated by script\">\n                        2\n                    </strong>\n                    <span class=\"text-[14px] text-[var(--muted)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"total records label\">\n                        registros neste local\n                    </span>\n                </div>\n                <span class=\"hidden h-5 w-px bg-[var(--line-dark)] sm:block\" data-kid=\"1-2-2-1-2\" data-name=\"separator\">\n                </span>\n                <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-1-3\" data-name=\"urgent records summary\">\n                    <strong class=\"text-[20px] font-semibold leading-none text-[var(--red)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3-1\" data-name=\"urgent records count\" data-reason=\"count updated by script\">\n                        1\n                    </strong>\n                    <span class=\"text-[14px] text-[var(--muted)]\" data-kid=\"1-2-2-1-3-2\" data-name=\"urgent records label\">\n                        prioridade urgente\n                    </span>\n                </div>\n                <div class=\"ml-auto text-[13px] text-[var(--muted)]\" data-kid=\"1-2-2-1-4\" data-name=\"sorting info\">\n                    <span class=\"font-semibold text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1\" data-name=\"display count text\" data-reason=\"count updated by script\">\n                        2 ocorrências\n                    </span>\n                    · ordenadas por data\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Buscar, filtrar e ordenar ocorrências\" data-kid=\"1-2-3\" data-name=\"filters section\">\n            <div class=\"filter-grid grid grid-cols-[minmax(250px,1.5fr)_minmax(180px,0.85fr)_minmax(180px,0.85fr)] items-end gap-3\" data-kid=\"1-2-3-1\" data-name=\"filter grid layout\">\n                <div class=\"min-w-0\" data-kid=\"1-2-3-1-1\" data-name=\"search filter group\">\n                    <label class=\"mb-2 block text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-1-1-1\" data-name=\"search label\" for=\"search\">\n                        Buscar ocorrências\n                    </label>\n                    <div class=\"flex h-[46px] items-center gap-3 rounded-lg border border-[var(--line-dark)] bg-white px-3.5 focus-within:border-[var(--teal)] focus-within:ring-2 focus-within:ring-[#0f766e]/10\" data-kid=\"1-2-3-1-1-2\" data-name=\"search input wrapper\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-search text-[18px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"search icon\">\n                        </i>\n                        <input class=\"min-w-0 flex-1 border-0 bg-transparent text-[14px] text-[var(--ink)] outline-none placeholder:text-[var(--muted-light)]\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"search input field\" id=\"search\" placeholder=\"Local, descrição ou responsável\" type=\"search\"/>\n                        <kbd class=\"rounded border border-[var(--line)] bg-[var(--paper)] px-1.5 py-0.5 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2-3\" data-name=\"keyboard shortcut hint\">\n                            ⌘ K\n                        </kbd>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-3-1-2\" data-name=\"status filter group\">\n                    <label class=\"mb-2 block text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"status label\" for=\"status\">\n                        Andamento\n                    </label>\n                    <div class=\"relative\" data-kid=\"1-2-3-1-2-2\" data-name=\"status select wrapper\">\n                        <select class=\"h-[46px] w-full appearance-none rounded-lg border border-[var(--line-dark)] bg-white px-3.5 pr-10 text-[14px] text-[var(--ink)] outline-none focus:border-[var(--teal)]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"status dropdown menu\" id=\"status\">\n                            <option data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"status option default\">\n                                Todos os status\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"status option open\">\n                                Abertas\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-3\" data-name=\"status option triaged\">\n                                Em triagem\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-4\" data-name=\"status option assigned\">\n                                Atribuídas\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-5\" data-name=\"status option in-execution\">\n                                Em execução\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-6\" data-name=\"status option waiting-material\">\n                                Aguardando material\n                            </option>\n                            <option data-kid=\"1-2-3-1-2-2-1-7\" data-name=\"status option resolved\">\n                                Resolvidas\n                            </option>\n                        </select>\n                        <i aria-hidden=\"true\" class=\"icon ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[16px] text-[var(--muted)]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"dropdown icon\">\n                        </i>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-3-1-3\" data-name=\"sorting filter group\">\n                    <label class=\"mb-2 block text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-1-3-1\" data-name=\"sorting label\" for=\"sort\">\n                        Ordenar por\n                    </label>\n                    <div class=\"relative\" data-kid=\"1-2-3-1-3-2\" data-name=\"sorting select wrapper\">\n                        <select class=\"h-[46px] w-full appearance-none rounded-lg border border-[var(--line-dark)] bg-white px-3.5 pr-10 text-[14px] text-[var(--ink)] outline-none focus:border-[var(--teal)]\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"sorting dropdown menu\" id=\"sort\">\n                            <option data-kid=\"1-2-3-1-3-2-1-1\" data-name=\"sort option newest\">\n                                Mais recentes\n                            </option>\n                            <option data-kid=\"1-2-3-1-3-2-1-2\" data-name=\"sort option priority\">\n                                Maior prioridade\n                            </option>\n                            <option data-kid=\"1-2-3-1-3-2-1-3\" data-name=\"sort option deadline\">\n                                Prazo mais próximo\n                            </option>\n                        </select>\n                        <i aria-hidden=\"true\" class=\"icon ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[16px] text-[var(--muted)]\" data-kid=\"1-2-3-1-3-2-2\" data-name=\"dropdown icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n            <div class=\"toolbar-actions mt-3 flex items-center justify-between gap-4\" data-kid=\"1-2-3-2\" data-name=\"toolbar actions row\">\n                <div class=\"flex flex-wrap items-center gap-2 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-3-2-1\" data-name=\"filter labels group\">\n                    <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"filter label\">\n                        Filtro:\n                    </span>\n                    <span class=\"rounded-md bg-[var(--teal-soft)] px-2.5 py-1.5 font-medium text-[var(--teal-dark)]\" data-kid=\"1-2-3-2-1-2\" data-name=\"active filter badge\">\n                        Todos os status\n                    </span>\n                    <button class=\"px-1 py-1 text-[13px] font-medium text-[var(--teal-dark)] underline decoration-[var(--line-dark)] underline-offset-4\" data-kid=\"1-2-3-2-1-3\" data-name=\"clear filters button\" type=\"button\">\n                        Limpar filtros\n                    </button>\n                </div>\n                <button class=\"flex h-[42px] items-center justify-center gap-2 rounded-lg border border-[var(--line-dark)] bg-white px-4 text-[13px] font-semibold text-[var(--navy)] hover:bg-[#f7faf9]\" data-kid=\"1-2-3-2-2\" data-name=\"export csv button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-download text-[17px]\" data-kid=\"1-2-3-2-2-1\" data-name=\"download icon\">\n                    </i>\n                    Exportar CSV\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Ocorrências agrupadas pelo texto do local\" class=\"mt-9\" data-kid=\"1-2-4\" data-name=\"occurrences list section\">\n            <div class=\"record-head mb-2 flex items-center justify-between gap-4 border-b border-[var(--line-dark)] pb-4\" data-kid=\"1-2-4-1\" data-name=\"list header\">\n                <div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"location identifier group\">\n                    <div class=\"mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--teal-soft)] text-[var(--teal-dark)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"location icon container\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-map-pin text-[18px]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"map pin icon\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-2-4-1-1-2\" data-name=\"location header text\">\n                        <div class=\"mb-1 text-[12px] font-semibold uppercase tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"location label\">\n                            Local informado\n                        </div>\n                        <h2 class=\"address-line m-0 max-w-[850px] text-[16px] font-semibold leading-snug tracking-[-0.015em] text-[var(--navy)]\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"location address title\">\n                            casa da mae joana , numero 345, bairro cavalada, ararangua- SC\n                        </h2>\n                    </div>\n                </div>\n                <div class=\"desktop-meta shrink-0 text-right\" data-kid=\"1-2-4-1-2\" data-name=\"location stats container\">\n                    <div class=\"text-[20px] font-semibold leading-none text-[var(--navy)]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-1\" data-name=\"location occurrences count\" data-reason=\"count updated by script\">\n                        2\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2\" data-name=\"occurrences label\">\n                        ocorrências\n                    </div>\n                </div>\n            </div>\n            <div class=\"hidden grid-cols-[minmax(280px,1.55fr)_minmax(125px,.65fr)_minmax(130px,.75fr)_minmax(155px,.85fr)_minmax(175px,.9fr)] gap-5 px-2 py-2.5 text-[11px] font-bold uppercase tracking-[0.09em] text-[var(--muted)] md:grid\" data-kid=\"1-2-4-2\" data-name=\"table column headers\">\n                <div data-kid=\"1-2-4-2-1\">\n                    Ocorrência\n                </div>\n                <div data-kid=\"1-2-4-2-2\">\n                    Prioridade\n                </div>\n                <div data-kid=\"1-2-4-2-3\">\n                    Andamento\n                </div>\n                <div data-kid=\"1-2-4-2-4\">\n                    Responsável\n                </div>\n                <div data-kid=\"1-2-4-2-5\">\n                    Prazo desejado\n                </div>\n            </div>\n            <article aria-label=\"Ocorrência elétrica urgente, aberta\" class=\"table-row grid grid-cols-[minmax(280px,1.55fr)_minmax(125px,.65fr)_minmax(130px,.75fr)_minmax(155px,.85fr)_minmax(175px,.9fr)] items-center gap-5 border-b border-[var(--line)] px-2 py-5\" data-kid=\"1-2-4-3\" data-name=\"electrical occurrence card\">\n                <div class=\"min-w-0\" data-kid=\"1-2-4-3-1\" data-name=\"occurrence info cell\">\n                    <div class=\"mobile-meta mb-2 hidden items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-2-4-3-1-1\" data-name=\"mobile meta header\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-bolt text-[14px] text-[var(--red)]\" data-kid=\"1-2-4-3-1-1-1\" data-name=\"lightning bolt icon\">\n                        </i>\n                        Elétrica · registrada em 18/09/2026\n                    </div>\n                    <h3 class=\"m-0 text-[15px] font-semibold leading-snug text-[var(--navy)]\" data-kid=\"1-2-4-3-1-2\" data-name=\"occurrence title\">\n                        Disjuntor desarma ao ligar o chuveiro\n                    </h3>\n                    <p class=\"mb-0 mt-1.5 max-w-[510px] text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-4-3-1-3\" data-name=\"occurrence description\">\n                        Solicitada avaliação técnica do disjuntor do circuito 10, que desliga quando o morador liga o chuveiro.\n                    </p>\n                    <div class=\"mt-2 text-[12px] text-[var(--muted-light)]\" data-kid=\"1-2-4-3-1-4\" data-name=\"occurrence footer metadata\">\n                        Elétrica\n                        <span class=\"mx-1.5 text-[var(--line-dark)]\" data-kid=\"1-2-4-3-1-4-1\" data-name=\"separator\">\n                            ·\n                        </span>\n                        Registrada em 18/09/2026 às 11:33\n                    </div>\n                </div>\n                <div class=\"priority-status grid gap-2\" data-kid=\"1-2-4-3-2\" data-name=\"priority cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-3-2-1\" data-name=\"priority label mobile\">\n                        Prioridade\n                    </div>\n                    <span class=\"inline-flex w-fit items-center gap-2 rounded-md bg-[var(--red-soft)] px-2.5 py-1.5 text-[13px] font-semibold text-[var(--red)]\" data-kid=\"1-2-4-3-2-2\" data-name=\"priority badge\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--red)]\" data-kid=\"1-2-4-3-2-2-1\" data-name=\"priority indicator dot\">\n                        </span>\n                        Urgente\n                    </span>\n                </div>\n                <div class=\"priority-status grid gap-2\" data-kid=\"1-2-4-3-3\" data-name=\"andamento status cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-3-3-1\" data-name=\"andamento label mobile\">\n                        Andamento\n                    </div>\n                    <span class=\"inline-flex w-fit items-center gap-2 text-[13px] font-medium text-[var(--ink)]\" data-kid=\"1-2-4-3-3-2\" data-name=\"andamento status display\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--amber)]\" data-kid=\"1-2-4-3-3-2-1\" data-name=\"andamento indicator dot\">\n                        </span>\n                        Aberta\n                    </span>\n                    <select aria-label=\"Atualizar andamento da ocorrência elétrica\" class=\"h-9 w-full max-w-[160px] rounded-md border border-[var(--line-dark)] bg-white px-2.5 text-[12px] text-[var(--ink)]\" data-kid=\"1-2-4-3-3-3\" data-name=\"andamento update dropdown\">\n                        <option data-kid=\"1-2-4-3-3-3-1\" selected=\"\">\n                            Atualizar andamento\n                        </option>\n                        <option data-kid=\"1-2-4-3-3-3-2\">\n                            Em triagem\n                        </option>\n                        <option data-kid=\"1-2-4-3-3-3-3\">\n                            Atribuída\n                        </option>\n                        <option data-kid=\"1-2-4-3-3-3-4\">\n                            Em execução\n                        </option>\n                        <option data-kid=\"1-2-4-3-3-3-5\">\n                            Aguardando material\n                        </option>\n                        <option data-kid=\"1-2-4-3-3-3-6\">\n                            Resolvida\n                        </option>\n                    </select>\n                </div>\n                <div class=\"record-fields grid grid-cols-[1fr] gap-2 text-[13px]\" data-kid=\"1-2-4-3-4\" data-name=\"responsible cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-3-4-1\" data-name=\"responsible label mobile\">\n                        Responsável\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[var(--ink)]\" data-kid=\"1-2-4-3-4-2\" data-name=\"responsible user info\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-user text-[16px] text-[var(--muted)]\" data-kid=\"1-2-4-3-4-2-1\" data-name=\"user icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-3-4-2-2\" data-name=\"responsible name\">\n                            jefinho fófó\n                        </span>\n                    </div>\n                </div>\n                <div class=\"record-fields grid grid-cols-[1fr] gap-2 text-[13px]\" data-kid=\"1-2-4-3-5\" data-name=\"deadline cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-3-5-1\" data-name=\"deadline label mobile\">\n                        Prazo desejado\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[var(--ink)]\" data-kid=\"1-2-4-3-5-2\" data-name=\"deadline display\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-calendar text-[16px] text-[var(--muted)]\" data-kid=\"1-2-4-3-5-2-1\" data-name=\"calendar icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-3-5-2-2\" data-name=\"deadline date\">\n                            09/12/2026\n                        </span>\n                    </div>\n                </div>\n            </article>\n            <article aria-label=\"Inspeção hidráulica preventiva, aberta\" class=\"table-row grid grid-cols-[minmax(280px,1.55fr)_minmax(125px,.65fr)_minmax(130px,.75fr)_minmax(155px,.85fr)_minmax(175px,.9fr)] items-center gap-5 border-b border-[var(--line)] px-2 py-5\" data-kid=\"1-2-4-4\" data-name=\"hydraulic inspection card\">\n                <div class=\"min-w-0\" data-kid=\"1-2-4-4-1\" data-name=\"occurrence info cell\">\n                    <div class=\"mobile-meta mb-2 hidden items-center gap-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[var(--muted)]\" data-kid=\"1-2-4-4-1-1\" data-name=\"mobile meta header\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-droplet text-[14px] text-[var(--teal)]\" data-kid=\"1-2-4-4-1-1-1\" data-name=\"droplet icon\">\n                        </i>\n                        Hidráulica · registrada em 18/09/2026\n                    </div>\n                    <h3 class=\"m-0 text-[15px] font-semibold leading-snug text-[var(--navy)]\" data-kid=\"1-2-4-4-1-2\" data-name=\"occurrence title\">\n                        Inspeção preventiva hidráulica\n                    </h3>\n                    <p class=\"mb-0 mt-1.5 max-w-[510px] text-[13px] leading-relaxed text-[var(--muted)]\" data-kid=\"1-2-4-4-1-3\" data-name=\"occurrence description\">\n                        inspeção preventiva realizada. sem ocorrencias\n                    </p>\n                    <div class=\"mt-2 text-[12px] text-[var(--muted-light)]\" data-kid=\"1-2-4-4-1-4\" data-name=\"occurrence footer metadata\">\n                        Hidráulica\n                        <span class=\"mx-1.5 text-[var(--line-dark)]\" data-kid=\"1-2-4-4-1-4-1\" data-name=\"separator\">\n                            ·\n                        </span>\n                        Registrada em 18/09/2026 às 11:30\n                    </div>\n                </div>\n                <div class=\"priority-status grid gap-2\" data-kid=\"1-2-4-4-2\" data-name=\"priority cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-4-2-1\" data-name=\"priority label mobile\">\n                        Prioridade\n                    </div>\n                    <span class=\"inline-flex w-fit items-center gap-2 rounded-md bg-[var(--green-soft)] px-2.5 py-1.5 text-[13px] font-semibold text-[var(--green)]\" data-kid=\"1-2-4-4-2-2\" data-name=\"priority badge\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--green)]\" data-kid=\"1-2-4-4-2-2-1\" data-name=\"priority indicator dot\">\n                        </span>\n                        Normal\n                    </span>\n                </div>\n                <div class=\"priority-status grid gap-2\" data-kid=\"1-2-4-4-3\" data-name=\"andamento status cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-4-3-1\" data-name=\"andamento label mobile\">\n                        Andamento\n                    </div>\n                    <span class=\"inline-flex w-fit items-center gap-2 text-[13px] font-medium text-[var(--ink)]\" data-kid=\"1-2-4-4-3-2\" data-name=\"andamento status display\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--amber)]\" data-kid=\"1-2-4-4-3-2-1\" data-name=\"andamento indicator dot\">\n                        </span>\n                        Aberta\n                    </span>\n                    <select aria-label=\"Atualizar andamento da inspeção hidráulica\" class=\"h-9 w-full max-w-[160px] rounded-md border border-[var(--line-dark)] bg-white px-2.5 text-[12px] text-[var(--ink)]\" data-kid=\"1-2-4-4-3-3\" data-name=\"andamento update dropdown\">\n                        <option data-kid=\"1-2-4-4-3-3-1\" selected=\"\">\n                            Atualizar andamento\n                        </option>\n                        <option data-kid=\"1-2-4-4-3-3-2\">\n                            Em triagem\n                        </option>\n                        <option data-kid=\"1-2-4-4-3-3-3\">\n                            Atribuída\n                        </option>\n                        <option data-kid=\"1-2-4-4-3-3-4\">\n                            Em execução\n                        </option>\n                        <option data-kid=\"1-2-4-4-3-3-5\">\n                            Aguardando material\n                        </option>\n                        <option data-kid=\"1-2-4-4-3-3-6\">\n                            Resolvida\n                        </option>\n                    </select>\n                </div>\n                <div class=\"record-fields grid grid-cols-[1fr] gap-2 text-[13px]\" data-kid=\"1-2-4-4-4\" data-name=\"responsible cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-4-4-1\" data-name=\"responsible label mobile\">\n                        Responsável\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[var(--ink)]\" data-kid=\"1-2-4-4-4-2\" data-name=\"responsible user info\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-user text-[16px] text-[var(--muted)]\" data-kid=\"1-2-4-4-4-2-1\" data-name=\"user icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-4-4-2-2\" data-name=\"responsible name\">\n                            jefinho do fófó\n                        </span>\n                    </div>\n                </div>\n                <div class=\"record-fields grid grid-cols-[1fr] gap-2 text-[13px]\" data-kid=\"1-2-4-4-5\" data-name=\"deadline cell\">\n                    <div class=\"text-[11px] font-semibold uppercase tracking-[0.06em] text-[var(--muted)] md:hidden\" data-kid=\"1-2-4-4-5-1\" data-name=\"deadline label mobile\">\n                        Prazo desejado\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[13px] text-[var(--ink)]\" data-kid=\"1-2-4-4-5-2\" data-name=\"deadline display\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-calendar text-[16px] text-[var(--muted)]\" data-kid=\"1-2-4-4-5-2-1\" data-name=\"calendar icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-4-5-2-2\" data-name=\"deadline date\">\n                            09/12/2026\n                        </span>\n                    </div>\n                </div>\n            </article>\n            <footer class=\"mt-5 flex items-center justify-between gap-4 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-4-5\" data-name=\"footer bar\">\n                <span data-kid=\"1-2-4-5-1\" data-name=\"display summary text\">\n                    Exibindo\n                    <strong class=\"font-semibold text-[var(--ink)]\" data-dynamic=\"true\" data-kid=\"1-2-4-5-1-1\" data-name=\"display occurrences count\" data-reason=\"count updated by script\">\n                        2 ocorrências\n                    </strong>\n                    neste local\n                </span>\n                <span class=\"desktop-meta flex items-center gap-1.5\" data-kid=\"1-2-4-5-2\" data-name=\"info metadata\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-info-circle text-[16px]\" data-kid=\"1-2-4-5-2-1\" data-name=\"info icon\">\n                    </i>\n                    Agrupamento por texto de local idêntico\n                </span>\n            </footer>\n        </section>\n    </main>\n</div>\n",
