      "html": "<main class=\"min-h-screen bg-[#f0fdfa] px-5 py-7 text-[#1e293b]\" data-kid=\"1\" data-name=\"page main wrapper\" style=\"font-family:'Trebuchet MS','Segoe UI',sans-serif\">\n    <div class=\"mx-auto max-w-[1240px]\" data-kid=\"1-1\" data-name=\"page content container\">\n        <header class=\"mb-6 flex items-center justify-between gap-6\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div data-kid=\"1-1-1-1\" data-name=\"page title and description container\">\n                <h1 class=\"m-0 text-[30px] font-bold leading-tight tracking-[-0.03em] text-[#172554]\" data-kid=\"1-1-1-1-1\" data-name=\"page headline\">\n                    Central de Ocorrências\n                </h1>\n                <p class=\"mb-0 mt-1 text-[15px] text-[#64748b]\" data-kid=\"1-1-1-1-2\" data-name=\"page subtitle text\">\n                    Registro e acompanhamento da manutenção predial\n                </p>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-3 rounded-full border border-[#cde4dc] bg-white px-3.5 py-2 text-[13px] font-semibold text-[#145b4d]\" data-kid=\"1-1-1-2\" data-name=\"synchronization status badge\">\n                <span class=\"h-2 w-2 rounded-full bg-[#059669]\" data-kid=\"1-1-1-2-1\" data-name=\"status indicator dot\">\n                </span>\n                Sincronizado\n            </div>\n        </header>\n        <nav aria-label=\"Navegação principal\" class=\"mb-8 flex flex-wrap gap-1 rounded-xl border border-[#d4e4e1] bg-white/85 p-1.5\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#475569] no-underline\" data-kid=\"1-1-2-1\" data-name=\"navigation link overview\" href=\"#visao-geral\">\n                Visão geral\n            </a>\n            <a aria-current=\"page\" class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg bg-[#0f766e] px-4 text-[14px] font-bold text-white no-underline shadow-sm\" data-kid=\"1-1-2-2\" data-name=\"navigation link register\" href=\"#registrar\">\n                Registrar\n            </a>\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#475569] no-underline\" data-kid=\"1-1-2-3\" data-name=\"navigation link occurrences\" href=\"#ocorrencias\">\n                Ocorrências\n            </a>\n            <a class=\"flex min-h-[48px] flex-1 items-center justify-center rounded-lg px-4 text-[14px] font-semibold text-[#475569] no-underline\" data-kid=\"1-1-2-4\" data-name=\"navigation link tasks\" href=\"#tarefas\">\n                Tarefas\n            </a>\n        </nav>\n        <section aria-labelledby=\"page-title\" class=\"mb-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-4\" data-kid=\"1-1-3\" data-name=\"section header\" id=\"registrar\">\n            <div data-kid=\"1-1-3-1\" data-name=\"section title and description\">\n                <h2 class=\"m-0 text-[28px] font-bold tracking-[-0.025em] text-[#172554]\" data-kid=\"1-1-3-1-1\" data-name=\"section title\" id=\"page-title\">\n                    Registrar ocorrência\n                </h2>\n                <p class=\"mb-0 mt-1 text-[15px] text-[#526174]\" data-kid=\"1-1-3-1-2\" data-name=\"section description text\">\n                    Informe o local e o que foi observado para orientar a equipe.\n                </p>\n            </div>\n            <div class=\"min-w-[280px] rounded-xl border border-[#d7e6e2] bg-white px-4 py-3\" data-kid=\"1-1-3-2\" data-name=\"progress indicator card\">\n                <div class=\"mb-2 flex items-center justify-between gap-3 text-[13px]\" data-kid=\"1-1-3-2-1\" data-name=\"progress header\">\n                    <span class=\"font-semibold text-[#172554]\" data-kid=\"1-1-3-2-1-1\" data-name=\"progress status label\">\n                        Campos obrigatórios\n                    </span>\n                    <strong class=\"text-[#0f766e]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-1-2\" data-name=\"progress completion text\" data-reason=\"text updated as form fields are filled\">\n                        7 de 7 preenchidos\n                    </strong>\n                </div>\n                <div aria-label=\"Campos obrigatórios preenchidos\" aria-valuemax=\"7\" aria-valuemin=\"0\" aria-valuenow=\"7\" class=\"h-2 overflow-hidden rounded-full bg-[#e3eeeb]\" data-kid=\"1-1-3-2-2\" data-name=\"progress bar track\" role=\"progressbar\">\n                    <div class=\"h-full w-full rounded-full bg-[#0f766e]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-2-1\" data-name=\"progress bar fill\" data-reason=\"width updated as form fields are filled\">\n                    </div>\n                </div>\n            </div>\n        </section>\n        <form class=\"overflow-hidden rounded-2xl border border-[#d7e4e2] bg-white shadow-[0_12px_30px_rgba(15,118,110,0.06)]\" data-kid=\"1-1-4\" data-name=\"occurrence registration form\">\n            <div class=\"grid grid-cols-1 gap-0 lg:grid-cols-[minmax(0,1fr)_330px]\" data-kid=\"1-1-4-1\" data-name=\"form layout grid\">\n                <div class=\"min-w-0 px-6 py-6 lg:px-8 lg:py-7\" data-kid=\"1-1-4-1-1\" data-name=\"form fields container\">\n                    <section aria-labelledby=\"location-title\" class=\"border-b border-[#e2ebe9] pb-6\" data-kid=\"1-1-4-1-1-1\" data-name=\"location section\">\n                        <div class=\"mb-4 flex items-end justify-between gap-4\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"location header\">\n                            <div data-kid=\"1-1-4-1-1-1-1-1\" data-name=\"location title and description\">\n                                <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-1-1-1-1\" data-name=\"location section title\" id=\"location-title\">\n                                    Local do imóvel\n                                </h3>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-1-1-1-2\" data-name=\"location section description\">\n                                    Comece pelo local para consultar ocorrências relacionadas.\n                                </p>\n                            </div>\n                            <span class=\"hidden rounded-full bg-[#e8f5f2] px-3 py-1.5 text-[12px] font-semibold text-[#0f766e] sm:inline-flex\" data-kid=\"1-1-4-1-1-1-1-2\" data-name=\"location type badge\">\n                                Texto livre\n                            </span>\n                        </div>\n                        <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"location input label\" for=\"location\">\n                            Imóvel / identificação\n                        </label>\n                        <input class=\"h-[52px] w-full rounded-lg border border-[#b9cdca] bg-white px-4 text-[15px] text-[#172554] shadow-[inset_0_1px_2px_rgba(23,37,84,0.03)] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-1-4-1-1-1-3\" data-name=\"location input field\" id=\"location\" type=\"text\" value=\"Casa da Mae Joana, nº 345 · Cavalada, Araranguá–SC\"/>\n                        <div class=\"mt-3 flex flex-wrap items-center gap-2.5\" data-kid=\"1-1-4-1-1-1-4\" data-name=\"recent locations container\">\n                            <span class=\"mr-1 text-[13px] font-semibold text-[#64748b]\" data-kid=\"1-1-4-1-1-1-4-1\" data-name=\"recent locations label\">\n                                Usado recentemente\n                            </span>\n                            <button class=\"min-h-[42px] max-w-full rounded-full border border-[#9bc9be] bg-[#eaf6f2] px-4 py-2 text-left text-[13px] font-semibold text-[#145b4d]\" data-kid=\"1-1-4-1-1-1-4-2\" data-name=\"recent location button\" type=\"button\">\n                                Casa da Mae Joana, nº 345 · Cavalada, Araranguá–SC\n                            </button>\n                            <button class=\"min-h-[42px] rounded-full border border-[#d8e3e1] bg-white px-3.5 py-2 text-[13px] font-medium text-[#475569]\" data-kid=\"1-1-4-1-1-1-4-3\" data-name=\"favorite location button\" type=\"button\">\n                                ☆ Favoritar local digitado\n                            </button>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"issue-title\" class=\"border-b border-[#e2ebe9] py-6\" data-kid=\"1-1-4-1-1-2\" data-name=\"issue observation section\">\n                        <div class=\"mb-4\" data-kid=\"1-1-4-1-1-2-1\" data-name=\"issue header\">\n                            <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-2-1-1\" data-name=\"issue section title\" id=\"issue-title\">\n                                O que foi observado?\n                            </h3>\n                            <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-2-1-2\" data-name=\"issue section description\">\n                                Classifique o problema e marque a prioridade adequada.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 gap-5 md:grid-cols-[0.85fr_1.4fr]\" data-kid=\"1-1-4-1-1-2-2\" data-name=\"issue details grid\">\n                            <div data-kid=\"1-1-4-1-1-2-2-1\" data-name=\"category selection container\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-2-2-1-1\" data-name=\"category label\" for=\"category\">\n                                    Categoria\n                                </label>\n                                <select class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554] outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/15\" data-kid=\"1-1-4-1-1-2-2-1-2\" data-name=\"category select input\" id=\"category\">\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-1\" selected=\"\">\n                                        Elétrica\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-2\">\n                                        Hidráulica\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-3\">\n                                        Civil\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-4\">\n                                        Climatização\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-5\">\n                                        Segurança\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-6\">\n                                        Limpeza\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-2-2-1-2-7\">\n                                        Outra\n                                    </option>\n                                </select>\n                            </div>\n                            <fieldset class=\"min-w-0 border-0 p-0\" data-kid=\"1-1-4-1-1-2-2-2\" data-name=\"priority fieldset\">\n                                <legend class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-2-2-2-1\" data-name=\"priority label\">\n                                    Prioridade\n                                </legend>\n                                <div class=\"grid grid-cols-3 gap-2\" data-kid=\"1-1-4-1-1-2-2-2-2\" data-name=\"priority options grid\">\n                                    <label class=\"flex min-h-[50px] cursor-pointer items-center gap-2 rounded-lg border border-[#d8e2df] bg-white px-3 text-[14px] font-semibold text-[#415063]\" data-kid=\"1-1-4-1-1-2-2-2-2-1\" data-name=\"normal priority option\">\n                                        <span class=\"h-3 w-3 rounded-full bg-[#059669]\" data-kid=\"1-1-4-1-1-2-2-2-2-1-1\" data-name=\"normal priority indicator\">\n                                        </span>\n                                        Normal\n                                    </label>\n                                    <label class=\"flex min-h-[50px] cursor-pointer items-center gap-2 rounded-lg border border-[#d8e2df] bg-white px-3 text-[14px] font-semibold text-[#415063]\" data-kid=\"1-1-4-1-1-2-2-2-2-2\" data-name=\"attention priority option\">\n                                        <span class=\"h-3 w-3 rounded-full bg-[#d97706]\" data-kid=\"1-1-4-1-1-2-2-2-2-2-1\" data-name=\"attention priority indicator\">\n                                        </span>\n                                        Atenção\n                                    </label>\n                                    <label class=\"flex min-h-[50px] cursor-pointer items-center gap-2 rounded-lg border-2 border-[#dc2626] bg-[#fff5f4] px-3 text-[14px] font-bold text-[#9d2823]\" data-kid=\"1-1-4-1-1-2-2-2-2-3\" data-name=\"urgent priority option\">\n                                        <span class=\"h-3 w-3 rounded-full bg-[#dc2626]\" data-kid=\"1-1-4-1-1-2-2-2-2-3-1\" data-name=\"urgent priority indicator\">\n                                        </span>\n                                        Urgente\n                                    </label>\n                                </div>\n                            </fieldset>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"guided-title\" class=\"py-6\" data-kid=\"1-1-4-1-1-3\" data-name=\"problem details section\">\n                        <div class=\"mb-4 flex flex-wrap items-end justify-between gap-2\" data-kid=\"1-1-4-1-1-3-1\" data-name=\"problem details header\">\n                            <div data-kid=\"1-1-4-1-1-3-1-1\" data-name=\"problem details title and description\">\n                                <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-3-1-1-1\" data-name=\"problem details title\" id=\"guided-title\">\n                                    Detalhes do problema\n                                </h3>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-3-1-1-2\" data-name=\"problem details description\">\n                                    Responda com o que você está vendo no local.\n                                </p>\n                            </div>\n                            <span class=\"text-[13px] font-medium text-[#64748b]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-1-3-1-2\" data-name=\"problem summary text\" data-reason=\"text updated based on select inputs\">\n                                Elétrica · disjuntor do chuveiro\n                            </span>\n                        </div>\n                        <div class=\"grid grid-cols-1 gap-x-5 gap-y-4 sm:grid-cols-2\" data-kid=\"1-1-4-1-1-3-2\" data-name=\"details select fields grid\">\n                            <div data-kid=\"1-1-4-1-1-3-2-1\" data-name=\"environment selection\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-3-2-1-1\" data-name=\"environment label\" for=\"environment\">\n                                    Onde exatamente?\n                                </label>\n                                <select class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-3-2-1-2\" data-name=\"environment select input\" id=\"environment\">\n                                    <option data-kid=\"1-1-4-1-1-3-2-1-2-1\" selected=\"\">\n                                        Banheiro\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-1-2-2\">\n                                        Quarto\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-1-2-3\">\n                                        Cozinha\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-1-2-4\">\n                                        Área externa\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-1-2-5\">\n                                        Quadro de energia\n                                    </option>\n                                </select>\n                            </div>\n                            <div data-kid=\"1-1-4-1-1-3-2-2\" data-name=\"element selection\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-3-2-2-1\" data-name=\"element label\" for=\"element\">\n                                    Qual item?\n                                </label>\n                                <select class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-3-2-2-2\" data-name=\"element select input\" id=\"element\">\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-1\" selected=\"\">\n                                        Disjuntor\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-2\">\n                                        Lâmpada\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-3\">\n                                        Tomada\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-4\">\n                                        Interruptor\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-5\">\n                                        Chuveiro\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-2-2-6\">\n                                        Fiação\n                                    </option>\n                                </select>\n                            </div>\n                            <div data-kid=\"1-1-4-1-1-3-2-3\" data-name=\"situation selection\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-3-2-3-1\" data-name=\"situation label\" for=\"situation\">\n                                    O que aconteceu?\n                                </label>\n                                <select class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-3-2-3-2\" data-name=\"situation select input\" id=\"situation\">\n                                    <option data-kid=\"1-1-4-1-1-3-2-3-2-1\" selected=\"\">\n                                        Está desligando sozinho\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-3-2-2\">\n                                        Queimado ou não acende\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-3-2-3\">\n                                        Faz barulho ou estala\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-3-2-4\">\n                                        Está aquecendo\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-3-2-5\">\n                                        Está solto ou quebrado\n                                    </option>\n                                </select>\n                            </div>\n                            <div data-kid=\"1-1-4-1-1-3-2-4\" data-name=\"action selection\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-3-2-4-1\" data-name=\"action label\" for=\"action\">\n                                    O que precisa ser feito?\n                                </label>\n                                <select class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-3-2-4-2\" data-name=\"action select input\" id=\"action\">\n                                    <option data-kid=\"1-1-4-1-1-3-2-4-2-1\" selected=\"\">\n                                        Manter desligado e acionar eletricista\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-4-2-2\">\n                                        Acionar eletricista para verificar\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-4-2-3\">\n                                        Acionar eletricista para trocar\n                                    </option>\n                                    <option data-kid=\"1-1-4-1-1-3-2-4-2-4\">\n                                        Solicitar vistoria de segurança\n                                    </option>\n                                </select>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 rounded-xl border border-[#f0c7c3] bg-[#fff6f4] p-4 sm:flex sm:items-start sm:gap-3.5\" data-kid=\"1-1-4-1-1-3-3\" data-name=\"security warning box\">\n                            <div class=\"mb-2 shrink-0 text-[12px] font-bold uppercase tracking-[0.08em] text-[#a12d27] sm:mb-0 sm:pt-0.5\" data-kid=\"1-1-4-1-1-3-3-1\" data-name=\"security warning title\">\n                                Segurança\n                            </div>\n                            <div data-kid=\"1-1-4-1-1-3-3-2\" data-name=\"security warning content\">\n                                <p class=\"m-0 text-[14px] font-bold leading-5 text-[#7f2924]\" data-kid=\"1-1-4-1-1-3-3-2-1\" data-name=\"security warning header text\">\n                                    O disjuntor desarma quando o chuveiro é ligado.\n                                </p>\n                                <p class=\"mb-0 mt-1 text-[14px] leading-5 text-[#783b36]\" data-kid=\"1-1-4-1-1-3-3-2-2\" data-name=\"security warning body text\">\n                                    Mantenha o circuito desligado. Se houver cheiro de queimado ou faísca, não religue e acione um eletricista.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 rounded-xl bg-[#f5f9f8] px-4 py-4\" data-kid=\"1-1-4-1-1-3-4\" data-name=\"confirmation checklist section\">\n                            <p class=\"mb-3 mt-0 text-[14px] font-bold text-[#27364a]\" data-kid=\"1-1-4-1-1-3-4-1\" data-name=\"checklist header\">\n                                Antes de enviar, se conseguir, confirme:\n                            </p>\n                            <div class=\"grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2\" data-kid=\"1-1-4-1-1-3-4-2\" data-name=\"checklist items grid\">\n                                <label class=\"flex min-h-[44px] items-center gap-3 text-[14px] leading-5 text-[#344256]\" data-kid=\"1-1-4-1-1-3-4-2-1\" data-name=\"checklist item 1 label\">\n                                    <input class=\"h-5 w-5 shrink-0 accent-[#0f766e]\" data-kid=\"1-1-4-1-1-3-4-2-1-1\" data-name=\"checklist item 1 checkbox\" type=\"checkbox\"/>\n                                    Verificar se o disjuntor está ligado\n                                </label>\n                                <label class=\"flex min-h-[44px] items-center gap-3 text-[14px] leading-5 text-[#344256]\" data-kid=\"1-1-4-1-1-3-4-2-2\" data-name=\"checklist item 2 label\">\n                                    <input class=\"h-5 w-5 shrink-0 accent-[#0f766e]\" data-kid=\"1-1-4-1-1-3-4-2-2-1\" data-name=\"checklist item 2 checkbox\" type=\"checkbox\"/>\n                                    Testar outro interruptor ou tomada do local\n                                </label>\n                                <label class=\"flex min-h-[44px] items-center gap-3 text-[14px] leading-5 text-[#344256] sm:col-span-2\" data-kid=\"1-1-4-1-1-3-4-2-3\" data-name=\"checklist item 3 label\">\n                                    <input class=\"h-5 w-5 shrink-0 accent-[#0f766e]\" data-kid=\"1-1-4-1-1-3-4-2-3-1\" data-name=\"checklist item 3 checkbox\" type=\"checkbox\"/>\n                                    Manter desligado se houver cheiro de queimado ou faísca\n                                </label>\n                            </div>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"routing-title\" class=\"border-t border-[#e2ebe9] py-6\" data-kid=\"1-1-4-1-1-4\" data-name=\"routing section\">\n                        <div class=\"mb-4\" data-kid=\"1-1-4-1-1-4-1\" data-name=\"routing header\">\n                            <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-4-1-1\" data-name=\"routing section title\" id=\"routing-title\">\n                                Encaminhamento\n                            </h3>\n                            <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-4-1-2\" data-name=\"routing section description\">\n                                Defina quem deve receber o chamado e o prazo desejado.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-1 gap-5 sm:grid-cols-2\" data-kid=\"1-1-4-1-1-4-2\" data-name=\"routing fields grid\">\n                            <div data-kid=\"1-1-4-1-1-4-2-1\" data-name=\"responsible field container\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-4-2-1-1\" data-name=\"responsible label\" for=\"responsible\">\n                                    Responsável\n                                </label>\n                                <input class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-4-2-1-2\" data-name=\"responsible input\" id=\"responsible\" value=\"jefinho fófó\"/>\n                            </div>\n                            <div data-kid=\"1-1-4-1-1-4-2-2\" data-name=\"deadline field container\">\n                                <label class=\"mb-1.5 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-4-2-2-1\" data-name=\"deadline label\" for=\"deadline\">\n                                    Prazo desejado\n                                </label>\n                                <input class=\"h-[50px] w-full rounded-lg border border-[#cbd7d5] bg-white px-3.5 text-[15px] text-[#172554]\" data-kid=\"1-1-4-1-1-4-2-2-2\" data-name=\"deadline input\" id=\"deadline\" type=\"date\" value=\"2026-12-09\"/>\n                            </div>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"report-title\" class=\"border-t border-[#e2ebe9] py-6\" data-kid=\"1-1-4-1-1-5\" data-name=\"report section\">\n                        <div class=\"mb-3\" data-kid=\"1-1-4-1-1-5-1\" data-name=\"report header\">\n                            <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-5-1-1\" data-name=\"report section title\" id=\"report-title\">\n                                Confira o relatório\n                            </h3>\n                            <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-5-1-2\" data-name=\"report section description\">\n                                Texto montado a partir das respostas acima.\n                            </p>\n                        </div>\n                        <textarea class=\"w-full resize-y rounded-lg border border-[#cbd7d5] bg-[#f8fbfa] px-4 py-3 text-[14px] leading-6 text-[#263449]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-1-5-2\" data-name=\"report text area\" data-reason=\"text generated from form fields\" readonly=\"\" rows=\"3\">No local Casa da Mae Joana, nº 345 · Cavalada, Araranguá–SC, o disjuntor no banheiro está desligando sozinho quando o chuveiro é ligado. Ação recomendada: manter o circuito desligado e acionar eletricista.</textarea>\n                        <label class=\"mb-1.5 mt-4 block text-[14px] font-semibold text-[#27364a]\" data-kid=\"1-1-4-1-1-5-3\" data-name=\"observation label\" for=\"note\">\n                            Observação adicional\n                            <span class=\"font-normal text-[#64748b]\" data-kid=\"1-1-4-1-1-5-3-1\" data-name=\"observation label hint\">\n                                (opcional)\n                            </span>\n                        </label>\n                        <textarea class=\"w-full resize-y rounded-lg border border-[#cbd7d5] bg-white px-4 py-3 text-[14px] leading-5 text-[#263449] placeholder:text-[#748197]\" data-kid=\"1-1-4-1-1-5-4\" data-name=\"observation text area\" id=\"note\" placeholder=\"Algum detalhe que não apareceu nas opções?\" rows=\"2\"></textarea>\n                    </section>\n                    <section aria-labelledby=\"photos-title\" class=\"border-t border-[#e2ebe9] py-6\" data-kid=\"1-1-4-1-1-6\" data-name=\"photos section\">\n                        <div class=\"mb-3\" data-kid=\"1-1-4-1-1-6-1\" data-name=\"photos header\">\n                            <h3 class=\"m-0 text-[19px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-1-6-1-1\" data-name=\"photos section title\" id=\"photos-title\">\n                                Fotos da ocorrência\n                                <span class=\"text-[14px] font-normal text-[#64748b]\" data-kid=\"1-1-4-1-1-6-1-1-1\" data-name=\"photos section subtitle\">\n                                    (opcional)\n                                </span>\n                            </h3>\n                            <p class=\"mb-0 mt-1 text-[14px] text-[#64748b]\" data-kid=\"1-1-4-1-1-6-1-2\" data-name=\"photos section description\">\n                                Uma imagem ajuda a equipe a chegar preparada.\n                            </p>\n                        </div>\n                        <div class=\"flex flex-wrap items-center justify-between gap-3 rounded-xl border border-dashed border-[#afc8c4] bg-[#fbfdfd] p-4\" data-kid=\"1-1-4-1-1-6-2\" data-name=\"photo upload container\">\n                            <p class=\"m-0 max-w-[540px] text-[13px] leading-5 text-[#526174]\" data-kid=\"1-1-4-1-1-6-2-1\" data-name=\"photo upload instructions\">\n                                Até 3 fotos, com no máximo 1 MB cada. Anexe somente imagens deste local.\n                            </p>\n                            <button class=\"min-h-[44px] rounded-lg border border-[#a9c8c1] bg-white px-4 py-2 text-[14px] font-semibold text-[#145b4d]\" data-kid=\"1-1-4-1-1-6-2-2\" data-name=\"add photos button\" type=\"button\">\n                                Adicionar fotos\n                            </button>\n                        </div>\n                    </section>\n                    <div class=\"flex flex-wrap items-center justify-between gap-4 border-t border-[#e2ebe9] pt-5\" data-kid=\"1-1-4-1-1-7\" data-name=\"form footer\">\n                        <p class=\"m-0 text-[13px] text-[#64748b]\" data-kid=\"1-1-4-1-1-7-1\" data-name=\"footer warning text\">\n                            O registro será enviado à equipe responsável.\n                        </p>\n                        <button class=\"min-h-[50px] min-w-[220px] rounded-lg bg-[#0f766e] px-6 py-3 text-[15px] font-bold text-white shadow-[0_4px_12px_rgba(15,118,110,0.16)]\" data-kid=\"1-1-4-1-1-7-2\" data-name=\"submit registration button\" type=\"button\">\n                            Registrar ocorrência\n                        </button>\n                    </div>\n                </div>\n                <aside class=\"border-t border-[#e2ebe9] bg-[#f7fbfa] px-6 py-6 lg:border-l lg:border-t-0 lg:px-6 lg:py-7\" data-kid=\"1-1-4-1-2\" data-name=\"summary sidebar\">\n                    <div class=\"lg:sticky lg:top-6\" data-kid=\"1-1-4-1-2-1\" data-name=\"summary content\">\n                        <h3 class=\"m-0 text-[18px] font-bold text-[#172554]\" data-kid=\"1-1-4-1-2-1-1\" data-name=\"sidebar title\">\n                            Resumo do local\n                        </h3>\n                        <p class=\"mb-0 mt-1 text-[14px] leading-5 text-[#64748b]\" data-kid=\"1-1-4-1-2-1-2\" data-name=\"sidebar description\">\n                            Use o mesmo endereço para encontrar registros anteriores.\n                        </p>\n                        <div class=\"mt-5 border-t border-[#dce9e6] pt-4\" data-kid=\"1-1-4-1-2-1-3\" data-name=\"location summary section\">\n                            <p class=\"mb-1 mt-0 text-[12px] font-bold uppercase tracking-[0.06em] text-[#64748b]\" data-kid=\"1-1-4-1-2-1-3-1\" data-name=\"location summary label\">\n                                Local selecionado\n                            </p>\n                            <p class=\"m-0 text-[15px] font-semibold leading-6 text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2-1-3-2\" data-name=\"location summary main text\" data-reason=\"text updated from location input\">\n                                Casa da Mae Joana, nº 345\n                            </p>\n                            <p class=\"mb-0 mt-0.5 text-[13px] leading-5 text-[#526174]\" data-kid=\"1-1-4-1-2-1-3-3\" data-name=\"location summary secondary text\">\n                                Cavalada, Araranguá–SC\n                            </p>\n                        </div>\n                        <div class=\"mt-5 border-t border-[#dce9e6] pt-4\" data-kid=\"1-1-4-1-2-1-4\" data-name=\"occurrence summary section\">\n                            <p class=\"mb-2 mt-0 text-[12px] font-bold uppercase tracking-[0.06em] text-[#64748b]\" data-kid=\"1-1-4-1-2-1-4-1\" data-name=\"occurrence summary label\">\n                                Ocorrência atual\n                            </p>\n                            <p class=\"m-0 text-[15px] font-bold leading-6 text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2-1-4-2\" data-name=\"occurrence summary text\" data-reason=\"text updated from form selections\">\n                                Disjuntor desarma ao ligar o chuveiro\n                            </p>\n                            <div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-1-4-1-2-1-4-3\" data-name=\"occurrence status tags container\">\n                                <span class=\"rounded-md bg-[#fff0ee] px-2.5 py-1.5 text-[12px] font-bold text-[#9d2823]\" data-kid=\"1-1-4-1-2-1-4-3-1\" data-name=\"priority tag\">\n                                    Prioridade · Urgente\n                                </span>\n                                <span class=\"rounded-md bg-[#e8f1f7] px-2.5 py-1.5 text-[12px] font-semibold text-[#24466b]\" data-kid=\"1-1-4-1-2-1-4-3-2\" data-name=\"progress tag\">\n                                    Andamento · Aberta\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 border-t border-[#dce9e6] pt-4\" data-kid=\"1-1-4-1-2-1-5\" data-name=\"routing summary section\">\n                            <p class=\"mb-2 mt-0 text-[12px] font-bold uppercase tracking-[0.06em] text-[#64748b]\" data-kid=\"1-1-4-1-2-1-5-1\" data-name=\"routing summary label\">\n                                Encaminhamento\n                            </p>\n                            <dl class=\"m-0 space-y-2.5 text-[14px]\" data-kid=\"1-1-4-1-2-1-5-2\" data-name=\"routing summary list\">\n                                <div class=\"flex justify-between gap-3\" data-kid=\"1-1-4-1-2-1-5-2-1\" data-name=\"routing summary responsible row\">\n                                    <dt class=\"text-[#64748b]\" data-kid=\"1-1-4-1-2-1-5-2-1-1\" data-name=\"responsible label\">\n                                        Responsável\n                                    </dt>\n                                    <dd class=\"m-0 font-semibold text-[#27364a]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2-1-5-2-1-2\" data-name=\"responsible value\" data-reason=\"text updated from input\">\n                                        jefinho fófó\n                                    </dd>\n                                </div>\n                                <div class=\"flex justify-between gap-3\" data-kid=\"1-1-4-1-2-1-5-2-2\" data-name=\"routing summary deadline row\">\n                                    <dt class=\"text-[#64748b]\" data-kid=\"1-1-4-1-2-1-5-2-2-1\" data-name=\"deadline label\">\n                                        Prazo\n                                    </dt>\n                                    <dd class=\"m-0 font-semibold text-[#27364a]\" data-dynamic=\"true\" data-kid=\"1-1-4-1-2-1-5-2-2-2\" data-name=\"deadline value\" data-reason=\"text updated from input\">\n                                        09/12/2026\n                                    </dd>\n                                </div>\n                            </dl>\n                        </div>\n                        <div class=\"mt-6 rounded-xl border border-[#f0c7c3] bg-[#fff6f4] p-4\" data-kid=\"1-1-4-1-2-1-6\" data-name=\"sidebar warning box\">\n                            <p class=\"mb-1 mt-0 text-[13px] font-bold text-[#8d302a]\" data-kid=\"1-1-4-1-2-1-6-1\" data-name=\"sidebar warning title\">\n                                Orientação de segurança\n                            </p>\n                            <p class=\"m-0 text-[13px] leading-5 text-[#783b36]\" data-kid=\"1-1-4-1-2-1-6-2\" data-name=\"sidebar warning body\">\n                                Mantenha o circuito desligado. Se houver cheiro de queimado ou faísca, não religue.\n                            </p>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </form>\n        <p class=\"mb-0 mt-5 text-center text-[12px] text-[#64748b]\" data-kid=\"1-1-5\" data-name=\"footer text\">\n            Gestão Predial · Registro de manutenção\n        </p>\n    </div>\n</main>\n<style>\n    @media (max-width: 720px) {\n    main { padding: 16px 12px 24px; }\n    main > div > header { align-items: flex-start; }\n    main > div > header h1 { font-size: 23px; }\n    nav[aria-label=\"Navegação principal\"] { position: static; }\n    nav[aria-label=\"Navegação principal\"] a { flex-basis: calc(50% - 4px); }\n  }\n  @media (max-width: 420px) {\n    nav[aria-label=\"Navegação principal\"] a { min-height: 44px; font-size: 12px; padding-left: 8px; padding-right: 8px; }\n    form > div > div:first-child { padding-left: 16px; padding-right: 16px; }\n    form > div > aside { padding-left: 16px; padding-right: 16px; }\n  }\n</style>\n",
