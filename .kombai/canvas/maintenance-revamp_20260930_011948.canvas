 </button>\n                    </div>\n                </div>\n            </section>\n            <div class=\"form-footer flex items-center justify-between gap-4 border-t border-[#d8e2e6] pt-5\" data-kid=\"1-2-3-7\">\n                <button class=\"rounded-lg px-4 py-3 text-[13px] font-semibold text-[#526276]\" data-kid=\"1-2-3-7-1\" type=\"button\">\n                    Descartar rascunho\n                </button>\n                <button class=\"inline-flex items-center justify-center gap-2 rounded-lg bg-[#0f766e] px-6 py-3.5 text-[14px] font-bold text-white shadow-[0_3px_10px_rgba(15,118,110,0.18)]\" data-kid=\"1-2-3-7-2\" type=\"button\">\n                    <i class=\"ti ti-clipboard-check\" data-kid=\"1-2-3-7-2-1\" style=\"font-size:18px;color:#fff\">\n                    </i>\n                    Registrar ocorrência\n                </button>\n            </div>\n        </form>\n        <footer class=\"mt-8 text-center text-[11px] text-[#69798a]\" data-kid=\"1-2-4\">\n            Sistema de Gestão de Manutenção Predial\n        </footer>\n    </main>\n</div>\n",
