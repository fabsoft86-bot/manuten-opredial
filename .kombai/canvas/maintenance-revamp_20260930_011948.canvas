      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root {\n  --brand-navy: #172554;\n  --brand-teal: #0f766e;\n  --page: #f4f7f7;\n  --ink: #1d2939;\n  --muted: #5f6b7b;\n  --line: #dce4e7;\n  --urgent: #a83227;\n  --urgent-soft: #fff2ef;\n  --urgent-line: #efc7c1;\n}\n.app-shell { font-family: 'DM Sans', sans-serif; color: var(--ink); background: var(--page); }\n.app-heading, .section-heading, .brand-name { font-family: 'Manrope', sans-serif; }\n.tabular { font-variant-numeric: tabular-nums; }\n.nav-item { min-height: 46px; }\n.nav-item i, .icon-18 { width: 18px; height: 18px; font-size: 18px; line-height: 1; }\n.metric { border-right: 1px solid var(--line); }\n.metric:last-child { border-right: 0; }\n.urgent-panel { background: var(--urgent-soft); border-color: var(--urgent-line); }\n@media (max-width: 760px) {\n  .app-header-main { align-items: flex-start; flex-direction: column; gap: 16px; }\n  .app-header-cta { width: 100%; }\n  .main-navigation { overflow-x: auto; scrollbar-width: none; }\n  .main-navigation::-webkit-scrollbar { display: none; }\n  .nav-item { flex: 0 0 auto; min-width: max-content; }\n  .content-wrap { padding-left: 18px; padding-right: 18px; }\n  .page-title-row { align-items: flex-start; flex-direction: column; gap: 8px; }\n  .urgent-heading-row { align-items: flex-start; flex-direction: column; }\n  .urgent-meta { grid-template-columns: 1fr 1fr; }\n  .summary-grid { grid-template-columns: 1fr 1fr; row-gap: 18px; }\n  .metric:nth-child(2) { border-right: 0; }\n  .lower-grid { grid-template-columns: 1fr; gap: 34px; }\n  .recent-row { grid-template-columns: 1fr; gap: 8px; }\n  .recent-state { justify-self: start; }\n}\n@media (max-width: 420px) {\n  .urgent-meta { grid-template-columns: 1fr; gap: 12px; }\n  .brand-subtitle { display: none; }\n}\n</style>\n<div class=\"app-shell min-h-screen m-0\" data-kid=\"1\" data-name=\"app shell container\">\n    <header class=\"border-b border-[var(--line)] bg-white\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"content-wrap app-header-main mx-auto flex max-w-[1328px] items-center justify-between gap-8 px-10 pt-6 pb-5\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <div class=\"flex min-w-0 items-center gap-3.5\" data-kid=\"1-1-1-1\" data-name=\"branding container\">\n                <div aria-hidden=\"true\" class=\"grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--brand-navy)] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"ti ti-building-community text-[22px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"building community icon\" style=\"width:22px;height:22px;font-size:22px\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand text group\">\n                    <div class=\"brand-name text-[17px] font-bold tracking-[-0.03em] text-[var(--brand-navy)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name heading\">\n                        Manutenção predial\n                    </div>\n                    <div class=\"brand-subtitle mt-0.5 text-[13px] text-[var(--muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Central de Ocorrências\n                    </div>\n                </div>\n            </div>\n            <button class=\"app-header-cta inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-lg bg-[var(--brand-teal)] px-5 text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-1-1-2\" data-name=\"register occurrence button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-1-2-1\" data-name=\"plus icon\" style=\"width:17px;height:17px;font-size:17px\">\n                </i>\n                Registrar ocorrência\n            </button>\n        </div>\n        <nav aria-label=\"Navegação principal\" class=\"main-navigation content-wrap mx-auto flex max-w-[1328px] gap-1 px-10\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <button aria-current=\"page\" class=\"nav-item inline-flex items-center gap-2 border-b-[3px] border-[var(--brand-teal)] px-4 text-[14px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-1-2-1\" data-name=\"overview tab button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[var(--brand-teal)]\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                Visão geral\n            </button>\n            <button class=\"nav-item inline-flex items-center gap-2 border-b-[3px] border-transparent px-4 text-[14px] font-medium text-[var(--muted)]\" data-kid=\"1-1-2-2\" data-name=\"register tab button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-clipboard-plus\" data-kid=\"1-1-2-2-1\" data-name=\"clipboard plus icon\">\n                </i>\n                Registrar\n            </button>\n            <button class=\"nav-item inline-flex items-center gap-2 border-b-[3px] border-transparent px-4 text-[14px] font-medium text-[var(--muted)]\" data-kid=\"1-1-2-3\" data-name=\"occurrences tab button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-details\" data-kid=\"1-1-2-3-1\" data-name=\"list details icon\">\n                </i>\n                Ocorrências\n            </button>\n            <button class=\"nav-item inline-flex items-center gap-2 border-b-[3px] border-transparent px-4 text-[14px] font-medium text-[var(--muted)]\" data-kid=\"1-1-2-4\" data-name=\"tasks tab button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-tool\" data-kid=\"1-1-2-4-1\" data-name=\"tool icon\">\n                </i>\n                Tarefas\n            </button>\n        </nav>\n    </header>\n    <main class=\"content-wrap mx-auto max-w-[1328px] px-10 pt-9 pb-16\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"page-title-row mb-7 flex items-end justify-between gap-6\" data-kid=\"1-2-1\" data-name=\"page title row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading container\">\n                <h1 class=\"app-heading m-0 text-[32px] font-bold leading-tight tracking-[-0.045em] text-[var(--brand-navy)]\" data-kid=\"1-2-1-1-1\" data-name=\"main page heading\">\n                    Visão geral\n                </h1>\n                <p class=\"mt-2 mb-0 text-[15px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Ocorrências que pedem atenção e atividade recente da equipe.\n                </p>\n            </div>\n            <button class=\"inline-flex min-h-10 items-center gap-2 rounded-lg border border-[var(--line)] bg-white px-4 text-[13px] font-semibold text-[var(--brand-navy)]\" data-kid=\"1-2-1-2\" data-name=\"view history button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-search\" data-kid=\"1-2-1-2-1\" data-name=\"list search icon\" style=\"width:17px;height:17px;font-size:17px\">\n                </i>\n                Ver histórico\n            </button>\n        </div>\n        <section aria-labelledby=\"attention-title\" class=\"urgent-panel rounded-xl border px-6 py-5 md:px-7 md:py-6\" data-kid=\"1-2-2\" data-name=\"urgent attention panel\">\n            <div class=\"urgent-heading-row flex items-center justify-between gap-6\" data-kid=\"1-2-2-1\" data-name=\"urgent panel header row\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-1\" data-name=\"urgent heading container\">\n                    <span aria-hidden=\"true\" class=\"grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-[var(--urgent)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"urgent alert icon container\">\n                        <i class=\"ti ti-alert-triangle\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"alert triangle icon\" style=\"width:21px;height:21px;font-size:21px\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-1-1-2\" data-name=\"urgent heading text group\">\n                        <h2 class=\"section-heading m-0 text-[17px] font-bold tracking-[-0.02em] text-[var(--brand-navy)]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"urgent attention heading\" id=\"attention-title\">\n                            Precisa de atenção\n                        </h2>\n                        <p class=\"m-0 mt-1 text-[13px] font-medium text-[var(--urgent)]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"urgent occurrence count text\">\n                            1 ocorrência urgente em aberto\n                        </p>\n                    </div>\n                </div>\n                <span class=\"inline-flex min-h-8 items-center gap-2 rounded-full border border-[var(--urgent-line)] bg-white/80 px-3 text-[13px] font-bold text-[var(--urgent)]\" data-kid=\"1-2-2-1-2\" data-name=\"priority tag\">\n                    <i aria-hidden=\"true\" class=\"ti ti-bolt\" data-kid=\"1-2-2-1-2-1\" data-name=\"bolt icon\" style=\"width:15px;height:15px;font-size:15px\">\n                    </i>\n                    Prioridade: Urgente\n                </span>\n            </div>\n            <div class=\"mt-5 border-t border-[var(--urgent-line)] pt-5\" data-kid=\"1-2-2-2\" data-name=\"urgent details container\">\n                <div class=\"flex flex-wrap items-start justify-between gap-x-8 gap-y-4\" data-kid=\"1-2-2-2-1\" data-name=\"urgent issue summary row\">\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2-1-1\" data-name=\"urgent issue content\">\n                        <p class=\"mb-2 mt-0 text-[12px] font-bold uppercase tracking-[0.08em] text-[var(--urgent)]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"issue category label\">\n                            Elétrica\n                        </p>\n                        <h3 class=\"app-heading m-0 max-w-[900px] text-[22px] font-bold leading-[1.3] tracking-[-0.025em] text-[var(--brand-navy)]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"issue title heading\">\n                            Disjuntor do circuito 10 desarma ao ligar o chuveiro\n                        </h3>\n                        <p class=\"mb-0 mt-2 text-[14px] leading-6 text-[var(--ink)]\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"issue location address text\">\n                            Casa da Mãe Joana, nº 345\n                            <span class=\"mx-1 text-[#9aa5b1]\" data-kid=\"1-2-2-2-1-1-3-1\" data-name=\"address separator dot\">\n                                ·\n                            </span>\n                            Cavalada, Araranguá–SC\n                        </p>\n                    </div>\n                    <button class=\"inline-flex min-h-10 shrink-0 items-center gap-2 rounded-lg bg-[var(--brand-navy)] px-4 text-[13px] font-bold text-white\" data-kid=\"1-2-2-2-1-2\" data-name=\"view issue history button\" type=\"button\">\n                        Ver histórico\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"arrow up right icon\" style=\"width:16px;height:16px;font-size:16px\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"urgent-meta mt-5 grid grid-cols-4 gap-5 border-t border-[var(--urgent-line)] pt-4\" data-kid=\"1-2-2-2-2\" data-name=\"urgent meta grid\">\n                    <div data-kid=\"1-2-2-2-2-1\" data-name=\"progress status column\">\n                        <div class=\"text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"progress status label\">\n                            Andamento\n                        </div>\n                        <div class=\"mt-1.5 inline-flex items-center gap-2 text-[14px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"progress status value\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#c56b36]\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"progress status dot\">\n                            </span>\n                            Aberta\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-2\" data-name=\"responsible person column\">\n                        <div class=\"text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"responsible person label\">\n                            Responsável\n                        </div>\n                        <div class=\"mt-1.5 text-[14px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"responsible person value\">\n                            jefinho fófó\n                            <span class=\"font-medium text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"responsible role text\">\n                                · Eletricista\n                            </span>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-3\" data-name=\"due date column\">\n                        <div class=\"text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"due date label\">\n                            Prazo desejado\n                        </div>\n                        <div class=\"tabular mt-1.5 text-[14px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"due date value\">\n                            09 dez 2026\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-4\" data-name=\"registered date column\">\n                        <div class=\"text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"registered date label\">\n                            Registrada\n                        </div>\n                        <div class=\"tabular mt-1.5 text-[14px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"registered date value\">\n                            18 set 2026\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Resumo das ocorrências\" class=\"summary-grid mt-8 grid grid-cols-4 border-y border-[var(--line)] py-5\" data-kid=\"1-2-3\" data-name=\"summary statistics grid\">\n            <div class=\"metric px-5 first:pl-0\" data-kid=\"1-2-3-1\" data-name=\"total occurrences metric\">\n                <div class=\"tabular text-[28px] font-bold leading-none tracking-[-0.05em] text-[var(--brand-navy)]\" data-kid=\"1-2-3-1-1\" data-name=\"total occurrences count\">\n                    2\n                </div>\n                <div class=\"mt-2 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-2-3-1-2\" data-name=\"total occurrences label\">\n                    Total de ocorrências\n                </div>\n            </div>\n            <div class=\"metric px-5\" data-kid=\"1-2-3-2\" data-name=\"open occurrences metric\">\n                <div class=\"tabular text-[28px] font-bold leading-none tracking-[-0.05em] text-[var(--brand-navy)]\" data-kid=\"1-2-3-2-1\" data-name=\"open occurrences count\">\n                    2\n                </div>\n                <div class=\"mt-2 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-2-3-2-2\" data-name=\"open occurrences label\">\n                    Abertas\n                </div>\n            </div>\n            <div class=\"metric px-5\" data-kid=\"1-2-3-3\" data-name=\"urgent occurrences metric\">\n                <div class=\"tabular text-[28px] font-bold leading-none tracking-[-0.05em] text-[var(--urgent)]\" data-kid=\"1-2-3-3-1\" data-name=\"urgent occurrences count\">\n                    1\n                </div>\n                <div class=\"mt-2 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-2-3-3-2\" data-name=\"urgent occurrences label\">\n                    Urgente\n                </div>\n            </div>\n            <div class=\"metric px-5 last:pr-0\" data-kid=\"1-2-3-4\" data-name=\"resolved occurrences metric\">\n                <div class=\"tabular text-[28px] font-bold leading-none tracking-[-0.05em] text-[var(--brand-navy)]\" data-kid=\"1-2-3-4-1\" data-name=\"resolved occurrences count\">\n                    0\n                </div>\n                <div class=\"mt-2 text-[13px] font-medium text-[var(--muted)]\" data-kid=\"1-2-3-4-2\" data-name=\"resolved occurrences label\">\n                    Resolvidas\n                </div>\n            </div>\n        </section>\n        <div class=\"lower-grid mt-9 grid grid-cols-[minmax(0,1.65fr)_minmax(300px,0.85fr)] gap-16\" data-kid=\"1-2-4\" data-name=\"lower grid area\">\n            <section aria-labelledby=\"recent-title\" data-kid=\"1-2-4-1\" data-name=\"recent calls section\">\n                <div class=\"mb-3 flex items-baseline justify-between gap-4\" data-kid=\"1-2-4-1-1\" data-name=\"recent calls header\">\n                    <h2 class=\"section-heading m-0 text-[18px] font-bold tracking-[-0.025em] text-[var(--brand-navy)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"recent calls heading\" id=\"recent-title\">\n                        Chamados recentes\n                    </h2>\n                    <span class=\"text-[12px] font-medium text-[var(--muted)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"recent calls count\">\n                        2 registros\n                    </span>\n                </div>\n                <div class=\"border-t border-[var(--line)]\" data-kid=\"1-2-4-1-2\" data-name=\"recent calls list\">\n                    <article class=\"recent-row grid grid-cols-[minmax(0,1fr)_auto] items-start gap-5 border-b border-[var(--line)] py-5\" data-kid=\"1-2-4-1-2-1\" data-name=\"first recent call article\">\n                        <div class=\"min-w-0\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"recent call text content\">\n                            <div class=\"flex flex-wrap items-center gap-x-2 gap-y-1\" data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"recent call meta group\">\n                                <span class=\"text-[12px] font-bold uppercase tracking-[0.06em] text-[var(--urgent)]\" data-kid=\"1-2-4-1-2-1-1-1-1\" data-name=\"recent call category label\">\n                                    Elétrica\n                                </span>\n                                <span class=\"text-[#9aa5b1]\" data-kid=\"1-2-4-1-2-1-1-1-2\" data-name=\"meta separator dot\">\n                                    ·\n                                </span>\n                                <time class=\"tabular text-[12px] font-medium text-[var(--muted)]\" data-kid=\"1-2-4-1-2-1-1-1-3\" data-name=\"recent call time\">\n                                    18 set 2026\n                                </time>\n                            </div>\n                            <h3 class=\"m-0 mt-2 text-[15px] font-bold leading-6 text-[var(--brand-navy)]\" data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"recent call title\">\n                                Disjuntor do circuito 10 desarma ao ligar o chuveiro\n                            </h3>\n                            <p class=\"m-0 mt-1 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-1-2-1-1-3\" data-name=\"recent call address\">\n                                Casa da Mãe Joana, nº 345 · Cavalada, Araranguá–SC\n                            </p>\n                        </div>\n                        <div class=\"recent-state flex flex-wrap items-center justify-end gap-2 pt-1\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"recent call state container\">\n                            <span class=\"inline-flex items-center gap-1.5 text-[12px] font-bold text-[var(--urgent)]\" data-kid=\"1-2-4-1-2-1-2-1\" data-name=\"recent call priority label\">\n                                <span class=\"h-2 w-2 rounded-full bg-[var(--urgent)]\" data-kid=\"1-2-4-1-2-1-2-1-1\" data-name=\"recent call priority dot\">\n                                </span>\n                                Urgente\n                            </span>\n                            <span class=\"text-[#9aa5b1]\" data-kid=\"1-2-4-1-2-1-2-2\" data-name=\"state separator slash\">\n                                /\n                            </span>\n                            <span class=\"text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-4-1-2-1-2-3\" data-name=\"recent call status text\">\n                                Aberta\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"recent-row grid grid-cols-[minmax(0,1fr)_auto] items-start gap-5 border-b border-[var(--line)] py-5\" data-kid=\"1-2-4-1-2-2\" data-name=\"second recent call article\">\n                        <div class=\"min-w-0\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"recent call text content\">\n                            <div class=\"flex flex-wrap items-center gap-x-2 gap-y-1\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"recent call meta group\">\n                                <span class=\"text-[12px] font-bold uppercase tracking-[0.06em] text-[var(--brand-teal)]\" data-kid=\"1-2-4-1-2-2-1-1-1\" data-name=\"recent call category label\">\n                                    Hidráulica\n                                </span>\n                                <span class=\"text-[#9aa5b1]\" data-kid=\"1-2-4-1-2-2-1-1-2\" data-name=\"meta separator dot\">\n                                    ·\n                                </span>\n                                <time class=\"tabular text-[12px] font-medium text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-1-1-3\" data-name=\"recent call time\">\n                                    18 set 2026\n                                </time>\n                            </div>\n                            <h3 class=\"m-0 mt-2 text-[15px] font-bold leading-6 text-[var(--brand-navy)]\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"recent call title\">\n                                Inspeção preventiva realizada; sem ocorrências.\n                            </h3>\n                            <p class=\"m-0 mt-1 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-1-3\" data-name=\"recent call address\">\n                                Casa da Mãe Joana, nº 345 · Cavalada, Araranguá–SC\n                            </p>\n                        </div>\n                        <div class=\"recent-state flex flex-wrap items-center justify-end gap-2 pt-1\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"recent call state container\">\n                            <span class=\"text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"recent call priority label\">\n                                Normal\n                            </span>\n                            <span class=\"text-[#9aa5b1]\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"state separator slash\">\n                                /\n                            </span>\n                            <span class=\"text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-4-1-2-2-2-3\" data-name=\"recent call status text\">\n                                Aberta\n                            </span>\n                        </div>\n                    </article>\n                </div>\n            </section>\n            <aside aria-label=\"Frequência e recorrência\" class=\"pt-0\" data-kid=\"1-2-4-2\" data-name=\"frequency and signals aside\">\n                <section aria-labelledby=\"frequency-title\" data-kid=\"1-2-4-2-1\" data-name=\"frequency by location section\">\n                    <h2 class=\"section-heading m-0 text-[18px] font-bold tracking-[-0.025em] text-[var(--brand-navy)]\" data-kid=\"1-2-4-2-1-1\" data-name=\"frequency by location heading\" id=\"frequency-title\">\n                        Frequência por local\n                    </h2>\n                    <p class=\"mb-4 mt-1 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-2-1-2\" data-name=\"frequency by location description\">\n                        Ocorrências registradas por imóvel.\n                    </p>\n                    <div class=\"flex items-start justify-between gap-4 border-t border-[var(--line)] pt-4\" data-kid=\"1-2-4-2-1-3\" data-name=\"location record row\">\n                        <div class=\"min-w-0\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"location name container\">\n                            <div class=\"text-[14px] font-bold leading-5 text-[var(--brand-navy)]\" data-kid=\"1-2-4-2-1-3-1-1\" data-name=\"location name heading\">\n                                Casa da Mãe Joana, nº 345\n                            </div>\n                            <div class=\"mt-1 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-2-1-3-1-2\" data-name=\"location address text\">\n                                Cavalada, Araranguá–SC\n                            </div>\n                        </div>\n                        <div class=\"shrink-0 text-right\" data-kid=\"1-2-4-2-1-3-2\" data-name=\"location count container\">\n                            <span class=\"tabular text-[22px] font-bold leading-none text-[var(--brand-teal)]\" data-kid=\"1-2-4-2-1-3-2-1\" data-name=\"location count value\">\n                                2\n                            </span>\n                            <div class=\"mt-1 text-[11px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-4-2-1-3-2-2\" data-name=\"location count label\">\n                                registros\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"mt-4 h-1.5 overflow-hidden rounded-full bg-[#e5ecec]\" data-kid=\"1-2-4-2-1-4\" data-name=\"location progress bar track\">\n                        <div class=\"h-full w-full rounded-full bg-[var(--brand-teal)]\" data-kid=\"1-2-4-2-1-4-1\" data-name=\"location progress bar fill\">\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"signals-title\" class=\"mt-7 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-4-2-2\" data-name=\"signals section\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-4-2-2-1\" data-name=\"signals header group\">\n                        <span aria-hidden=\"true\" class=\"grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#e9f2f0] text-[var(--brand-teal)]\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"signals icon container\">\n                            <i class=\"ti ti-radar-2\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"radar icon\" style=\"width:17px;height:17px;font-size:17px\">\n                            </i>\n                        </span>\n                        <h2 class=\"section-heading m-0 text-[15px] font-bold text-[var(--brand-navy)]\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"signals section heading\" id=\"signals-title\">\n                            Sinais para investigar\n                        </h2>\n                    </div>\n                    <p class=\"mb-0 mt-2 pl-[42px] text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-2-2-2\" data-name=\"signals empty state text\">\n                        Nenhum padrão repetitivo identificado ainda.\n                    </p>\n                </section>\n            </aside>\n        </div>\n    </main>\n</div>\n",
