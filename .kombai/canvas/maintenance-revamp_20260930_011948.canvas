      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\nbody { font-family: \"DM Sans\", sans-serif; }\n.app-shell { max-width: 1320px; margin: 0 auto; padding: 28px 44px 64px; }\n.app-nav { display: flex; align-items: center; gap: 8px; }\n.nav-item { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 0 17px; color: #43566a; text-decoration: none; white-space: nowrap; }\n.nav-item.active { color: #0f766e; background: #e4f3ef; font-weight: 700; }\n.header-actions { display: flex; align-items: center; gap: 10px; }\n.content-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, .85fr); gap: 20px; }\n.lower-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 36px; }\n@media (max-width: 800px) {\n  .app-shell { padding: 16px 16px 40px; }\n  .app-topbar { align-items: flex-start; flex-wrap: wrap; gap: 16px; }\n  .app-nav { width: 100%; overflow-x: auto; padding-bottom: 3px; }\n  .nav-item { min-height: 46px; padding: 0 12px; }\n  .header-actions { width: 100%; display: grid; grid-template-columns: 1fr; }\n  .content-grid, .lower-grid { grid-template-columns: 1fr; }\n  .mobile-priority { order: -1; }\n}\n</style>\n<div class=\"min-h-screen bg-[#f2f7f5] text-[#172b3c]\" data-kid=\"1\" data-name=\"page background container\">\n    <div class=\"app-shell\" data-kid=\"1-1\" data-name=\"app shell container\">\n        <header class=\"app-topbar flex items-center justify-between gap-8 border-b border-[#d9e5e1] pb-5\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"app identity logo container\">\n                <span aria-hidden=\"true\" class=\"grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#172554] text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"building icon\">\n                    <i class=\"bi bi-building\" data-kid=\"1-1-1-1-1-1\" data-name=\"building icon graphic\" style=\"color:#ffffff;width:21px;height:21px;line-height:1\">\n                    </i>\n                </span>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"identity text group\">\n                    <p class=\"m-0 font-[Manrope] text-[17px] font-extrabold tracking-[-0.03em] text-[#172554]\" data-kid=\"1-1-1-1-2-1\" data-name=\"app title\">\n                        Gestão Predial\n                    </p>\n                    <p class=\"m-0 mt-0.5 text-[13px] font-medium text-[#5d6e7c]\" data-kid=\"1-1-1-1-2-2\" data-name=\"app subtitle\">\n                        Central de ocorrências\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"Navegação principal\" class=\"app-nav rounded-xl border border-[#d8e5e1] bg-white p-1\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a aria-current=\"page\" class=\"nav-item active rounded-lg\" data-kid=\"1-1-1-2-1\" data-name=\"overview nav link\" href=\"#\">\n                    <span class=\"text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"overview icon container\">\n                        <i class=\"bi bi-grid-1x2-fill\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"grid icon\" style=\"color:#0f766e;width:18px;height:18px;line-height:1\">\n                        </i>\n                    </span>\n                    Visão geral\n                </a>\n                <a class=\"nav-item rounded-lg\" data-kid=\"1-1-1-2-2\" data-name=\"register nav link\" href=\"#\">\n                    <span class=\"text-lg\" data-kid=\"1-1-1-2-2-1\" data-name=\"register icon container\">\n                        <i class=\"bi bi-clipboard2-plus\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"clipboard icon\" style=\"color:#526779;width:18px;height:18px;line-height:1\">\n                        </i>\n                    </span>\n                    Registrar\n                </a>\n                <a class=\"nav-item rounded-lg\" data-kid=\"1-1-1-2-3\" data-name=\"occurrences nav link\" href=\"#\">\n                    <span class=\"text-lg\" data-kid=\"1-1-1-2-3-1\" data-name=\"occurrences icon container\">\n                        <i class=\"bi bi-journal-text\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"journal icon\" style=\"color:#526779;width:18px;height:18px;line-height:1\">\n                        </i>\n                    </span>\n                    Ocorrências\n                </a>\n                <a class=\"nav-item rounded-lg\" data-kid=\"1-1-1-2-4\" data-name=\"tasks nav link\" href=\"#\">\n                    <span class=\"text-lg\" data-kid=\"1-1-1-2-4-1\" data-name=\"tasks icon container\">\n                        <i class=\"bi bi-list-task\" data-kid=\"1-1-1-2-4-1-1\" data-name=\"list task icon\" style=\"color:#526779;width:18px;height:18px;line-height:1\">\n                        </i>\n                    </span>\n                    Tarefas\n                </a>\n            </nav>\n        </header>\n        <main class=\"pt-8\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <section class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"1-1-2-1\" data-name=\"header actions section\">\n                <div class=\"max-w-2xl\" data-kid=\"1-1-2-1-1\" data-name=\"page headline container\">\n                    <h1 class=\"m-0 font-[Manrope] text-[34px] font-extrabold leading-tight tracking-[-0.045em] text-[#172554]\" data-kid=\"1-1-2-1-1-1\" data-name=\"page title\">\n                        Visão geral\n                    </h1>\n                    <p class=\"m-0 mt-2 text-[16px] leading-6 text-[#526779]\" data-kid=\"1-1-2-1-1-2\" data-name=\"page description\">\n                        Acompanhe o que está em aberto e retome o trabalho que precisa de encaminhamento.\n                    </p>\n                </div>\n                <div class=\"header-actions\" data-kid=\"1-1-2-1-2\" data-name=\"action buttons container\">\n                    <a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-[#0f766e] px-5 text-[15px] font-bold text-white shadow-sm no-underline\" data-kid=\"1-1-2-1-2-1\" data-name=\"register occurrence button\" href=\"#\">\n                        <span class=\"text-lg\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"plus icon container\">\n                            <i class=\"bi bi-plus-lg\" data-kid=\"1-1-2-1-2-1-1-1\" data-name=\"plus icon\" style=\"color:#ffffff;width:17px;height:17px;line-height:1\">\n                            </i>\n                        </span>\n                        Registrar ocorrência\n                    </a>\n                    <a class=\"inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-[#c7d8d3] bg-white px-5 text-[15px] font-bold text-[#172554] no-underline\" data-kid=\"1-1-2-1-2-2\" data-name=\"resume tasks button\" href=\"#\">\n                        Retomar tarefas\n                        <span class=\"rounded-full bg-[#e8f2ef] px-2 py-0.5 text-[13px] font-bold text-[#0f766e]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"pending tasks count badge\" data-reason=\"number replaced by task count from system state\">\n                            2\n                        </span>\n                        <span class=\"text-lg\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"arrow right icon container\">\n                            <i class=\"bi bi-arrow-right\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"arrow right icon\" style=\"color:#0f766e;width:18px;height:18px;line-height:1\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n            </section>\n            <section aria-label=\"Trabalho pendente\" class=\"content-grid mt-8\" data-kid=\"1-1-2-2\" data-name=\"work status section\">\n                <div class=\"rounded-2xl border border-[#d7e2de] bg-white p-6\" data-kid=\"1-1-2-2-1\" data-name=\"pending work card\">\n                    <div class=\"mb-5 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-2-2-1-1\" data-name=\"pending work header\">\n                        <div data-kid=\"1-1-2-2-1-1-1\" data-name=\"pending work title\">\n                            <h2 class=\"m-0 font-[Manrope] text-[20px] font-bold tracking-[-0.025em] text-[#172554]\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"pending work card heading\">\n                                Precisa de acompanhamento\n                            </h2>\n                            <p class=\"m-0 mt-1 text-[14px] text-[#5c6e7c]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"pending work card subtext\">\n                                Ocorrência urgente aberta\n                            </p>\n                        </div>\n                        <a class=\"inline-flex items-center gap-1 text-[14px] font-bold text-[#0f766e] no-underline\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"view tasks link\" href=\"#\">\n                            Ver fila de tarefas\n                            <span class=\"text-lg\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"arrow up-right icon container\">\n                                <i class=\"bi bi-arrow-up-right\" data-kid=\"1-1-2-2-1-1-2-1-1\" data-name=\"arrow up-right icon\" style=\"color:#0f766e;width:16px;height:16px;line-height:1\">\n                                </i>\n                            </span>\n                        </a>\n                    </div>\n                    <article class=\"rounded-xl border border-[#f0d6b4] bg-[#fffaf2] p-5\" data-kid=\"1-1-2-2-1-2\" data-name=\"urgent occurrence article\">\n                        <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"occurrence metadata tags\">\n                            <span class=\"inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.06em] text-[#a3432b]\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"priority tag\">\n                                <span class=\"h-2.5 w-2.5 rounded-full bg-[#bd4a31]\" data-kid=\"1-1-2-2-1-2-1-1-1\" data-name=\"priority indicator dot\">\n                                </span>\n                                Prioridade · Urgente\n                            </span>\n                            <span class=\"inline-flex items-center gap-2 border-l border-[#e5d4c0] pl-4 text-[13px] font-semibold text-[#425568]\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"status tag\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#64748b]\" data-kid=\"1-1-2-2-1-2-1-2-1\" data-name=\"status indicator dot\">\n                                </span>\n                                Andamento · Aberta\n                            </span>\n                        </div>\n                        <h3 class=\"m-0 mt-4 max-w-3xl font-[Manrope] text-[22px] font-bold leading-[1.35] tracking-[-0.03em] text-[#172554]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"occurrence title\">\n                            Disjuntor do circuito 10 desarma quando o chuveiro é ligado\n                        </h3>\n                        <p class=\"m-0 mt-2 flex items-start gap-2 text-[14px] leading-5 text-[#526779]\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"occurrence location description\">\n                            <span class=\"mt-0.5 text-base\" data-kid=\"1-1-2-2-1-2-3-1\" data-name=\"location icon container\">\n                                <i class=\"bi bi-geo-alt\" data-kid=\"1-1-2-2-1-2-3-1-1\" data-name=\"location icon\" style=\"color:#0f766e;width:15px;height:15px;line-height:1\">\n                                </i>\n                            </span>\n                            Casa da mãe Joana, nº 345 · Cavalada · Araranguá–SC\n                        </p>\n                        <div class=\"mt-5 g