      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n#dashboard-view { font-family: 'DM Sans', sans-serif; }\n#dashboard-view h1, #dashboard-view h2, #dashboard-view h3 { font-family: 'Manrope', sans-serif; }\n#main-nav { scrollbar-width: none; }\n#main-nav::-webkit-scrollbar { display: none; }\n@media (max-width: 760px) {\n  #dashboard-shell { padding-left: 18px; padding-right: 18px; }\n  #top-header { align-items: flex-start; flex-direction: column; }\n  #main-nav { gap: 8px; overflow-x: auto; margin-left: -18px; margin-right: -18px; padding-left: 18px; padding-right: 18px; }\n  #main-nav a { flex: 0 0 auto; }\n  #page-heading { align-items: flex-start; flex-direction: column; }\n  #summary-row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 18px; }\n  #main-content { grid-template-columns: 1fr; }\n  #location-head { align-items: flex-start; flex-direction: column; }\n  #record-row { align-items: flex-start; flex-direction: column; }\n  #record-status { align-self: flex-start; }\n}\n</style>\n<div class=\"min-h-screen bg-[#f5f8fa] text-[#18283d]\" data-kid=\"1\" id=\"dashboard-view\">\n    <header class=\"mx-auto max-w-[1320px] px-10 pt-7\" data-kid=\"1-1\" id=\"dashboard-shell\">\n        <div class=\"flex items-center justify-between gap-8 border-b border-[#dbe4e8] pb-5\" data-kid=\"1-1-1\" id=\"top-header\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div class=\"grid h-11 w-11 place-items-center rounded-xl bg-[#172554] text-white\" data-kid=\"1-1-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-building-community text-[23px] leading-none\" data-kid=\"1-1-1-1-1-1\" style=\"width:23px;height:23px;color:#fff\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"m-0 text-[15px] font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-1-1-1-2-1\">\n                        Gestão Predial\n                    </p>\n                    <p class=\"m-0 mt-0.5 text-[12px] font-medium text-[#617286]\" data-kid=\"1-1-1-1-2-2\">\n                        Central de ocorrências\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-2\">\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#c9e4dc] bg-[#eef8f4] px-3 py-2 text-[13px] font-semibold text-[#146b57]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1\" data-name=\"synchronization status label\" data-reason=\"text and color indicator replaced by synchronization status script\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#16856d]\" data-kid=\"1-1-1-2-1-1\" data-name=\"synchronization status indicator dot\">\n                    </span>\n                    Sincronizado\n                </span>\n                <button class=\"inline-flex items-center gap-2 rounded-lg bg-[#0f766e] px-4 py-3 text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-1-1-2-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus text-[17px] leading-none\" data-kid=\"1-1-1-2-2-1\" style=\"width:17px;height:17px;color:#fff\">\n                    </i>\n                    Nova ocorrência\n                </button>\n            </div>\n        </div>\n        <nav aria-label=\"Navegação principal\" class=\"flex items-center gap-2 border-b border-[#dbe4e8] py-3\" data-kid=\"1-1-2\" id=\"main-nav\">\n            <a aria-current=\"page\" class=\"inline-flex items-center gap-2 rounded-lg bg-[#172554] px-4 py-2.5 text-[13px] font-semibold text-white\" data-kid=\"1-1-2-1\" href=\"#visao-geral\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[17px] leading-none\" data-kid=\"1-1-2-1-1\" style=\"width:17px;height:17px;color:#fff\">\n                </i>\n                Visão geral\n            </a>\n            <a class=\"inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-[13px] font-semibold text-[#43546a]\" data-kid=\"1-1-2-2\" href=\"#registrar\">\n                <i aria-hidden=\"true\" class=\"ti ti-plus text-[17px] leading-none\" data-kid=\"1-1-2-2-1\" style=\"width:17px;height:17px;color:#43546a\">\n                </i>\n                Registrar\n            </a>\n            <a class=\"inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-[13px] font-semibold text-[#43546a]\" data-kid=\"1-1-2-3\" href=\"#ocorrencias\">\n                <i aria-hidden=\"true\" class=\"ti ti-list-details text-[17px] leading-none\" data-kid=\"1-1-2-3-1\" style=\"width:17px;height:17px;color:#43546a\">\n                </i>\n                Ocorrências\n            </a>\n            <a class=\"inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-[13px] font-semibold text-[#43546a]\" data-kid=\"1-1-2-4\" href=\"#tarefas\">\n                <i aria-hidden=\"true\" class=\"ti ti-checklist text-[17px] leading-none\" data-kid=\"1-1-2-4-1\" style=\"width:17px;height:17px;color:#43546a\">\n                </i>\n                Tarefas\n            </a>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-[1320px] px-10 pb-14 pt-9\" data-kid=\"1-2\" id=\"dashboard-shell\">\n        <section class=\"mb-8 flex items-end justify-between gap-6\" data-kid=\"1-2-1\" id=\"page-heading\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"m-0 text-[34px] font-extrabold leading-tight tracking-[-0.04em] text-[#172554]\" data-kid=\"1-2-1-1-1\">\n                    Visão geral\n                </h1>\n                <p class=\"mb-0 mt-2 text-[15px] text-[#5b6b7d]\" data-kid=\"1-2-1-1-2\">\n                    Acompanhe os registros por local e encontre o que precisa de atenção.\n                </p>\n            </div>\n            <a class=\"inline-flex items-center gap-2 rounded-lg border border-[#b9cbc9] bg-white px-4 py-3 text-[14px] font-bold text-[#145f5a]\" data-kid=\"1-2-1-2\" href=\"#registrar\">\n                <i aria-hidden=\"true\" class=\"ti ti-file-plus text-[18px] leading-none\" data-kid=\"1-2-1-2-1\" style=\"width:18px;height:18px;color:#145f5a\">\n                </i>\n                Registrar ocorrência\n            </a>\n        </section>\n        <section aria-label=\"Resumo das ocorrências\" class=\"mb-9 grid grid-cols-4 divide-x divide-[#dbe4e8] rounded-xl border border-[#dbe4e8] bg-white px-2 py-5\" data-kid=\"1-2-2\" id=\"summary-row\">\n            <div class=\"px-5\" data-kid=\"1-2-2-1\">\n                <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.08em] text-[#66778a]\" data-kid=\"1-2-2-1-1\">\n                    Total\n                </p>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-2-1-2\">\n                    <strong class=\"font-[Manrope] text-[29px] font-extrabold leading-none text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1\" data-name=\"total occurrences counter\" data-reason=\"number text dynamically updated by system\">\n                        2\n                    </strong>\n                    <span class=\"text-[13px] text-[#607186]\" data-kid=\"1-2-2-1-2-2\">\n                        ocorrências\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-5\" data-kid=\"1-2-2-2\">\n                <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.08em] text-[#66778a]\" data-kid=\"1-2-2-2-1\">\n                    Em aberto\n                </p>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-2-2-2\">\n                    <strong class=\"font-[Manrope] text-[29px] font-extrabold leading-none text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-1\" data-name=\"open occurrences counter\" data-reason=\"number text dynamically updated by system\">\n                        2\n                    </strong>\n                    <span class=\"text-[13px] text-[#607186]\" data-kid=\"1-2-2-2-2-2\">\n                        aguardando andamento\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-5\" data-kid=\"1-2-2-3\">\n                <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.08em] text-[#8f342b]\" data-kid=\"1-2-2-3-1\">\n                    Urgentes ativos\n                </p>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-2-3-2\">\n                    <strong class=\"font-[Manrope] text-[29px] font-extrabold leading-none text-[#b33a32]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1\" data-name=\"active urgent occurrences counter\" data-reason=\"number text dynamically updated by system\">\n                        1\n                    </strong>\n                    <span class=\"text-[13px] text-[#607186]\" data-kid=\"1-2-2-3-2-2\">\n                        chamado\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-5\" data-kid=\"1-2-2-4\">\n                <p class=\"m-0 text-[12px] font-semibold uppercase tracking-[0.08em] text-[#66778a]\" data-kid=\"1-2-2-4-1\">\n                    Resolvidas\n                </p>\n                <div class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-2-2-4-2\">\n                    <strong class=\"font-[Manrope] text-[29px] font-extrabold leading-none text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-2-2-4-2-1\" data-name=\"resolved occurrences counter\" data-reason=\"number text dynamically updated by system\">\n                        0\n                    </strong>\n                    <span class=\"text-[13px] text-[#607186]\" data-kid=\"1-2-2-4-2-2\">\n                        ocorrências\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid grid-cols-[minmax(0,1.85fr)_minmax(300px,0.9fr)] items-start gap-7\" data-kid=\"1-2-3\" id=\"main-content\">\n            <div data-kid=\"1-2-3-1\">\n                <div class=\"mb-4\" data-kid=\"1-2-3-1-1\" data-name=\"location records list header\">\n                    <h2 class=\"m-0 text-[22px] font-bold tracking-[-0.025em] text-[#172554]\" data-kid=\"1-2-3-1-1-1\" data-name=\"location records list title\">\n                        Locais com mais registros\n                    </h2>\n                    <p class=\"mb-0 mt-1.5 text-[14px] text-[#637386]\" data-kid=\"1-2-3-1-1-2\" data-name=\"location records list description\">\n                        Ocorrências agrupadas pelo endereço cadastrado.\n                    </p>\n                </div>\n                <article class=\"overflow-hidden rounded-xl border border-[#dbe4e8] bg-white\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex items-center justify-between gap-5 px-6 py-5\" data-kid=\"1-2-3-1-2-1\" id=\"location-head\">\n                        <div class=\"flex items-start gap-3.5\" data-kid=\"1-2-3-1-2-1-1\">\n                            <div class=\"mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-[#e9f4f2] text-[#0f766e]\" data-kid=\"1-2-3-1-2-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[20px] leading-none\" data-kid=\"1-2-3-1-2-1-1-1-1\" style=\"width:20px;height:20px;color:#0f766e\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-2-3-1-2-1-1-2\">\n                                <h3 class=\"m-0 text-[18px] font-bold leading-snug tracking-[-0.02em] text-[#172554]\" data-kid=\"1-2-3-1-2-1-1-2-1\">\n                                    Casa da Mãe Joana, nº 345\n                                </h3>\n                                <p class=\"mb-0 mt-1 text-[14px] text-[#637386]\" data-kid=\"1-2-3-1-2-1-1-2-2\">\n                                    Cavalada · Araranguá–SC\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"shrink-0 text-right\" data-kid=\"1-2-3-1-2-1-2\">\n                            <strong class=\"block font-[Manrope] text-[25px] font-extrabold leading-none text-[#172554]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"location records count\" data-reason=\"number text dynamically updated by system\">\n                                2\n                            </strong>\n                            <span class=\"mt-1 block text-[12px] font-semibold text-[#637386]\" data-kid=\"1-2-3-1-2-1-2-2\">\n                                registros\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"border-t border-[#e1e8ec]\" data-kid=\"1-2-3-1-2-2\">\n                        <article class=\"flex items-start justify-between gap-6 px-6 py-5\" data-kid=\"1-2-3-1-2-2-1\" id=\"record-row\">\n                            <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-3-1-2-2-1-1\">\n                                <div class=\"mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#fff0ee] text-[#b33a32]\" data-kid=\"1-2-3-1-2-2-1-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-bolt text-[19px] leading-none\" data-kid=\"1-2-3-1-2-2-1-1-1-1\" style=\"width:19px;height:19px;color:#b33a32\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-2-1-1-2\">\n                                    <div class=\"mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1\" data-kid=\"1-2-3-1-2-2-1-1-2-1\">\n                                        <span class=\"text-[12px] font-bold uppercase tracking-[0.08em] text-[#9b453e]\" data-kid=\"1-2-3-1-2-2-1-1-2-1-1\">\n                                            Elétrica\n                                        </span>\n                                        <span class=\"h-1 w-1 rounded-full bg-[#9aa8b7]\" data-kid=\"1-2-3-1-2-2-1-1-2-1-2\">\n                                        </span>\n                                        <span class=\"text-[12px] text-[#748397]\" data-kid=\"1-2-3-1-2-2-1-1-2-1-3\">\n                                            18 set 2026\n                                        </span>\n                                    </div>\n                                    <h3 class=\"m-0 text-[16px] font-bold leading-snug text-[#172554]\" data-kid=\"1-2-3-1-2-2-1-1-2-2\">\n                                        Disjuntor do circuito 10 desarma ao ligar o chuveiro\n                                    </h3>\n                                    <p class=\"mb-0 mt-2 text-[13px] leading-relaxed text-[#58697d]\" data-kid=\"1-2-3-1-2-2-1-1-2-3\">\n                                        Acionar eletricista para verificar · Jefinho Fófó\n                                    </p>\n                                    <p class=\"mb-0 mt-1 text-[13px] font-semibold text-[#58697d]\" data-kid=\"1-2-3-1-2-2-1-1-2-4\">\n                                        Prazo: 09 dez 2026\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 flex-col items-end gap-2 pt-0.5\" data-kid=\"1-2-3-1-2-2-1-2\" id=\"record-status\">\n                                <span class=\"inline-flex items-center gap-1.5 rounded-md bg-[#fff0ee] px-2.5 py-1.5 text-[12px] font-bold text-[#a53029]\" data-kid=\"1-2-3-1-2-2-1-2-1\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#c84239]\" data-kid=\"1-2-3-1-2-2-1-2-1-1\">\n                                    </span>\n                                    Urgente\n                                </span>\n                                <span class=\"inline-flex rounded-md border border-[#d8e1e7] px-2.5 py-1 text-[12px] font-semibold text-[#526275]\" data-kid=\"1-2-3-1-2-2-1-2-2\">\n                                    Aberta\n                                </span>\n                            </div>\n                        </article>\n                        <article class=\"flex items-start justify-between gap-6 border-t border-[#e7edf0] px-6 py-5\" data-kid=\"1-2-3-1-2-2-2\" id=\"record-row\">\n                            <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-3-1-2-2-2-1\">\n                                <div class=\"mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#edf5f4] text-[#21736d]\" data-kid=\"1-2-3-1-2-2-2-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-droplet text-[19px] leading-none\" data-kid=\"1-2-3-1-2-2-2-1-1-1\" style=\"width:19px;height:19px;color:#21736d\">\n                                    </i>\n                                </div>\n                                <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-2-2-1-2\">\n                                    <div class=\"mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1\" data-kid=\"1-2-3-1-2-2-2-1-2-1\">\n                                        <span class=\"text-[12px] font-bold uppercase tracking-[0.08em] text-[#39766f]\" data-kid=\"1-2-3-1-2-2-2-1-2-1-1\">\n                                            Hidráulica\n                                        </span>\n                                        <span class=\"h-1 w-1 rounded-full bg-[#9aa8b7]\" data-kid=\"1-2-3-1-2-2-2-1-2-1-2\">\n                                        </span>\n                                        <span class=\"text-[12px] text-[#748397]\" data-kid=\"1-2-3-1-2-2-2-1-2-1-3\">\n                                            18 set 2026\n                                        </span>\n                                    </div>\n                                    <h3 class=\"m-0 text-[16px] font-bold leading-snug text-[#172554]\" data-kid=\"1-2-3-1-2-2-2-1-2-2\">\n                                        Inspeção preventiva realizada. Sem ocorrências.\n                                    </h3>\n                                    <p class=\"mb-0 mt-2 text-[13px] leading-relaxed text-[#58697d]\" data-kid=\"1-2-3-1-2-2-2-1-2-3\">\n                                        Jefinho do Fófó\n                                    </p>\n                                    <p class=\"mb-0 mt-1 text-[13px] font-semibold text-[#58697d]\" data-kid=\"1-2-3-1-2-2-2-1-2-4\">\n                                        Prazo: 09 dez 2026\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex shrink-0 flex-col items-end gap-2 pt-0.5\" data-kid=\"1-2-3-1-2-2-2-2\" id=\"record-status\">\n                                <span class=\"inline-flex items-center gap-1.5 rounded-md bg-[#eef8f4] px-2.5 py-1.5 text-[12px] font-bold text-[#146b57]\" data-kid=\"1-2-3-1-2-2-2-2-1\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#16856d]\" data-kid=\"1-2-3-1-2-2-2-2-1-1\">\n                                    </span>\n                                    Normal\n                                </span>\n                                <span class=\"inline-flex rounded-md border border-[#d8e1e7] px-2.5 py-1 text-[12px] font-semibold text-[#526275]\" data-kid=\"1-2-3-1-2-2-2-2-2\">\n                                    Aberta\n                                </span>\n                            </div>\n                        </article>\n                    </div>\n                </article>\n            </div>\n            <aside class=\"pt-0\" data-kid=\"1-2-3-2\">\n                <section class=\"rounded-xl border border-[#dbe4e8] bg-white px-5 py-5\" data-kid=\"1-2-3-2-1\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-3-2-1-1\">\n                        <div class=\"grid h-9 w-9 place-items-center rounded-lg bg-[#f1f5f7] text-[#4d6074]\" data-kid=\"1-2-3-2-1-1-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-repeat text-[19px] leading-none\" data-kid=\"1-2-3-2-1-1-1-1\" style=\"width:19px;height:19px;color:#4d6074\">\n                            </i>\n                        </div>\n                        <h2 class=\"m-0 text-[17px] font-bold tracking-[-0.02em] text-[#172554]\" data-kid=\"1-2-3-2-1-1-2\">\n                            Sinais para investigar\n                        </h2>\n                    </div>\n                    <div class=\"mt-5 border-t border-[#e4eaee] pt-4\" data-kid=\"1-2-3-2-1-2\">\n                        <p class=\"m-0 text-[14px] font-semibold leading-relaxed text-[#34465b]\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"investigation status message\" data-reason=\"text content dynamically replaced based on pattern analysis\">\n                            Nenhum padrão repetitivo identificado ainda.\n                        </p>\n                        <p class=\"mb-0 mt-2 text-[13px] leading-relaxed text-[#67788b]\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"investigation helper text\" data-reason=\"text content dynamically replaced based on pattern analysis\">\n                            A recorrência só aparece quando um mesmo tipo de problema se repete nos registros.\n                        </p>\n                    </div>\n                </section>\n                <div class=\"mt-5 flex items-start gap-3 px-1 text-[13px] leading-relaxed text-[#637386]\" data-kid=\"1-2-3-2-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle mt-0.5 text-[17px] leading-none\" data-kid=\"1-2-3-2-2-1\" style=\"width:17px;height:17px;color:#607487\">\n                    </i>\n                    <p class=\"m-0\" data-kid=\"1-2-3-2-2-2\">\n                        A prioridade e o andamento são mostrados em cada ocorrência, sem classificar o imóvel como urgente.\n                    </p>\n                </div>\n            </aside>\n        </section>\n    </main>\n</div>\n",
