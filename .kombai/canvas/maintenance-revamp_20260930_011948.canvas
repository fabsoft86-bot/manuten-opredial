    },
    "var_fec0701558f0": {
      "type": "variant",
      "label": "03 · Passagem de serviço — Tarefas",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--navy:#172554;--teal:#0f766e;--teal-light:#d9efeb;--canvas:#f4f7f8;--ink:#172437;--muted:#56677a;--line:#d9e1e6;--urgent:#b42318;--urgent-light:#fff3f1;--amber:#9a5a08;--amber-light:#fff7e8;--green:#16794c;--green-light:#e8f5ef;}\n.app-shell{font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--canvas);}\n.app-title,.page-title{font-family:'Manrope','DM Sans',sans-serif;}\n.icon{font-size:18px;line-height:1;color:currentColor;vertical-align:-2px;}\n.side-rail{width:250px;flex:0 0 250px;background:var(--navy);color:#fff;}\n.side-link{min-height:46px;color:#d3deed;}\n.side-link:hover{background:rgba(255,255,255,.07);}\n.side-link.active{background:#253b68;color:#fff;}\n.top-nav{display:none;}\n.task-columns{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(155px,.55fr) minmax(0,1fr);align-items:start;gap:22px;}\n.lane-head{min-height:55px;border-bottom:1px solid var(--line);}\n.work-item{border:1px solid var(--line);border-radius:14px;background:#fff;}\n.work-item.urgent{border-color:#edc8c2;background:linear-gradient(180deg,var(--urgent-light) 0 56px,#fff 56px);}\n.workflow-select{min-height:44px;border:1px solid #bac8d1;border-radius:8px;background-color:#fff;color:var(--ink);}\n@media(max-width:900px){.side-rail{display:none}.top-nav{display:flex}.app-main{padding-left:22px!important;padding-right:22px!important}.task-columns{grid-template-columns:1fr;gap:24px}.lane-head{min-height:0;padding-bottom:12px}.attention-lane{order:2}.routine-lane{order:3}.urgent-lane{order:1}}\n@media(max-width:520px){.app-main{padding:18px 15px 28px!important}.page-head{align-items:stretch!important;flex-direction:column!important}.page-head button{width:100%}.top-nav{overflow-x:auto;gap:4px}.top-nav button{flex:0 0 auto}.work-item{padding:16px!important}.detail-grid{grid-template-columns:1fr!important}.task-columns{gap:19px}}\n</style>\n<div class=\"app-shell min-h-screen\" data-kid=\"1\">\n    <div class=\"mx-auto flex min-h-screen max-w-[1600px]\" data-kid=\"1-1\">\n        <aside aria-label=\"Navegação principal\" class=\"side-rail flex min-h-screen flex-col px-5 py-7\" data-kid=\"1-1-1\">\n            <div class=\"mb-12 flex items-center gap-3 px-2\" data-kid=\"1-1-1-1\">\n                <div class=\"grid size-10 place-items-center rounded-xl bg-white/10 text-white\" data-kid=\"1-1-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-building-community icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"community building icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"app-title m-0 text-[15px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1-2-1\">\n                        Central de\n                    </p>\n                    <p class=\"app-title m-0 text-[15px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1-2-2\">\n                        Ocorrências\n                    </p>\n                </div>\n            </div>\n            <p class=\"mb-3 px-3 text-[11px] font-bold uppercase tracking-[.13em] text-slate-300/75\" data-kid=\"1-1-1-2\">\n                Operação\n            </p>\n            <nav aria-label=\"Seções\" class=\"flex flex-col gap-1\" data-kid=\"1-1-1-3\">\n                <button class=\"side-link flex w-full items-center gap-3 rounded-lg px-3 text-left text-[14px] font-semibold\" data-kid=\"1-1-1-3-1\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard icon\" data-kid=\"1-1-1-3-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    Visão geral\n                </button>\n                <button class=\"side-link flex w-full items-center gap-3 rounded-lg px-3 text-left text-[14px] font-semibold\" data-kid=\"1-1-1-3-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus icon\" data-kid=\"1-1-1-3-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Registrar\n                </button>\n                <button class=\"side-link flex w-full items-center gap-3 rounded-lg px-3 text-left text-[14px] font-semibold\" data-kid=\"1-1-1-3-3\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-clipboard-list icon\" data-kid=\"1-1-1-3-3-1\" data-name=\"clipboard list icon\">\n                    </i>\n                    Ocorrências\n                </button>\n                <button aria-current=\"page\" class=\"side-link active flex w-full items-center gap-3 rounded-lg px-3 text-left text-[14px] font-semibold\" data-kid=\"1-1-1-3-4\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-tool icon\" data-kid=\"1-1-1-3-4-1\" data-name=\"tool icon\">\n                    </i>\n                    Tarefas\n                </button>\n            </nav>\n            <div class=\"mt-auto border-t border-white/15 px-2 pt-5 text-[12px] leading-5 text-slate-300\" data-kid=\"1-1-1-4\">\n                Fila de trabalho\n                <br data-kid=\"1-1-1-4-1\"/>\n                <span class=\"text-slate-400\" data-kid=\"1-1-1-4-2\">\n                    Ocorrências ainda não resolvidas\n                </span>\n            </div>\n        </aside>\n        <main aria-labelledby=\"pageTitle\" class=\"app-main min-w-0 flex-1 px-10 py-8 lg:px-12\" data-kid=\"1-1-2\">\n            <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-1-2-1\">\n                <div aria-label=\"Navegação principal\" class=\"top-nav mb-8 rounded-xl border border-[var(--line)] bg-white p-1\" data-kid=\"1-1-2-1-1\" role=\"navigation\">\n                    <button class=\"min-h-11 rounded-lg px-4 text-sm font-semibold text-slate-600\" data-kid=\"1-1-2-1-1-1\" type=\"button\">\n                        Visão geral\n                    </button>\n                    <button class=\"min-h-11 rounded-lg px-4 text-sm font-semibold text-slate-600\" data-kid=\"1-1-2-1-1-2\" type=\"button\">\n                        Registrar\n                    </button>\n                    <button class=\"min-h-11 rounded-lg px-4 text-sm font-semibold text-slate-600\" data-kid=\"1-1-2-1-1-3\" type=\"button\">\n                        Ocorrências\n                    </button>\n                    <button aria-current=\"page\" class=\"min-h-11 rounded-lg bg-[var(--teal)] px-4 text-sm font-bold text-white\" data-kid=\"1-1-2-1-1-4\" type=\"button\">\n                        Tarefas\n                    </button>\n                </div>\n                <header class=\"page-head mb-8 flex items-end justify-between gap-6\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-1\">\n                        <h1 class=\"page-title mb-2 text-[32px] font-extrabold leading-tight tracking-[-.035em] text-[var(--navy)] sm:text-[36px]\" data-kid=\"1-1-2-1-2-1-1\" id=\"pageTitle\">\n                            Fila de trabalho\n                        </h1>\n                        <p class=\"m-0 max-w-[650px] text-[15px] leading-6 text-[var(--muted)]\" data-kid=\"1-1-2-1-2-1-2\">\n                            Acompanhe o que ainda precisa ser resolvido. O histórico completo fica em\n                            <strong class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-2-1-2-1\">\n                                Ocorrências\n                            </strong>\n                            .\n                        </p>\n                    </div>\n                    <button class=\"inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-lg bg-[var(--teal)] px-5 text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-1-2-1-2-2\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus icon text-white\" data-kid=\"1-1-2-1-2-2-1\">\n                        </i>\n                        Registrar ocorrência\n                    </button>\n                </header>\n                <div class=\"mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-[var(--line)] pb-5\" data-kid=\"1-1-2-1-3\">\n                    <span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--navy)]\" data-kid=\"1-1-2-1-3-1\">\n                        <span class=\"grid size-7 place-items-center rounded-full bg-[var(--teal-light)] text-[13px] font-extrabold text-[var(--teal)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"open occurrences count badge\" data-reason=\"count value rendered from data source\">\n                            2\n                        </span>\n                        ocorrências em aberto\n                    </span>\n                    <span class=\"hidden h-5 w-px bg-[var(--line)] sm:block\" data-kid=\"1-1-2-1-3-2\">\n                    </span>\n                    <span class=\"text-[13px] text-[var(--muted)]\" data-kid=\"1-1-2-1-3-3\">\n                        Organizadas pela prioridade registrada em cada ocorrência\n                    </span>\n                </div>\n                <section aria-label=\"Ocorrências pendentes por prioridade\" class=\"task-columns\" data-kid=\"1-1-2-1-4\">\n                    <section aria-labelledby=\"urgentHeading\" class=\"urgent-lane min-w-0\" data-kid=\"1-1-2-1-4-1\">\n                        <header class=\"lane-head mb-4 flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-4-1-1\">\n                            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-1-4-1-1-1\">\n                                <span class=\"size-2.5 rounded-full bg-[var(--urgent)]\" data-kid=\"1-1-2-1-4-1-1-1-1\" data-name=\"high priority dot indicator\">\n                                </span>\n                                <h2 class=\"m-0 text-[17px] font-bold text-[var(--navy)]\" data-kid=\"1-1-2-1-4-1-1-1-2\" id=\"urgentHeading\">\n                                    Prioridade alta\n                                </h2>\n                            </div>\n                            <span class=\"rounded-full bg-[var(--urgent-light)] px-2.5 py-1 text-[12px] font-bold text-[var(--urgent)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-1-1-2\" data-name=\"high priority count badge\" data-reason=\"count value rendered from data source\">\n                                1 ocorrência\n                            </span>\n                        </header>\n                        <article aria-label=\"Ocorrência urgente em andamento\" class=\"work-item urgent p-5\" data-kid=\"1-1-2-1-4-1-2\">\n                            <div class=\"mb-4 flex flex-wrap items-center gap-2\" data-kid=\"1-1-2-1-4-1-2-1\">\n                                <span class=\"inline-flex items-center gap-1.5 rounded-md bg-[var(--urgent)] px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-[.06em] text-white\" data-kid=\"1-1-2-1-4-1-2-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-alert-triangle icon text-[14px] text-white\" data-kid=\"1-1-2-1-4-1-2-1-1-1\" data-name=\"urgent alert triangle icon\">\n                                    </i>\n                                    Urgente\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[var(--muted)]\" data-kid=\"1-1-2-1-4-1-2-1-2\">\n                                    Elétrica\n                                </span>\n                            </div>\n                            <h3 class=\"mb-2 text-[19px] font-bold leading-snug text-[var(--navy)]\" data-kid=\"1-1-2-1-4-1-2-2\">\n                                Circuito 10 · chuveiro\n                            </h3>\n                            <p class=\"mb-4 text-[14px] leading-[1.55] text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-2-3\">\n                                Disjuntor do circuito 10 desarma quando o chuveiro é ligado.\n                            </p>\n                            <div class=\"mb-5 flex items-start gap-2 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-1-2-1-4-1-2-4\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin icon mt-0.5 shrink-0 text-[16px] text-[var(--teal)]\" data-kid=\"1-1-2-1-4-1-2-4-1\" data-name=\"location pin icon\">\n                                </i>\n                                <span data-kid=\"1-1-2-1-4-1-2-4-2\">\n                                    casa da mae joana, numero 345, bairro cavalada, ararangua- SC\n                                </span>\n                            </div>\n                            <div class=\"detail-grid mb-5 grid grid-cols-2 gap-3 border-y border-[#e9edef] py-3\" data-kid=\"1-1-2-1-4-1-2-5\">\n                                <div data-kid=\"1-1-2-1-4-1-2-5-1\">\n                                    <p class=\"mb-1 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-1-2-1-4-1-2-5-1-1\">\n                                        Responsável\n                                    </p>\n                                    <p class=\"m-0 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-2-5-1-2\">\n                                        jefinho fófó\n                                    </p>\n                                </div>\n                                <div data-kid=\"1-1-2-1-4-1-2-5-2\">\n                                    <p class=\"mb-1 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-1-2-1-4-1-2-5-2-1\">\n                                        Prazo\n                                    </p>\n                                    <p class=\"m-0 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-4-1-2-5-2-2\">\n                                        09 dez 2026\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-2-1-4-1-2-6\">\n                                <label class=\"text-[12px] font-bold text-[var(--muted)]\" data-kid=\"1-1-2-1-4-1-2-6-1\" for=\"urgent-status\">\n                                    Andamento\n                                </label>\n                                <select aria-label=\"Atualizar andamento da ocorrência urgente\" class=\"workflow-select min-w-[190px] px-3 text-[14px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-1-2-6-2\" data-name=\"urgent occurrence status dropdown\" data-reason=\"selected value reflects current database state\" id=\"urgent-status\">\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-1\" selected=\"\" value=\"aberto\">\n                                        Aberta\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-2\" value=\"triagem\">\n                                        Em triagem\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-3\" value=\"atribuido\">\n                                        Atribuída\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-4\" value=\"execucao\">\n                                        Em execução\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-5\" value=\"material\">\n                                        Aguardando material\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-1-2-6-2-6\" value=\"resolvido\">\n                                        Resolvida\n                                    </option>\n                                </select>\n                            </div>\n                        </article>\n                    </section>\n                    <section aria-labelledby=\"attentionHeading\" class=\"attention-lane min-w-0\" data-kid=\"1-1-2-1-4-2\">\n                        <header class=\"lane-head mb-4 flex items-center justify-between gap-2\" data-kid=\"1-1-2-1-4-2-1\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-4-2-1-1\">\n                                <span class=\"size-2.5 rounded-full bg-[#d28a19]\" data-kid=\"1-1-2-1-4-2-1-1-1\" data-name=\"attention priority dot indicator\">\n                                </span>\n                                <h2 class=\"m-0 text-[16px] font-bold text-[var(--navy)]\" data-kid=\"1-1-2-1-4-2-1-1-2\" id=\"attentionHeading\">\n                                    Atenção\n                                </h2>\n                            </div>\n                            <span class=\"text-[12px] font-bold text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2-1-2\" data-name=\"attention count badge\" data-reason=\"count value rendered from data source\">\n                                0\n                            </span>\n                        </header>\n                        <p class=\"m-0 border-l-2 border-[#e8c98c] pl-3 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-1-2-1-4-2-2\">\n                            Nenhuma ocorrência nesta prioridade.\n                        </p>\n                    </section>\n                    <section aria-labelledby=\"routineHeading\" class=\"routine-lane min-w-0\" data-kid=\"1-1-2-1-4-3\">\n                        <header class=\"lane-head mb-4 flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-4-3-1\">\n                            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-1-4-3-1-1\">\n                                <span class=\"size-2.5 rounded-full bg-[var(--green)]\" data-kid=\"1-1-2-1-4-3-1-1-1\" data-name=\"routine priority dot indicator\">\n                                </span>\n                                <h2 class=\"m-0 text-[17px] font-bold text-[var(--navy)]\" data-kid=\"1-1-2-1-4-3-1-1-2\" id=\"routineHeading\">\n                                    Rotina\n                                </h2>\n                            </div>\n                            <span class=\"rounded-full bg-[var(--green-light)] px-2.5 py-1 text-[12px] font-bold text-[var(--green)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-3-1-2\" data-name=\"routine priority count badge\" data-reason=\"count value rendered from data source\">\n                                1 ocorrência\n                            </span>\n                        </header>\n                        <article aria-label=\"Ocorrência hidráulica de prioridade normal\" class=\"work-item p-5\" data-kid=\"1-1-2-1-4-3-2\">\n                            <div class=\"mb-4 flex flex-wrap items-center gap-2\" data-kid=\"1-1-2-1-4-3-2-1\">\n                                <span class=\"inline-flex items-center gap-1.5 rounded-md bg-[var(--green-light)] px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-[.06em] text-[var(--green)]\" data-kid=\"1-1-2-1-4-3-2-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-check icon text-[14px] text-[var(--green)]\" data-kid=\"1-1-2-1-4-3-2-1-1-1\" data-name=\"normal checkmark icon\">\n                                    </i>\n                                    Normal\n                                </span>\n                                <span class=\"text-[13px] font-semibold text-[var(--muted)]\" data-kid=\"1-1-2-1-4-3-2-1-2\">\n                                    Hidráulica\n                                </span>\n                            </div>\n                            <h3 class=\"mb-2 text-[18px] font-bold leading-snug text-[var(--navy)]\" data-kid=\"1-1-2-1-4-3-2-2\">\n                                Inspeção preventiva\n                            </h3>\n                            <p class=\"mb-4 text-[14px] leading-[1.55] text-[var(--ink)]\" data-kid=\"1-1-2-1-4-3-2-3\">\n                                Sem ocorrências reportadas na inspeção.\n                            </p>\n                            <div class=\"mb-5 flex items-start gap-2 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-1-2-1-4-3-2-4\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin icon mt-0.5 shrink-0 text-[16px] text-[var(--teal)]\" data-kid=\"1-1-2-1-4-3-2-4-1\" data-name=\"location pin icon\">\n                                </i>\n                                <span data-kid=\"1-1-2-1-4-3-2-4-2\">\n                                    casa da mae joana, numero 345, bairro cavalada, ararangua- SC\n                                </span>\n                            </div>\n                            <div class=\"mb-5 grid grid-cols-1 gap-3 border-y border-[#e9edef] py-3\" data-kid=\"1-1-2-1-4-3-2-5\">\n                                <div data-kid=\"1-1-2-1-4-3-2-5-1\">\n                                    <p class=\"mb-1 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-1-2-1-4-3-2-5-1-1\">\n                                        Responsável\n                                    </p>\n                                    <p class=\"m-0 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-4-3-2-5-1-2\">\n                                        jefinho do fófó\n                                    </p>\n                                </div>\n                                <div data-kid=\"1-1-2-1-4-3-2-5-2\">\n                                    <p class=\"mb-1 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-1-2-1-4-3-2-5-2-1\">\n                                        Prazo\n                                    </p>\n                                    <p class=\"m-0 text-[14px] font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-4-3-2-5-2-2\">\n                                        09 dez 2026\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-2-1-4-3-2-6\">\n                                <label class=\"text-[12px] font-bold text-[var(--muted)]\" data-kid=\"1-1-2-1-4-3-2-6-1\" for=\"routine-status\">\n                                    Andamento\n                                </label>\n                                <select aria-label=\"Atualizar andamento da ocorrência de rotina\" class=\"workflow-select min-w-[170px] px-3 text-[14px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-3-2-6-2\" data-name=\"routine occurrence status dropdown\" data-reason=\"selected value reflects current database state\" id=\"routine-status\">\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-1\" selected=\"\" value=\"aberto\">\n                                        Aberta\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-2\" value=\"triagem\">\n                                        Em triagem\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-3\" value=\"atribuido\">\n                                        Atribuída\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-4\" value=\"execucao\">\n                                        Em execução\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-5\" value=\"material\">\n                                        Aguardando material\n                                    </option>\n                                    <option data-kid=\"1-1-2-1-4-3-2-6-2-6\" value=\"resolvido\">\n                                        Resolvida\n                                    </option>\n                                </select>\n                            </div>\n                        </article>\n                    </section>\n                </section>\n                <p class=\"mt-8 border-t border-[var(--line)] pt-4 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-1-2-1-5\">\n                    Alterar o andamento atualiza esta ocorrência. Consulte em\n                    <strong class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-1-2-1-5-1\">\n                        Ocorrências\n                    </strong>\n                    o histórico de registros e mudanças.\n                </p>\n            </div>\n        </main>\n    </div>\n</div>\n",
